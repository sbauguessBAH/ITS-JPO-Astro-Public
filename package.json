{
  "name": "itsjpo-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node --max-old-space-size=8192 ./node_modules/astro/astro.js check && node --max-old-space-size=8192 ./node_modules/astro/astro.js build",
    "build:noWarn": "node --max-old-space-size=8192 ./node_modules/astro/astro.js build --minimumSeverity error",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:vr": "node scripts/visual-regression.mjs",
    "test:vr:report": "playwright show-report .playwright/report",
    "storybook": "storybook dev -p 4000",
    "build-storybook": "storybook build",
    "test:a11y": "A11Y=1 playwright test --project=accessibility"
  },
  "dependencies": {
    "@astrojs/partytown": "^2.1.4",
    "@astrojs/react": "^5.0.7",
    "@astrojs/vue": "^5.1.4",
    "@popperjs/core": "^2.11.8",
    "astro": "^5.18.2",
    "bootstrap": "^5.3.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "datatables.net": "^2.1.4",
    "vue": "^3.5.28"
  },
  "engines": {
    "node": ">=22.0.0 || >=24.0.0",
    "npm": ">=9.6.5",
    "pnpm": ">=7.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/prism": "^3.3.0",
    "@astrojs/sitemap": "^3.7.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@storybook-astro/framework": "^1.13.0",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/builder-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bootstrap": "^5.2.10",
    "@types/node": "^24.13.2",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/parser": "^8.63.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.93.2",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  }
}
