---
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import SectionBody from "@/src/components/ui/blocks/section/SectionBody.astro";
import SectionHeader from "@/src/components/ui/blocks/section/SectionHeader.astro";
import ItemGroup from "@/src/components/ui/elements/item/ItemGroup.astro";
---

<Page>
  <PageHeader>
    <slot name="title" slot="title" />
    <p class="program-text tw:m-0 tw:p-0" slot="description">
      <slot name="description" />
    </p>
  </PageHeader>
  <Section>
    <SectionBody>
      <ItemGroup class="tw:grid tw:grid-cols-1 tw:md:grid-cols-2">
        <slot name="features" />
      </ItemGroup>
    </SectionBody>
  </Section>
  <Section color="muted" size="lg">
    <SectionHeader title="Current Project Highlights" />
    <SectionBody>
      <ItemGroup class="tw:flex tw:flex-col">
        <slot name="highlights" />
      </ItemGroup>
    </SectionBody>
  </Section>
</Page>
