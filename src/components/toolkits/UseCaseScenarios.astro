---
import Accordion from "@/src/components/Accordion.astro";
import AccordionItem from "@/src/components/AccordionItem.astro";
import type { ToolkitSection } from "@/src/lib/toolkits";
import MaterialPreview from "./MaterialPreview.astro";

interface Props {
  section: Extract<ToolkitSection, { kind: "scenarios" }>;
  id: string;
}

const { section, id } = Astro.props;
const sites = [...new Set([...section.sites, ...section.items.flatMap((item) => item.sites)])];
const status = (materials: typeof section.items[number]["materials"]) => {
  if (!materials.length) return "Coming Soon";
  const videos = materials.filter((item) => item.contentType === "Video").length;
  const factsheets = materials.filter((item) => item.contentType === "Factsheet").length;
  const images = materials.filter((item) => item.contentType === "Image").length;
  return `${factsheets} factsheet${factsheets === 1 ? "" : "s"} / ${images} images / ${videos} video${videos === 1 ? "" : "s"}`;
};
---

<toolkit-scenarios>
  <div class="kit-scenario-filters">
    <div class="kit-scenario-filter-group" role="group" aria-labelledby={`${id}-site-label`}>
      <span class="kit-filter-label" id={`${id}-site-label`}>Site</span>
      {["", ...sites].map((site) => (
        <label class="kit-filter-option">
          <input class="visually-hidden" type="radio" name={`${id}-site`} value={site} checked={site === ""} data-site-filter />
          <span>{site === "" ? "All" : site === "UDOT" ? "CTW" : site}</span>
        </label>
      ))}
    </div>
    <div class="kit-scenario-filter-group" role="group" aria-labelledby={`${id}-type-label`}>
      <span class="kit-filter-label" id={`${id}-type-label`}>Content Type</span>
      {[["", "All"], ["Factsheet", "Factsheets"], ["Image", "Images"], ["Video", "Videos"]].map(([value, label]) => (
        <label class="kit-filter-option">
          <input class="visually-hidden" type="radio" name={`${id}-type`} value={value} checked={value === ""} data-type-filter />
          <span>{label}</span>
        </label>
      ))}
    </div>
    <button type="button" class="kit-filter-reset" data-reset-filters>Clear filters</button>
  </div>
  <p class="kit-scenario-results visually-hidden" role="status" aria-live="polite" data-results>{section.items.length} scenarios</p>
  <Accordion id={`${id}-accordion`}>
    {section.items.map((scenario, index) => (
      <div data-scenario data-sites={JSON.stringify(scenario.sites)}>
        <AccordionItem title={scenario.title} parentId={`${id}-accordion`} index={index}>
          <span slot="header" class="kit-scenario-heading">
            <span class="kit-scenario-title">{scenario.title}</span>
            {scenario.description && <span class="kit-scenario-context">{scenario.description}</span>}
            <span class:list={["kit-scenario-status", { "kit-coming-soon": !scenario.materials.length }]} data-scenario-status>{status(scenario.materials)}</span>
          </span>
          {scenario.materials.length ? (
            <div class="kit-scenario-materials">
              {scenario.materials.map((item) => <MaterialPreview item={item} embed />)}
            </div>
          ) : <p class="kit-copy">Coming Soon</p>}
        </AccordionItem>
      </div>
    ))}
  </Accordion>
  <p class="kit-copy" data-no-results hidden={section.items.length > 0}>{section.items.length ? "No scenarios match these filters." : section.emptyLabel}</p>
</toolkit-scenarios>

<script>
  class ToolkitScenarios extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = "true";
      const siteFilters = [...this.querySelectorAll<HTMLInputElement>("[data-site-filter]")];
      const typeFilters = [...this.querySelectorAll<HTMLInputElement>("[data-type-filter]")];
      const scenarios = [...this.querySelectorAll<HTMLElement>("[data-scenario]")];
      const results = this.querySelector<HTMLElement>("[data-results]")!;
      const noResults = this.querySelector<HTMLElement>("[data-no-results]")!;

      const update = () => {
        const site = siteFilters.find((input) => input.checked)!.value;
        const type = typeFilters.find((input) => input.checked)!.value;
        let count = 0;
        for (const scenario of scenarios) {
          const sites: string[] = JSON.parse(scenario.dataset.sites ?? "[]");
          const materials = [...scenario.querySelectorAll<HTMLElement>("[data-scenario-material]")];
          let videos = 0;
          let factsheets = 0;
          let images = 0;
          for (const material of materials) {
            const matchesSite = !site || (material.dataset.site ? material.dataset.site === site : sites.includes(site));
            const matchesType = !type || material.dataset.contentType === type;
            material.hidden = !(matchesSite && matchesType);
            if (!material.hidden) {
              if (material.dataset.contentType === "Video") videos++;
              else if (material.dataset.contentType === "Image") images++;
              else if (material.dataset.contentType === "Factsheet") factsheets++;
            }
          }
          const comingSoon = !materials.length && !type && (!site || sites.includes(site));
          scenario.hidden = !(videos + factsheets + images > 0 || comingSoon);
          if (!scenario.hidden) count++;
          scenario.querySelector<HTMLElement>("[data-scenario-status]")!.textContent = !materials.length
            ? "Coming Soon"
            : `${factsheets} factsheet${factsheets === 1 ? "" : "s"} / ${images} images / ${videos} video${videos === 1 ? "" : "s"}`;
          if (scenario.hidden) {
            scenario.querySelector(".accordion-collapse")?.classList.remove("show");
            const button = scenario.querySelector(".accordion-button");
            button?.classList.add("collapsed");
            button?.setAttribute("aria-expanded", "false");
            scenario.querySelectorAll<HTMLIFrameElement>("iframe").forEach((iframe) => {
              iframe.src = iframe.src;
            });
          }
        }
        results.textContent = `${count} scenario${count === 1 ? "" : "s"}`;
        noResults.hidden = count > 0;
      };

      [...siteFilters, ...typeFilters].forEach((input) => input.addEventListener("change", update));
      this.querySelector("[data-reset-filters]")?.addEventListener("click", () => {
        [...siteFilters, ...typeFilters].forEach((input) => { input.checked = input.value === ""; });
        update();
      });
      update();
    }
  }
  if (!customElements.get("toolkit-scenarios")) customElements.define("toolkit-scenarios", ToolkitScenarios);
</script>