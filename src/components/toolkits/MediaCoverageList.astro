---
import type { ToolkitMediaCoverageItem, ToolkitSection } from "@/src/lib/toolkits";
import MediaCoverageCard from "./MediaCoverageCard.astro";

interface Props {
  section: Extract<ToolkitSection, { kind: "media-coverage" }>;
}

const { section } = Astro.props;

const getDateTimestamp = (item: ToolkitMediaCoverageItem): number => {
  const timestamp = Date.parse(item.date ?? "");

  return Number.isNaN(timestamp) ? 0 : timestamp;
};

const getMostRecentCoverage = (items: ToolkitMediaCoverageItem[]): ToolkitMediaCoverageItem[] => {
  return [...items].sort((first, second) => getDateTimestamp(second) - getDateTimestamp(first));
};

const getCoverageByTopic = (items: ToolkitMediaCoverageItem[]): Array<[string, ToolkitMediaCoverageItem[]]> => {
  const topics = new Map<string, ToolkitMediaCoverageItem[]>();

  for (const item of items) {
    const topic = item.topic ?? "General Coverage";
    const topicItems = topics.get(topic) ?? [];

    topicItems.push(item);
    topics.set(topic, topicItems);
  }

  return [...topics.entries()]
    .sort(([firstTopic], [secondTopic]) => firstTopic.localeCompare(secondTopic))
    .map(([topic, topicItems]) => [topic, getMostRecentCoverage(topicItems)]);
};

const recentCoverage = getMostRecentCoverage(section.items);
const coverageByTopic = getCoverageByTopic(section.items);
const hasMoreCoverage = section.items.length > 6;
---

<div class="kit-media-coverage" data-media-coverage>
  <div class="kit-media-coverage-controls" role="group" aria-label="Organize media coverage">
    <span>Organize by:</span>
    <div class="kit-media-coverage-switch">
      <button type="button" data-media-coverage-toggle="recent" aria-pressed="true">Most Recent</button>
      <button type="button" data-media-coverage-toggle="topic" aria-pressed="false">By Topic</button>
    </div>
  </div>

  <div class="kit-media-coverage-view" data-media-coverage-view="recent">
    {recentCoverage.map((item) => <MediaCoverageCard item={item} />)}
  </div>

  <div class="kit-media-coverage-view" data-media-coverage-view="topic" hidden>
    {
      coverageByTopic.map(([topic, items]) => (
        <section class="kit-media-topic-group">
          <h4>{topic}</h4>
          {items.map((item) => <MediaCoverageCard item={item} />)}
        </section>
      ))
    }
  </div>

  {
    hasMoreCoverage && (
      <button type="button" class="kit-media-coverage-expand" data-media-coverage-expand aria-expanded="false">
        See All Media Coverage
      </button>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-media-coverage]").forEach((coverage) => {
    const views = Array.from(coverage.querySelectorAll<HTMLElement>("[data-media-coverage-view]"));
    const toggles = Array.from(coverage.querySelectorAll<HTMLButtonElement>("[data-media-coverage-toggle]"));
    const expandButton = coverage.querySelector<HTMLButtonElement>("[data-media-coverage-expand]");
    let expanded = false;

    const updateVisibleItems = () => {
      const activeView = views.find((view) => !view.hidden);

      if (!activeView) {
        return;
      }

      const cards = Array.from(activeView.querySelectorAll<HTMLElement>(".kit-media-card"));
      cards.forEach((card, index) => {
        card.hidden = !expanded && index >= 6;
      });

      activeView.querySelectorAll<HTMLElement>(".kit-media-topic-group").forEach((group) => {
        group.hidden = !Array.from(group.querySelectorAll<HTMLElement>(".kit-media-card")).some((card) => !card.hidden);
      });

      if (expandButton) {
        expandButton.hidden = cards.length <= 6;
        expandButton.setAttribute("aria-expanded", String(expanded));
        expandButton.textContent = expanded ? "See Less Media Coverage" : "See All Media Coverage";
      }
    };

    toggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const selectedView = toggle.dataset.mediaCoverageToggle;

        views.forEach((view) => {
          view.hidden = view.dataset.mediaCoverageView !== selectedView;
        });
        toggles.forEach((button) => {
          button.setAttribute("aria-pressed", String(button === toggle));
        });
        updateVisibleItems();
      });
    });

    expandButton?.addEventListener("click", () => {
      expanded = !expanded;
      updateVisibleItems();
    });

    updateVisibleItems();
  });
</script>
