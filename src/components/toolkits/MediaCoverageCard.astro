---
import type { ToolkitMediaCoverageItem } from "@/src/lib/toolkits";

interface Props {
  item: ToolkitMediaCoverageItem;
}

const { item } = Astro.props;
const metadata = [item.mediaType, item.platform, item.date].filter(Boolean);
---

<article class="kit-media-card">
  <div class="kit-media-card-copy">
    {metadata.length > 0 && <p class="kit-media-card-meta">{metadata.join(" · ")}</p>}
    <h4>{item.title}</h4>
    {item.description && <p>{item.description}</p>}
  </div>
  {item.href && <a class="kit-media-card-link" href={item.href}>View Coverage</a>}
</article>