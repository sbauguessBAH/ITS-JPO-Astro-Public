---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "class"> {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<div
  class:list={["ui_item-title", className]}
  data-slot="ui_item-title"
  {...rest}
>
  <slot />
</div>
