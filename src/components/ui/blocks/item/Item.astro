---
import type { HTMLAttributes } from "astro/types";

import "./item.css";

interface Props extends Omit<HTMLAttributes<"div">, "class"> {
  class?: string;
  /** If provided, the item renders as an <a> instead of a <div>. */
  href?: string;
  /** Spacing/density of the item. Defaults to "default". */
  size?: "default" | "sm" | "xs";
  /** Visual style of the item. Defaults to "default". */
  variant?: "default" | "muted" | "outline";
}

const {
  class: className,
  href,
  size = "default",
  variant = "default",
  ...rest
} = Astro.props;

// Astro doesn't support a React-style `asChild`/`render` prop, so we swap
// the rendered tag based on `href` instead — the idiomatic Astro way to
// make a component polymorphic between a link and a plain container.
const Tag = href ? "a" : "div";
---

<Tag
  class:list={["ui_item", className]}
  data-size={size}
  data-slot="ui_item"
  data-variant={variant}
  href={href}
  {...rest}
>
  <slot />
</Tag>
