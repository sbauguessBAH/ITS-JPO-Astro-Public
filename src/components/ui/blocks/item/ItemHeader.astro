---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "class"> {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<div
  data-slot="ui_item-header"
  class:list={["ui_item-header", className]}
  {...rest}
>
  <slot />
</div>
