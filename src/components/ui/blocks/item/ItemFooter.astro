---
import type { HTMLAttributes } from 'astro/types'

interface Props extends Omit<HTMLAttributes<'div'>, 'class'> {
  class?: string
}

const { class: className, ...rest } = Astro.props
---

<div
  data-slot="ui_item-footer"
  class:list={['ui_item-footer', className]}
  {...rest}
>
  <slot />
</div>