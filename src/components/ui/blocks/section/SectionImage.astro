---
import LibraryImage, { type LibraryImageEntry } from "@/src/components/programs/LibraryImage.astro";
import { type LocalImageProps } from 'astro:assets';
import './section.css';

type Props = Omit<LocalImageProps, 'alt' | 'src'> & {
  alt?: string;
  /** Reference to library entry */
  entry: LibraryImageEntry;
  /** Provide width if you need a fixed pixel width */
  width?: number;
  /** Provide height if you need a fixed pixel height */
  height?: number;
  rounded?: boolean;
};

const {
  entry,
  width,
  height,
  rounded = true,
  class: className,
  ...props
} = Astro.props;
---
<LibraryImage
  entry={entry}
  class:list={[
    "ui_section-image",
    rounded && "ui_section-image_rounded"
  ]}
  style={{ width: width ? `${width}px` : undefined, height: height ? `${height}px` : undefined }}
  {...props}
/>