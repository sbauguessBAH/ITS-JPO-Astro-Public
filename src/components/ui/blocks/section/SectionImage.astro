---
import { type LocalImageProps } from "astro:assets";

import LibraryImage, {
  type LibraryImageEntry,
} from "@/src/components/programs/LibraryImage.astro";

import "./section.css";

type Props = Omit<LocalImageProps, "alt" | "src"> & {
  alt?: string;
  /** Reference to library entry */
  entry: LibraryImageEntry;
  /** Provide height if you need a fixed pixel height */
  height?: number;
  rounded?: boolean;
  /** Provide width if you need a fixed pixel width */
  width?: number;
};

const {
  class: className,
  entry,
  height,
  rounded = true,
  width,
  ...props
} = Astro.props;
---

<LibraryImage
  class:list={[
    "ui_section-image",
    rounded && "ui_section-image_rounded",
    className,
  ]}
  entry={entry}
  style={{
    height: height ? `${height}px` : undefined,
    width: width ? `${width}px` : undefined,
  }}
  {...props}
/>
