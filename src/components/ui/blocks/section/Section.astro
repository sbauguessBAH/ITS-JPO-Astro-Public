---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/src/lib/utils";

import PageContainer from "../page/PageContainer.astro";

/**
 * Section is a full-width band whose content sits in a `PageContainer`.
 * Put a `SectionBody` inside and pass it classes to control the layout.
 */
type Props = {
  /**
   * `muted` fills the full width of the section with a light gray
   * background. The inner container stays the same width either way.
   *
   * @default `default`
   */
  color?: "default" | "muted";
  /**
   * Max-width of the inner content container.
   *
   * @default `default`
   */
  size?: "default" | "sm";
} & HTMLAttributes<"section">;

const { class: className, color = "default", size = "default", ...rest } = Astro.props;
---

<section
  class={cn(
    "tw:relative tw:box-border tw:w-full tw:py-12",
    "tw:bg-transparent tw:text-foreground",
    "tw:data-[color=muted]:bg-muted",
    className,
  )}
  data-color={color}
  data-slot="ui-section"
  {...rest}
>
  <PageContainer class="tw:flex tw:flex-col tw:gap-6" size={size}>
    <slot />
  </PageContainer>
</section>
