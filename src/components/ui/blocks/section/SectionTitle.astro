---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/src/lib/utils";

type Props = HTMLAttributes<"h2"> & {
  /**
   * The heading level to render. Defaults to `h2` since a Section is
   * typically a direct child of the page (which owns the `h1`).
   *
   * @default `h2`
   */
  as?: "div" | "h1" | "h2" | "h3" | "h4";
};

const { as: Tag = "h2", class: className, ...rest } = Astro.props;
---

<Tag
  class={cn(
    "tw:m-0! tw:text-[1.75rem]! tw:leading-snug! tw:font-bold! tw:normal-case tw:md:text-3xl!",
    // A highlight's title is smaller than a standalone section title
    "tw:in-data-[slot=section-highlight]:text-lg! tw:md:in-data-[slot=section-highlight]:text-lg!",
    className,
  )}
  data-slot="section-title"
  {...rest}
>
  <slot />
</Tag>
