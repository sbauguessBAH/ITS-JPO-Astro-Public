---
import type { HTMLAttributes } from 'astro/types';
import './section.css';

type Props = HTMLAttributes<"h2"> & {
  /**
   * The heading level to render. Defaults to `h2` since a Section is
   * typically a direct child of the page (which owns the `h1`).
   *
   * @default `h2`
   */
  as?: "h1" | "h2" | "h3" | "h4" | "div";
};

const { class: className, as: Tag = "h2", ...rest } = Astro.props;
---
<Tag
  data-slot="ui_section-title"
  class:list={["ui_section-title", className]}
  {...rest}
>
  <slot/>
</Tag>