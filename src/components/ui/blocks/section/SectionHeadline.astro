---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/src/lib/utils";

type Props = HTMLAttributes<"p">;

const { class: className, ...rest } = Astro.props;
---

<p
  class={cn(
    "tw:m-0! tw:text-[0.8125rem] tw:font-semibold tw:tracking-wider tw:text-muted-foreground tw:uppercase",
    className,
  )}
  data-slot="section-headline"
  {...rest}
>
  <slot />
</p>
