---
import type { HTMLAttributes } from "astro/types";

import base_url from "@/src/lib/base_url";

type Props = HTMLAttributes<"li"> & {
  href?: string;
  isExternal?: boolean;
  /**
   * `horizontal` places the icon beside the text, `vertical` stacks the
   * icon above it.
   *
   * @default `horizontal`
   */
  orientation?: "horizontal" | "vertical";
};

const {
  class: className,
  href,
  isExternal,
  orientation = "horizontal",
  ...rest
} = Astro.props;

const Component = href ? "a" : "div";

const linkAttrs =
  href && isExternal
    ? { href, rel: "noopener noreferrer", target: "_blank" }
    : href
      ? { href: base_url(href) }
      : undefined;
---

<li
  class:list={[
    "ui_section-highlight",
    href && "ui_section-highlight_link",
    className,
  ]}
  data-orientation={orientation}
  data-slot="ui_section-highlight"
  {...rest}
>
  <Component
    class="ui_section-highlight-inner"
    data-slot="ui_section-highlight-inner"
    {...linkAttrs}
  >
    <slot />
  </Component>
</li>
