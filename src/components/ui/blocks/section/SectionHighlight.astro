---
import type { HTMLAttributes } from "astro/types";

import base_url from "@/src/lib/base_url";

type Props = HTMLAttributes<"li"> & {
  href?: string;
  isExternal?: boolean;
  /**
   * `horizontal` places the icon beside the text, `vertical` stacks the
   * icon above it.
   *
   * @default `horizontal`
   */
  orientation?: "horizontal" | "vertical";
};

const {
  class: className,
  href,
  isExternal,
  orientation = "horizontal",
  ...rest
} = Astro.props;

const Component = href ? "a" : "div";

const linkAttrs =
  href && isExternal
    ? { href, rel: "noopener noreferrer", target: "_blank" }
    : href
      ? { href: base_url(href) }
      : undefined;
---

<li
  class:list={["tw:group/section-highlight", className]}
  data-orientation={orientation}
  data-slot="section-highlight"
  {...rest}
>
  <Component
    class:list={[
      "tw:flex tw:items-start tw:gap-3 tw:text-inherit! tw:no-underline!",
      "tw:group-data-[orientation=vertical]/section-highlight:flex-col",
      href &&
        "tw:transition-opacity tw:hover:no-underline! tw:hover:opacity-75 tw:focus:opacity-75",
    ]}
    data-slot="section-highlight-inner"
    {...linkAttrs}
  >
    <slot />
  </Component>
</li>
