---
import { type LocalImageProps } from "astro:assets";

import LibraryImage, {
  type LibraryImageEntry,
} from "@/src/components/programs/LibraryImage.astro";

type Props = Omit<LocalImageProps, "alt" | "src"> & {
  alt?: string;
  /** Reference to library entry */
  entry: LibraryImageEntry;
  /** Provide height if vertical card */
  height?: number;
  rounded?: boolean;
  /** Provide width if horizontal card */
  width?: number;
};

const { entry, height, rounded = true, width, ...props } = Astro.props;
---

<LibraryImage
  class:list={["ui_card-image", rounded && "ui_card-image_rounded"]}
  entry={entry}
  style={{
    height: height ? `${height}px` : undefined,
    width: width ? `${width}px` : undefined,
  }}
  {...props}
/>
