---
import type { HTMLAttributes } from "astro/types";

import base_url from "@/src/lib/base_url";

/**
 * TODO: Test out and clean up horizontal orientation
 */
type Props = HTMLAttributes<"div"> & {
  href?: string;
  isExternal?: boolean;
  orientation?: "horizontal" | "vertical";
  /** @default `default` */
  size?: "default" | "sm";
};

const {
  class: className,
  href,
  isExternal,
  orientation = "vertical",
  size,
  ...rest
} = Astro.props;

const Component = href ? "a" : "div";

const linkAttrs =
  href && isExternal
    ? { href, rel: "noopener noreferrer", target: "_blank" }
    : href
      ? { href: base_url(href) }
      : undefined;
---

<Component
  class:list={["ui_card", className]}
  data-orientation={orientation}
  data-size={size}
  data-slot="ui_card"
  {...linkAttrs}
  {...rest}
>
  <slot />
</Component>
