---
import type { HTMLAttributes } from "astro/types";

import base_url from "@/src/lib/base_url";

import "./card.css";

/**
 * TODO: Test out and clean up horizontal orientation
 */
type Props = HTMLAttributes<"div"> & {
  href?: string;
  isExternal?: boolean;
  orientation?: "horizontal" | "vertical";
  /**
   * Uses Bootstrap box shadow classes
   *
   * @default `sm`
   */
  shadow?: "lg" | "md" | "none" | "sm";
  /** @default `default` */
  size?: "default" | "sm";
};

const {
  class: className,
  href,
  isExternal,
  orientation = "vertical",
  shadow = "sm",
  size,
  ...rest
} = Astro.props;

const Component = href ? "a" : "div";
/**
 * @privateRemarks
 *
 * Bootstrap box shadow options: `shadow-none`, `shadow-sm`, `shadow`, `shadow-lg`
 *
 * `shadow-sm` seems to be most consistently used for cards across the site.
 */
const shadowClass = {
  shadow: shadow === "md",
  "shadow-lg": shadow === "lg",
  "shadow-none": shadow === "none",
  "shadow-sm": shadow === "sm",
};

const linkAttrs =
  href && isExternal
    ? { href, rel: "noopener noreferrer", target: "_blank" }
    : href
      ? { href: base_url(href) }
      : undefined;
---

<Component
  class:list={[
    "ui_card",
    Object.entries(shadowClass).find(([, isActive]) => isActive)?.[0],
    href && "ui_card_link",
    className,
  ]}
  data-orientation={orientation}
  data-size={size}
  data-slot="ui_card"
  {...linkAttrs}
  {...rest}
>
  <slot />
</Component>
