---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"nav"> & {
  /** Accessible name for the navigation landmark; required unless `aria-labelledby` is set. */
  label?: string;
};

const { class: className, label, ...rest } = Astro.props;
---

<nav
  aria-label={label}
  class:list={[
    "tw:flex tw:flex-col tw:overflow-hidden",
    "tw:rounded-2xl tw:border tw:border-border",
    "tw:bg-background tw:text-foreground",
    className,
  ]}
  data-slot="panel"
  {...rest}
>
  <slot />
</nav>
