---
import type { HTMLAttributes } from "astro/types";

import base_url from "@/src/lib/base_url";

type Props = HTMLAttributes<"a"> & {
  /** Marks the current item; sets `data-active` and `aria-current="page"`. */
  active?: boolean;
  href: string;
  isExternal?: boolean;
};

const {
  active = false,
  class: className,
  href,
  isExternal,
  ...rest
} = Astro.props;

const linkAttrs = isExternal
  ? { href, rel: "noopener noreferrer", target: "_blank" }
  : { href: base_url(href) };
---

<li class="tw:m-0! tw:border-b tw:border-border tw:p-0! tw:last:border-b-0">
  <a
    aria-current={active ? "page" : undefined}
    class:list={[
      "tw:group/panel-item tw:flex tw:flex-row tw:items-center tw:justify-between tw:gap-2",
      "tw:px-4 tw:py-2",
      "tw:font-semibold tw:hover:font-semibold",
      "tw:text-primary",
      "tw:no-underline! tw:hover:no-underline!",
      "tw:hover:bg-muted tw:hover:text-primary!",
      "tw:focus-visible:outline-2 tw:focus-visible:-outline-offset-2 tw:focus-visible:outline-ring",
      "tw:data-[active=true]:bg-muted",
      className,
    ]}
    data-active={active}
    data-slot="panel-item"
    {...linkAttrs}
    {...rest}
  >
    <span data-slot="panel-item-label"><slot /></span>
    {
      Astro.slots.has("end") && (
        <span
          class:list={[
            "tw:h-6 tw:rounded-xl tw:bg-muted tw:px-3",
            "tw:group-data-[active=true]/panel-item:bg-primary",
            "tw:group-data-[active=true]/panel-item:text-primary-foreground",
          ]}
          data-slot="panel-item-end"
        >
          <slot name="end" />
        </span>
      )
    }
  </a>
</li>
