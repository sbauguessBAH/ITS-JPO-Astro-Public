---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/src/lib/utils";

type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;
---

<!-- tw:pt-8 -->
<div
  class={cn("tw:flex tw:flex-col tw:gap-4", className)}
  data-slot="page-body"
  {...rest}
>
  <slot />
</div>
