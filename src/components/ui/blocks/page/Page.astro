---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  /**
   * Root element. Use `main` when the page owns the primary landmark.
   *
   * @default `main`
   */
  as?: "div" | "main" | "section";
  /**
   * Lets the page span the full width of its parent instead of being
   * contained to `max-w-7xl`.
   *
   * @default `false`
   */
  fullWidth?: boolean;
};

const {
  as: Tag = "main",
  class: className,
  fullWidth = false,
  ...rest
} = Astro.props;
---

<Tag
  class:list={[
    "tw:flex tw:flex-col tw:gap-6 tw:pb-12",
    !fullWidth && "tw:mx-auto tw:w-full tw:max-w-7xl tw:px-4 tw:xl:px-0",
    className,
  ]}
  data-slot="page"
  {...rest}
>
  <slot />
</Tag>
