---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  /**
   * Root element. Use `main` when the page owns the primary landmark.
   *
   * @default `main`
   */
  as?: "div" | "main" | "section";
};

const { as: Tag = "main", class: className, ...rest } = Astro.props;
---

<Tag
  class:list={["tw:flex tw:flex-col tw:gap-8", className]}
  data-slot="page"
  {...rest}
>
  <slot />
</Tag>
