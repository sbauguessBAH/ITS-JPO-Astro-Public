---
import Button from "../../elements/button/Button.astro";
import Icon from "../../icon/Icon.astro";

interface Props {
  /** The text to copy to the clipboard when clicked. */
  text: string;
  /** Optional label shown inside the button. Defaults to "Copy". */
  label?: string;
  class?: string;
}

const { text, label = "Copy", class: className } = Astro.props;
---

<Button
  class:list={["tw:group/copy-button", className]}
  color="primary"
  data-copy-text={text}
  data-slot="copy-button"
  data-state="idle"
  size="sm"
  type="button"
  variant="ghost"
>
  <span data-slot="copy-button-label">{label}</span>
  <Icon
    aria-hidden="true"
    class="tw:group-data-[state=copied]/copy-button:hidden"
    data-slot="copy-button-icon-copy"
    name="copy"
  />
  <Icon
    aria-hidden="true"
    class="tw:hidden tw:group-data-[state=copied]/copy-button:block"
    data-slot="copy-button-icon-copied"
    name="check-lg"
  />
</Button>

<script>
  const BUTTON = '[data-slot="copy-button"]';

  document.addEventListener("click", (e: MouseEvent) => {
    const button = (e.target as Element).closest<HTMLElement>(BUTTON);
    if (!button) return;

    const text = button.dataset.copyText;
    if (!text) return;

    navigator.clipboard.writeText(text).then(() => {
      button.dataset.state = "copied";
      button.setAttribute("aria-disabled", "true");

      setTimeout(() => {
        button.dataset.state = "idle";
        button.removeAttribute("aria-disabled");
      }, 2000);
    });
  });
</script>
