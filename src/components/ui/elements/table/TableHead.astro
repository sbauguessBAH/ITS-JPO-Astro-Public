---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/src/lib/utils";

type Props = HTMLAttributes<"th"> & {
  class?: string;
};

const { class: className, ...props } = Astro.props;
---

<th
  class={cn(
    "tw:h-12 tw:px-4 tw:text-left tw:align-middle tw:font-medium tw:whitespace-nowrap tw:text-muted-foreground tw:has-[[role=checkbox]]:pr-0",
    className,
  )}
  data-slot="table-head"
  {...props}
>
  <slot />
</th>