---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  class?: string;
};

const { class: className, ...props } = Astro.props;
---

<div
  class:list={[
    "group-data-[size=xs]/item:tw:gap-0 [&+[data-slot=item-content]]:tw:flex-none tw:flex tw:flex-1 tw:flex-col tw:gap-1",
    className,
  ]}
  data-slot="item-content"
  {...props}
>
  <slot />
</div>
