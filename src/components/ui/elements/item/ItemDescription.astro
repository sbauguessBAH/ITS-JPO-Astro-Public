---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"p">, "class"> {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
---

<p
  class:list={["ui_item-description", className]}
  data-slot="ui_item-description"
  {...rest}
>
  <slot />
</p>
