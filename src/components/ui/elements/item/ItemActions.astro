---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  class?: string;
};

const { class: className, ...props } = Astro.props;
---

<div
  class:list={["tw:flex tw:items-center tw:gap-2", className]}
  data-slot="item-actions"
  {...props}
>
  <slot />
</div>
