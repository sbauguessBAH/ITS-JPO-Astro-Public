---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"div">, "class"> {
  class?: string;
  /** Defaults to "default". Use "icon" for a boxed icon, "image" for a thumbnail. */
  variant?: "default" | "icon" | "image";
}

const { class: className, variant = "default", ...rest } = Astro.props;
---

<div
  class:list={["ui_item-media", className]}
  data-slot="ui_item-media"
  data-variant={variant}
  {...rest}
>
  <slot />
</div>
