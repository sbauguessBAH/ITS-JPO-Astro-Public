---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  class?: string;
};

const { class: className, ...props } = Astro.props;
---

<div
  class:list={[
    "tw:line-clamp-1 tw:flex tw:w-fit tw:items-center tw:gap-2 tw:text-lg tw:leading-snug tw:font-medium tw:underline-offset-4",
    className,
  ]}
  data-slot="item-title"
  {...props}
>
  <slot />
</div>
