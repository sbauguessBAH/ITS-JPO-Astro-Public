---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  class?: string;
};

const { class: className, ...props } = Astro.props;
---

<div
  class:list={[
    "tw:flex tw:basis-full tw:items-center tw:justify-between tw:gap-2",
    className,
  ]}
  data-slot="item-footer"
  {...props}
>
  <slot />
</div>
