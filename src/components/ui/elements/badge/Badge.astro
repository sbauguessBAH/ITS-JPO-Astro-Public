---
import type { HTMLAttributes } from "astro/types";
import "./badge.css";

/**
 * TODO: Update styling including for external link
 */
type Props = HTMLAttributes<"span"> & {
  color?: "primary" | "secondary";
  variant?: "default" | "outline" | "subtle" | "soft";
  size?: "sm" | "default" | "lg";
  rounded?: boolean;
  class?: string;
};

const {
  class: className,
  color = "primary",
  variant = "default",
  size = "default",
  rounded = true,
  ...props
} = Astro.props;

const Component = "span";
---

<Component
  data-slot="ui_badge"
  data-color={color}
  data-variant={variant}
  data-size={size}
  data-rounded={rounded}
  class:list={["ui_badge", className]}
  {...props}
>
  <slot />
</Component>
