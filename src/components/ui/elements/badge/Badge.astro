---
import type { HTMLAttributes } from "astro/types";

import "./badge.scss";

/**
 * TODO: Update styling including for external link
 */
type Props = HTMLAttributes<"span"> & {
  class?: string;
  color?: "primary" | "secondary";
  rounded?: boolean;
  size?: "default" | "lg" | "sm";
  variant?: "default" | "outline" | "soft" | "subtle";
};

const {
  class: className,
  color = "primary",
  rounded = true,
  size = "default",
  variant = "default",
  ...props
} = Astro.props;

const Component = "span";
---

<Component
  class:list={["ui_badge", className]}
  data-color={color}
  data-rounded={rounded}
  data-size={size}
  data-slot="ui_badge"
  data-variant={variant}
  {...props}
>
  <slot />
</Component>
