---
import type { HTMLAttributes } from "astro/types";

type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

type Props = HTMLAttributes<"h1"> & {
  as?: HeadingTag;
  class?: string;
  size?: "default" | "lg" | "sm";
};

const { as, class: className, size = "default", ...props } = Astro.props;

const defaultTagBySize: Record<"default" | "lg" | "sm", HeadingTag> = {
  default: "h2",
  lg: "h1",
  sm: "h3",
};

const Component = as ?? defaultTagBySize[size];
---

<Component
  class:list={["ui_header", className]}
  data-size={size}
  data-slot="ui_header"
  {...props}
>
  <slot />
</Component>
