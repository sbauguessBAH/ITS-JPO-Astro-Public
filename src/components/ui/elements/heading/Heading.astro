---
import type { HTMLAttributes } from "astro/types";

import { cva } from "class-variance-authority";

import { cn } from "@/src/lib/utils";

type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

type Props = HTMLAttributes<"h1"> & {
  /** Default is h2 since banner uses h1 */
  as?: HeadingTag;
  class?: string;
  size?: "xl" | "default" | "md" | "sm";
};

const { as, class: className, size = "default", ...props } = Astro.props;

const defaultTagBySize: Record<"xl" | "default" | "md" | "sm", HeadingTag> = {
  xl: "h1",
  default: "h2",
  md: "h3",
  sm: "h4",
};

const Component = as ?? defaultTagBySize[size];

const headerVariants = cva("tw:normal-case! tw:m-0! tw:p-0! tw:text-primary!", {
  defaultVariants: {
    size: "default",
  },
  variants: {
    size: {
      default: "tw:text-4xl! tw:font-bold! tw:leading-snug tw:tracking-tight",
      md: "tw:text-3xl! tw:font-semibold tw:leading-tight tw:tracking-tight",
      sm: "tw:text-lg! tw:font-semibold tw:leading-tight tw:tracking-tight",
      xl: "tw:text-5xl! tw:font-bold! tw:leading-snug tw:tracking-tight",
    },
  },
});
---

<Component
  class={cn(headerVariants({ size }), className)}
  data-slot="ui_header"
  {...props}
>
  <slot />
</Component>
