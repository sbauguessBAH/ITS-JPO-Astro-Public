---
import type { HTMLAttributes } from "astro/types";

import { cva } from "class-variance-authority";

type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

type Props = HTMLAttributes<"h1"> & {
  as?: HeadingTag;
  class?: string;
  size?: "default" | "md" | "sm";
};

const { as, class: className, size = "default", ...props } = Astro.props;

const defaultTagBySize: Record<"default" | "md" | "sm", HeadingTag> = {
  default: "h1",
  md: "h2",
  sm: "h3",
};

const Component = as ?? defaultTagBySize[size];

const headerVariants = cva("tw:normal-case! tw:m-0! tw:p-0! tw:text-primary", {
  defaultVariants: {
    size: "default",
  },
  variants: {
    size: {
      default: "tw:text-4xl! tw:font-bold! tw:leading-snug tw:tracking-tight",
      md: "tw:text-2xl! tw:font-semibold tw:leading-tight tw:tracking-tight",
      sm: "tw:text-lg! tw:font-semibold tw:leading-tight tw:tracking-tight",
    },
  },
});
---

<Component
  class:list={[headerVariants({ size }), className]}
  data-slot="ui_header"
  {...props}
>
  <slot />
</Component>
