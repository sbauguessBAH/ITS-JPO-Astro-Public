---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  class?: string;
};

const { class: className, ...props } = Astro.props;
---

<div
  class:list={[
    "tw:text-2xl tw:font-bold tw:[&_a]:underline tw:[&_a]:underline-offset-3",
    className,
  ]}
  data-slot="alert-title"
  {...props}
>
  <slot />
</div>
