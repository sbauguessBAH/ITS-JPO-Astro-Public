---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"ol"> & {
  class?: string;
};

const { class: className, ...props } = Astro.props;
---

<ol
  class:list={[
    "tw:m-0 tw:flex tw:list-none tw:flex-wrap tw:items-center tw:gap-2 tw:p-0 tw:text-sm tw:text-muted-foreground",
    className,
  ]}
  data-slot="breadcrumb-list"
  {...props}
>
  <slot />
</ol>
