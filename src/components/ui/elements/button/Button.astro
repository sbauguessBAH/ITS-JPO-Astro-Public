---
import type { HTMLAttributes } from "astro/types";

import { cva } from "class-variance-authority";

import base_url from "../../../../lib/base_url";
import "./button.scss";

type LinkProps = {
  href: string;
  isExternal?: boolean;
  isNewWindow?: boolean;
  isSameWindow?: boolean;
};

type Props = HTMLAttributes<"button"> & {
  class?: string;
  color?: "accent" | "primary" | "secondary";
  link?: LinkProps;
  size?: "default" | "icon" | "icon-lg" | "icon-sm" | "lg" | "sm";
  type?: "button" | "reset" | "submit";
  variant?: "default" | "ghost" | "outline" | "subtle";
};

const {
  class: className,
  color = "primary",
  link,
  size = "default",
  type = "button",
  variant = "default",
  ...props
} = Astro.props;

const isLink = !!link;
const Component = isLink ? "a" : "button";

let linkHref: string | undefined;
let linkRel: string | undefined;
let linkTarget: string | undefined;

if (link) {
  const isTelOrMail =
    link.href.startsWith("mailto:") || link.href.startsWith("tel:");
  linkHref = link.isExternal || isTelOrMail ? link.href : base_url(link.href);
  linkRel = !isTelOrMail && link.isExternal ? "noopener noreferrer" : undefined;
  linkTarget =
    !isTelOrMail &&
    (link.isNewWindow || (link.isExternal && !link.isSameWindow))
      ? "_blank"
      : undefined;
}

const buttonVariants = cva(
  "group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
  {
    compoundVariants: [
      {
        color: "primary",
        variant: "default",
      },
    ],
    defaultVariants: {
      color: "primary",
      size: "default",
      variant: "default",
    },
    variants: {
      color: {
        accent: "",
        primary: "",
        secondary: "",
      },
      size: {
        default:
          "h-9 gap-1.5 px-2.5 in-data-[slot=button-group]:rounded-md has-[>svg:first-child]:pl-2 has-[>svg:last-child]:pr-2",
        icon: "size-9",
        "icon-lg": "size-10",
        "icon-sm":
          "size-8 rounded-[min(var(--radius-md),10px)] in-data-[slot=button-group]:rounded-md",
        "icon-xs":
          "size-6 rounded-[min(var(--radius-md),8px)] in-data-[slot=button-group]:rounded-md [&_svg:not([class*='size-'])]:size-3",
        lg: "h-10 gap-1.5 px-2.5 has-[>svg:first-child]:pl-2 has-[>svg:last-child]:pr-2",
        sm: "h-8 gap-1 rounded-[min(var(--radius-md),10px)] px-2.5 in-data-[slot=button-group]:rounded-md has-[>svg:first-child]:pl-1.5 has-[>svg:last-child]:pr-1.5",
        xs: "h-6 gap-1 rounded-[min(var(--radius-md),8px)] px-2 text-xs in-data-[slot=button-group]:rounded-md has-[>svg:first-child]:pl-1.5 has-[>svg:last-child]:pr-1.5 [&_svg:not([class*='size-'])]:size-3",
      },
      variant: {
        default: "",
        ghost: "",
        outline: "",
        subtle: "",
      },
    },
  },
);
---

<Component
  class:list={[
    "tw:inline-flex tw:items-center tw:justify-center tw:shrink-0 tw:whitespace-nowrap tw:align-middle",
    className,
  ]}
  data-color={color}
  data-size={size}
  data-slot="ui_button"
  data-variant={variant}
  href={linkHref}
  rel={linkRel}
  target={linkTarget}
  type={!isLink ? type : undefined}
  {...props}
>
  <slot />
</Component>
