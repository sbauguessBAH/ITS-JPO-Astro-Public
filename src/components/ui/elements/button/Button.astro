---
import type { HTMLAttributes } from "astro/types";

import { cva } from "class-variance-authority";

import base_url from "../../../../lib/base_url";

type LinkProps = {
  href: string;
  isExternal?: boolean;
  isNewWindow?: boolean;
  isSameWindow?: boolean;
};

type Props = HTMLAttributes<"button"> & {
  class?: string;
  color?: "accent" | "neutral" | "primary" | "secondary";
  link?: LinkProps;
  size?: "default" | "icon" | "icon-lg" | "icon-sm" | "lg" | "sm";
  type?: "button" | "reset" | "submit";
  variant?: "default" | "ghost" | "outline" | "subtle";
};

const {
  class: className,
  color = "primary",
  link,
  size = "default",
  type = "button",
  variant = "default",
  ...props
} = Astro.props;

const isLink = !!link;
const Component = isLink ? "a" : "button";

let linkHref: string | undefined;
let linkRel: string | undefined;
let linkTarget: string | undefined;

if (link) {
  const isTelOrMail =
    link.href.startsWith("mailto:") || link.href.startsWith("tel:");
  linkHref = link.isExternal || isTelOrMail ? link.href : base_url(link.href);
  linkRel = !isTelOrMail && link.isExternal ? "noopener noreferrer" : undefined;
  linkTarget =
    !isTelOrMail &&
    (link.isNewWindow || (link.isExternal && !link.isSameWindow))
      ? "_blank"
      : undefined;
}

const buttonVariants = cva(
  "tw:inline-flex tw:box-border tw:shrink-0 tw:items-center tw:justify-center tw:align-middle tw:whitespace-nowrap tw:font-medium tw:text-sm tw:leading-none tw:tracking-[0.01em] tw:no-underline! tw:border tw:border-solid tw:transition-[color,background-color,border-color,opacity,box-shadow] tw:duration-150 tw:ease-[ease] tw:cursor-pointer tw:select-none tw:outline-none tw:disabled:opacity-50 tw:disabled:pointer-events-none tw:aria-[disabled=true]:opacity-50 tw:aria-[disabled=true]:pointer-events-none tw:focus-visible:outline-2 tw:focus-visible:outline-solid tw:focus-visible:outline-offset-2 tw:focus-visible:outline-[color:currentColor] tw:[&_svg]:shrink-0 tw:[&_svg]:pointer-events-none",
  {
    compoundVariants: [
      // primary
      {
        class:
          "tw:bg-primary tw:text-primary-foreground! tw:border-primary tw:hover:opacity-90 tw:active:opacity-80",
        color: "primary",
        variant: "default",
      },
      {
        class:
          "tw:bg-transparent tw:text-primary! tw:border-primary tw:hover:bg-primary/8 tw:active:bg-primary/14",
        color: "primary",
        variant: "outline",
      },
      {
        class:
          "tw:bg-primary/12 tw:text-primary! tw:border-primary/35 tw:hover:bg-primary/18 tw:active:bg-primary/24",
        color: "primary",
        variant: "subtle",
      },
      {
        class:
          "tw:bg-transparent tw:text-primary! tw:border-transparent tw:hover:bg-primary/8 tw:active:bg-primary/14",
        color: "primary",
        variant: "ghost",
      },

      // secondary
      {
        class:
          "tw:bg-secondary tw:text-secondary-foreground! tw:border-secondary tw:hover:opacity-90 tw:active:opacity-80",
        color: "secondary",
        variant: "default",
      },
      {
        class:
          "tw:bg-transparent tw:text-secondary! tw:border-secondary tw:hover:bg-secondary/8 tw:active:bg-secondary/14",
        color: "secondary",
        variant: "outline",
      },
      {
        class:
          "tw:bg-secondary/12 tw:text-secondary! tw:border-secondary/35 tw:hover:bg-secondary/18 tw:active:bg-secondary/24",
        color: "secondary",
        variant: "subtle",
      },
      {
        class:
          "tw:bg-transparent tw:text-secondary! tw:border-transparent tw:hover:bg-secondary/8 tw:active:bg-secondary/14",
        color: "secondary",
        variant: "ghost",
      },

      // neutral
      {
        class:
          "tw:bg-neutral tw:text-neutral-foreground! tw:border-neutral tw:hover:opacity-90 tw:active:opacity-80",
        color: "neutral",
        variant: "default",
      },
      {
        class:
          "tw:bg-transparent tw:text-neutral! tw:border-neutral tw:hover:bg-neutral/8 tw:active:bg-neutral/14",
        color: "neutral",
        variant: "outline",
      },
      {
        class:
          "tw:bg-neutral/12 tw:text-neutral! tw:border-neutral/35 tw:hover:bg-neutral/18 tw:active:bg-neutral/24",
        color: "neutral",
        variant: "subtle",
      },
      {
        class:
          "tw:bg-transparent tw:text-neutral! tw:border-transparent tw:hover:bg-neutral/8 tw:active:bg-neutral/14",
        color: "neutral",
        variant: "ghost",
      },

      // accent
      {
        class:
          "tw:bg-accent tw:text-accent-foreground! tw:border-accent tw:hover:opacity-90 tw:active:opacity-80",
        color: "accent",
        variant: "default",
      },
      {
        class:
          "tw:bg-transparent tw:text-accent! tw:border-accent tw:hover:bg-accent/8 tw:active:bg-accent/14",
        color: "accent",
        variant: "outline",
      },
      {
        class:
          "tw:bg-accent/12 tw:text-accent! tw:border-accent/35 tw:hover:bg-accent/18 tw:active:bg-accent/24",
        color: "accent",
        variant: "subtle",
      },
      {
        class:
          "tw:bg-transparent tw:text-accent! tw:border-transparent tw:hover:bg-accent/8 tw:active:bg-accent/14",
        color: "accent",
        variant: "ghost",
      },
    ],

    defaultVariants: {
      color: "primary",
      size: "default",
      variant: "default",
    },

    variants: {
      color: {
        accent: "",
        neutral: "",
        primary: "",
        secondary: "",
      },
      size: {
        default:
          "tw:rounded-lg tw:h-9 tw:gap-1.5 tw:px-2.5 tw:has-[>svg:first-child]:pl-2 tw:has-[>svg:last-child]:pr-2 tw:[&_svg]:size-4",
        icon: "tw:rounded-lg tw:size-9 tw:[&_svg]:size-4",
        "icon-lg": "tw:rounded-lg tw:size-10 tw:[&_svg]:size-4",
        "icon-sm": "tw:rounded-md tw:size-8 tw:[&_svg]:size-4",
        lg: "tw:rounded-lg tw:h-10 tw:gap-1.5 tw:px-2.5 tw:has-[>svg:first-child]:pl-2 tw:has-[>svg:last-child]:pr-2 tw:[&_svg]:size-4",
        sm: "tw:rounded-md tw:h-8 tw:gap-1 tw:px-2.5 tw:text-[0.8rem] tw:has-[>svg:first-child]:pl-1.5 tw:has-[>svg:last-child]:pr-1.5 tw:[&_svg]:size-3.5",
      },
      variant: {
        default: "",
        ghost: "",
        outline: "",
        subtle: "",
      },
    },
  },
);
---

<Component
  class:list={[buttonVariants({ color, size, variant }), className]}
  data-slot="ui_button"
  href={linkHref}
  rel={linkRel}
  target={linkTarget}
  type={!isLink ? type : undefined}
  {...props}
>
  <slot />
</Component>
