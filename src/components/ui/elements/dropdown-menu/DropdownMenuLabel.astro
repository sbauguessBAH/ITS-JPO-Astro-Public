---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/src/lib/utils";

type Props = HTMLAttributes<"div"> & {
  class?: string;
  inset?: boolean;
};

const { class: className, inset, ...props } = Astro.props;
---

<div
  class={cn(
    "tw:box-border tw:px-4 tw:pt-1 tw:pb-0.5 tw:text-xs tw:leading-tight tw:font-semibold tw:text-muted-foreground tw:data-[inset]:pl-8",
    className,
  )}
  data-inset={inset ? "" : undefined}
  data-slot="dropdown-menu-label"
  {...props}
>
  <slot />
</div>
