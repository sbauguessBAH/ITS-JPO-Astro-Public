---
import base_url from '@/src/lib/base_url';
import type { HTMLAttributes } from 'astro/types';
import './card.css';

/**
 * TODO: Test out and clean up horizontal orientation
 */
type Props = HTMLAttributes<"div"> & {
  /**
   * Uses Bootstrap box shadow classes
   *
   * @default `sm`
   */
  shadow?: "none" | "sm" | "md" | "lg";
  /** @default `default` */
  size?: "default" | "sm";
  href?: string;
  isExternal?: boolean;
  orientation?: "vertical" | "horizontal";
}
const {
  shadow = "sm",
  href,
  isExternal,
  class: className,
  size,
  orientation = "vertical",
  ...rest
} = Astro.props

const Component = href ? "a" : "div";
/**
 * @privateRemarks
 *
 * Bootstrap box shadow options: `shadow-none`, `shadow-sm`, `shadow`, `shadow-lg`
 *
 * `shadow-sm` seems to be most consistently used for cards across the site.
 */
const shadowClass = {
  'shadow-none': shadow === 'none',
  'shadow-sm': shadow === 'sm',
  'shadow': shadow === 'md',
  'shadow-lg': shadow === 'lg',
};

const linkAttrs = href && isExternal
  ? { href, target: "_blank", rel: "noopener noreferrer" }
  : href
    ? { href: base_url(href) }
    : undefined;
---
<Component
  data-slot="ui_card"
  data-size={size}
  data-orientation={orientation}
  class:list={[
    "ui_card",
    Object.entries(shadowClass).find(([, isActive]) => isActive)?.[0],
    href && "ui_card_link",
    className
  ]}
  {...linkAttrs}
  {...rest}
>
  <slot/>
</Component>