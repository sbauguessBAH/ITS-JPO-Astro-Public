---
/**
 * Icon component to dynamically render pre-installed icons
 *
 * @remarks
 * This component uses `import.meta.glob` to dynamically load SVG icons from
 * the `src/icons/` directory.
 *
 * To add a new icon:
 *
 * 1. Place the `.svg` file in the `src/icons/` directory.
 * 2. Add the icon name to the `ICON_NAMES` array in `src/components/ui/icon/icons.ts`.
 *
 * @privateRemarks
 * I tried to keep this component as simple as possible. I drew inspiration from
 * a few different places and created a unique implementation:
 *
 * - [Astro Icon](https://github.com/natemoo-re/astro-icon/blob/main/README.md)
 * - [Frontendland/webcoreui](https://github.com/Frontendland/webcoreui)
 * - [fulldotdev/ui](https://github.com/fulldotdev/ui)
 */
import type { HTMLAttributes } from "astro/types";

import type { IconName } from "./icons";

type Props = HTMLAttributes<"svg"> & {
  class?: string;
  name: IconName;
  size?: number | string;
};

const { class: className, name, size = 24 } = Astro.props;

// eslint-disable-next-line @typescript-eslint/no-explicit-any
const icons = import.meta.glob<{ default: any }>("/src/icons/*.svg");

async function findIcon() {
  const iconPath = `/src/icons/${name}.svg`;
  if (!icons[iconPath]) {
    throw new Error(`Icon file not found: ${iconPath}`);
  }

  const icon = await icons[iconPath]();
  return icon;
}

// Resolve the icon component dynamically
const svg = await findIcon();
const Component = svg.default;
---

<Component class={className} fill="currentColor" height={size} width={size} />
