---
import Breadcrumb from "@/src/components/programs/Breadcrumb.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageContainer from "@/src/components/ui/blocks/page/PageContainer.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import Badge from "@/src/components/ui/elements/badge/Badge.astro";
import Button from "@/src/components/ui/elements/button/Button.astro";
import Icon from "@/src/components/ui/icon/Icon.astro";

interface Props {
  chat?: string;
  code?: string;
  length: string;
  module: number;
  parent: { name: string; path: string };
  presentation?: string;
  supplement?: string;
  title: string;
  transcript?: string;
}

const {
  chat,
  code,
  length,
  module,
  parent,
  presentation,
  supplement,
  title,
  transcript,
} = Astro.props;

const resources = [
  { href: presentation, label: "Presentation" },
  { href: supplement, label: "Supplement" },
  { href: transcript, label: "Course Transcript" },
  { href: chat, label: "Chat Transcript" },
].filter((resource) => !!resource.href);
---

<style>
  a::after {
    content: "" !important;
  }
  .training-content :global(h3) {
    color: var(--tw-primary) !important;
    font-weight: 700;
    font-size: 1.6rem;
    text-transform: none;
    margin: 1.5rem 0 0.5rem;
  }
  .training-content :global(h3:first-child) {
    margin-top: 0;
  }
  .training-content :global(p) {
    font-size: 1.1rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }
</style>
<Page>
  <PageContainer>
    <Breadcrumb
      items={[
        { name: "Trainings", path: "/resources/pcb/trainings" },
        parent,
        { name: `Module ${module}` },
      ]}
    />
  </PageContainer>
  <PageHeader
    headline={code ? `Module ${module} | ${code}` : `Module ${module}`}
    title={title}
  >
    <Badge class="tw:w-fit" color="neutral" size="sm" slot="description">
      {length}
    </Badge>
    {
      resources.length > 0 && (
        <div class="tw:flex tw:flex-wrap tw:gap-2 tw:pt-2">
          {resources.map((resource) => (
            <Button
              link={{ href: resource.href!, isNewWindow: true }}
              variant="subtle"
            >
              <Icon name="pdf" />
              {resource.label}
            </Button>
          ))}
        </div>
      )
    }
  </PageHeader>
  <Section>
    <div class="training-content">
      <slot />
    </div>
  </Section>
</Page>
