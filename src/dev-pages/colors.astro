/**
 * Color Palettes used across the ITS JPO website.
 *
 * @remarks
 *
 * Colors were converted from Hex to OKLCH using this tool: {@link https://oklch.com/}.
 * OKLCH colors support better mixing and enables more auto-generated variants.
 */
import ProgramLayout from "@/src/components/programs/ProgramLayout.astro";

type ColorFormat = "hex" | "oklch" | "pantone" | "rgb";

type ColorPalette = {
  name: string;
  notes?: string;
  source: string;
  swatches: (ColorSwatchBase | ColorSwatchComponent | ColorSwatchGradient)[];
};

type ColorSwatch = {
  disabled?: boolean;
  name?: string;
  notes?: string;
  variables?: string[];
};

type ColorSwatchBase = ColorSwatch & {
  type: "swatch";
  values: ColorValue[];
};

type ColorSwatchComponent = ColorSwatch & {
  type: "component";
  values: {
    background: ColorValue[];
    foreground: ColorValue[];
  };
};

type ColorSwatchGradient = ColorSwatch & {
  type: "gradient";
  values: {
    left: ColorValue[];
    right: ColorValue[];
  };
};

type ColorValue = {
  active?: boolean;
  format: ColorFormat;
  value: string;
};

