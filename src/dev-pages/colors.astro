function getSwatchBackground(
  swatch: ColorSwatchBase | ColorSwatchComponent | ColorSwatchGradient,
) {
  if (swatch.type === "swatch") {
    // If type is swatch, then background style is just the color bg.
    const color = swatch.values.find((value) => value.format === "hex");
    return { background: color?.value };
  } else if (swatch.type === "component") {
    // If type is component, then background style is the background color and foreground is a dot on top.
    const color = swatch.values.background.find(
      (value) => value.format === "hex",
    );
    return { background: color?.value };
  } else if (swatch.type === "gradient") {
    // If type is gradient, backgroundImage of left to right gradient of both colors.
    const leftColor = swatch.values.left.find(
      (value) => value.format === "hex",
    );
    const rightColor = swatch.values.right.find(
      (value) => value.format === "hex",
    );
    return {
      backgroundImage: `linear-gradient(to right, ${leftColor?.value}, ${rightColor?.value})`,
    };
  }
  return {};
}

function getSwatchForeground(
  swatch: ColorSwatchBase | ColorSwatchComponent | ColorSwatchGradient,
) {
  if (swatch.type === "component") {
    const color = swatch.values.foreground.find(
      (value) => value.format === "hex",
    );
    return { color: color?.value };
  }
  return {};
}
---

<ProgramLayout title="Library">
  <div class="tw:mx-auto tw:flex tw:max-w-7xl tw:flex-col tw:gap-8">
    <div>
      <p>
        This page shows all the colors I've found so far that are used across
        the site. There's definitely more that can be added, but I tried to
        focus on identifying the main ones so we can start to ensure consistency
        throughout pages. There are a couple different palettes depending on
        where the colors were found. Not all of them are used on the site, but
        lots of them are and many have similar/redundant swatches.
      </p>
      <p>
        Different color formats are also included throughout the site. The color
        format used on the active site has a checkmark next to it. New colors
        for Tailwind are defined in OKLCH format for better color mixing and
        generation of variants.
      </p>
    </div>
    {
      palettes.map((palette) => (
        <div>
          <h2 class="tw:bg-card tw:text-3xl tw:font-bold">{palette.name}</h2>
          <span class="tw:w-fit tw:rounded-xl tw:bg-black/5 tw:px-2.5 tw:py-0.5 tw:text-base tw:text-black/50">
            {palette.source}
          </span>
          <p>{palette.notes}</p>
          <div class="tw:grid tw:grid-cols-2">
            {palette.swatches.map((swatch) => {
              return (
                <div
                  class:list={[
                    "tw:flex tw:flex-row tw:gap-4 tw:border tw:border-black/5 tw:p-3",
                    swatch.disabled ? "tw:bg-black/5 tw:opacity-50" : "",
                  ]}
                >
                  <div
                    class="tw:flex tw:size-20 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-xl"
                    style={getSwatchBackground(swatch)}
                  >
                    {swatch.type === "component" && (
                      <span
                        class="tw:text-2xl"
                        style={getSwatchForeground(swatch)}
                      >
                        abc
                      </span>
                    )}
                  </div>

                  <div class="tw:flex tw:w-full tw:justify-between">
                    <div class="tw:flex tw:w-full tw:flex-col tw:gap-1">
                      <div class="tw:flex tw:items-baseline tw:gap-0.5 tw:text-sm tw:font-semibold">
                        {swatch.name}
                      </div>
                      <small class="tw:text-black/60">{swatch.notes}</small>
                      <div class="tw:flex tw:flex-row tw:flex-wrap tw:gap-0.5">
                        {swatch.variables?.map((variable) => (
                          <span class="tw:h-4 tw:w-fit tw:rounded-xl tw:bg-black/5 tw:px-1 tw:text-xs tw:text-black/50">
                            {variable}
                          </span>
                        ))}
                      </div>
                      <div class="tw:flex tw:w-full tw:flex-col">
                        {swatch.type === "component" ? (
                          <div class="tw:grid tw:grid-cols-2 tw:gap-1">
                            <div class="tw:flex tw:flex-col tw:rounded-md tw:border tw:border-border tw:p-1">
                              <span class="tw:text-xs tw:font-bold tw:uppercase">
                                Background:
                              </span>
                              {swatch.values.background.map((colorValue) => (
                                <span class="tw:font-mono tw:text-xs">
                                  {colorValue.active && "✓ "}
                                  {colorValue.format}: {colorValue.value}
                                </span>
                              ))}
                            </div>
                            <div class="tw:flex tw:flex-col tw:rounded-md tw:border tw:border-border tw:p-1">
                              <span class="tw:text-xs tw:font-bold tw:uppercase">
                                Foreground:
                              </span>
                              {swatch.values.foreground.map((colorValue) => (
                                <span class="tw:font-mono tw:text-xs">
                                  {colorValue.active && "✓ "}
                                  {colorValue.format}: {colorValue.value}
                                </span>
                              ))}
                            </div>
                          </div>
                        ) : swatch.type === "gradient" ? (
                          <div class="tw:grid tw:grid-cols-2 tw:gap-1">
                            <div class="tw:flex tw:flex-col tw:rounded-md tw:border tw:border-border tw:p-1">
                              <span class="tw:text-xs tw:font-bold tw:uppercase">
                                Left:
                              </span>
                              {swatch.values.left.map((colorValue) => (
                                <span class="tw:font-mono tw:text-xs">
                                  {colorValue.active && "✓ "}
                                  {colorValue.format}: {colorValue.value}
                                </span>
                              ))}
                            </div>
                            <div class="tw:flex tw:flex-col tw:rounded-md tw:border tw:border-border tw:p-1">
                              <span class="tw:text-xs tw:font-bold tw:uppercase">
                                Right:
                              </span>
                              {swatch.values.right.map((colorValue) => (
                                <span class="tw:font-mono tw:text-xs">
                                  {colorValue.active && "✓ "}
                                  {colorValue.format}: {colorValue.value}
                                </span>
                              ))}
                            </div>
                          </div>
                        ) : (
                          <div class="tw:flex tw:w-full tw:flex-col tw:rounded-md tw:border tw:border-border tw:p-1">
                            {swatch.values.map((colorValue) => (
                              <span class="tw:font-mono tw:text-xs">
                                {colorValue.active && "✓ "}
                                {colorValue.format}: {colorValue.value}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))
    }
  </div>
</ProgramLayout>
