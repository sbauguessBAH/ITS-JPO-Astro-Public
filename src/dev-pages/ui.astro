---
import LibraryImage from "@/src/components/programs/LibraryImage.astro";
import ProgramLayout from "@/src/components/programs/ProgramLayout.astro";
import Item from "@/src/components/ui/blocks/item/Item.astro";
import ItemActions from "@/src/components/ui/blocks/item/ItemActions.astro";
import ItemContent from "@/src/components/ui/blocks/item/ItemContent.astro";
import ItemDescription from "@/src/components/ui/blocks/item/ItemDescription.astro";
import ItemFooter from "@/src/components/ui/blocks/item/ItemFooter.astro";
import ItemGroup from "@/src/components/ui/blocks/item/ItemGroup.astro";
import ItemHeader from "@/src/components/ui/blocks/item/ItemHeader.astro";
import ItemMedia from "@/src/components/ui/blocks/item/ItemMedia.astro";
import ItemTitle from "@/src/components/ui/blocks/item/ItemTitle.astro";
import Button from "@/src/components/ui/elements/button/Button.astro";
import BullseyeIcon from "@/src/components/ui/icons/BullseyeIcon.astro";

const itemGroups: Array<{
  className: string;
  items: Array<{
    actions?: boolean;
    content?: {
      description: string;
      title: string;
    };
    footer?: string;
    header?: boolean;
    media?: boolean;
    size: "default" | "sm" | "xs";
    variant: "default" | "muted" | "outline";
  }>;
}> = [
  {
    className: "row row-cols-4",
    items: [
      {
        actions: false,
        content: {
          description:
            "This is an item with a header, media, actions, and footer",
          title: "Item Title",
        },
        header: true,
        media: true,
        size: "default",
        variant: "default",
      },
      {
        actions: true,
        content: {
          description: "size=sm, variant=muted",
          title: "Item Title",
        },
        footer: "Footer content",
        header: true,
        media: false,
        size: "sm",
        variant: "muted",
      },
      {
        actions: true,
        content: {
          description: "size=xs, variant=outline",
          title: "Item Title",
        },
        footer: "Footer content",
        header: true,
        media: false,
        size: "xs",
        variant: "outline",
      },
    ],
  },
  {
    className: "row row-cols-4",
    items: [
      {
        content: {
          description:
            "This is an item with a header, media, actions, and footer",
          title: "Item Title",
        },
        header: true,
        size: "default",
        variant: "muted",
      },
      {
        content: {
          description:
            "This is an item with a header, media, actions, and footer",
          title: "Item Title",
        },
        header: true,
        size: "default",
        variant: "muted",
      },
      {
        content: {
          description:
            "This is an item with a header, media, actions, and footer",
          title: "Item Title",
        },
        header: true,
        size: "default",
        variant: "muted",
      },
      {
        content: {
          description:
            "This is an item with a header, media, actions, and footer",
          title: "Item Title",
        },
        header: true,
        size: "default",
        variant: "muted",
      },
    ],
  },
  {
    className: "row row-cols-2",
    items: [
      {
        actions: true,
        content: {
          description:
            "This is an item with a header, media, actions, and footer",
          title: "Item Title",
        },
        media: true,
        size: "default",
        variant: "outline",
      },
      {
        actions: true,
        content: {
          description:
            "This is an item with a header, media, actions, and footer",
          title: "Item Title",
        },
        media: true,
        size: "default",
        variant: "muted",
      },
    ],
  },
  {
    className: "row row-cols-2",
    items: [
      {
        actions: true,
        content: {
          description:
            "This is an item with a header, media, actions, and footer",
          title: "Item Title",
        },
        size: "default",
        variant: "outline",
      },
      {
        content: {
          description:
            "This is an item with a header, media, actions, and footer",
          title: "Item Title",
        },
        media: true,
        size: "default",
        variant: "muted",
      },
    ],
  },
];
---

<ProgramLayout title="Library">
  <div class="container max-w-lg my-4">
    <div>
      Size
      <Button size="sm"> Small </Button>
      <Button size="default"> Default </Button>
      <Button size="lg"> Large </Button>
    </div>
    <div>
      With icon
      <Button size="sm"> Small <BullseyeIcon /></Button>
      <Button size="default"> Default <BullseyeIcon /></Button>
      <Button size="lg"> Large <BullseyeIcon /></Button>
    </div>
    <div>
      Icon only
      <Button size="icon-sm"> <BullseyeIcon /> </Button>
      <Button size="icon"> <BullseyeIcon /> </Button>
      <Button size="icon-lg"> <BullseyeIcon /> </Button>
    </div>
    <div>
      Primary Variants
      <Button color="primary" variant="default"> Default </Button>
      <Button color="primary" variant="ghost"> Ghost </Button>
      <Button color="primary" variant="outline"> Outline </Button>
      <Button color="primary" variant="subtle"> Subtle </Button>
    </div>
    <div>
      Secondary Variants
      <Button color="secondary" variant="default"> Default </Button>
      <Button color="secondary" variant="ghost"> Ghost </Button>
      <Button color="secondary" variant="outline"> Outline </Button>
      <Button color="secondary" variant="subtle"> Subtle </Button>
    </div>
  </div>
  <div class="container max-w-lg my-4">
    {
      itemGroups.map((group) => (
        <div class={group.className}>
          {group.items.map((item) => (
            <div class="col">
              <Item size={item.size} variant={item.variant}>
                {item.header && (
                  <ItemHeader>
                    <LibraryImage
                      class="w-100 radius-lg object-fit-cover"
                      entry="pcb/cohort"
                      height={100}
                    />
                  </ItemHeader>
                )}
                {item.media && (
                  <ItemMedia variant="icon">
                    <BullseyeIcon size={24} />
                  </ItemMedia>
                )}
                {item.content && (
                  <ItemContent>
                    <ItemTitle>{item.content.title}</ItemTitle>
                    <ItemDescription>
                      {item.content.description}
                    </ItemDescription>
                  </ItemContent>
                )}
                {item.actions && (
                  <ItemActions>
                    <button>Test button</button>
                  </ItemActions>
                )}
                {item.footer && <ItemFooter>{item.footer}</ItemFooter>}
              </Item>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</ProgramLayout>
