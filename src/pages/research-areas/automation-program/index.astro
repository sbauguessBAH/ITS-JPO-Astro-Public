---
import ProgramSection from "@/src/components/programs/ProgramSection.astro";
import OverlayCard, {
  type OverlayCardProps,
} from "@/src/components/ui/blocks/overlay-card/OverlayCard.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageBody from "@/src/components/ui/blocks/page/PageBody.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import Button from "@/src/components/ui/elements/button/Button.astro";
import Heading from "@/src/components/ui/elements/heading/Heading.astro";
import Item from "@/src/components/ui/elements/item/Item.astro";
import ItemActions from "@/src/components/ui/elements/item/ItemActions.astro";
import ItemContent from "@/src/components/ui/elements/item/ItemContent.astro";
import ItemDescription from "@/src/components/ui/elements/item/ItemDescription.astro";
import ItemHeader from "@/src/components/ui/elements/item/ItemHeader.astro";
import Icon from "@/src/components/ui/icon/Icon.astro";
import IconTile from "@/src/components/ui/icon/IconTile.astro";
import base_url from "@/src/lib/base_url";

import Layout from "./_layout.astro";
import Roadmap from "./_roadmap.astro";

const focusAreas: OverlayCardProps[] = [
  {
    backgroundImage: "automation/focus-areas/cooperative-driving-automation",
    color: "cyan",
    description:
      "Assess the feasibility of conducting a small-scale CDA pilot (focusing on L0-2 with Interoperable Connectivity) and package the accomplishments for design and architecture.",
    iconImage: "automation/focus-areas/icon-cda",
    name: "Cooperative Driving Automation (CDA)",
    path: "/research-areas/automation-program/focus-areas/cda",
  },
  {
    backgroundImage: "automation/focus-areas/analysis-modeling-simulation",
    color: "lime",
    description:
      "Crosscutting research and resource development including design, planning, operations, and impact assessments informed by improved AMS.",
    iconImage: "automation/focus-areas/icon-ams",
    name: "Analysis, Modeling and Simulation (AMS)",
    path: "/research-areas/automation-program/focus-areas/ams",
  },
  {
    backgroundImage: "automation/focus-areas/human-factors",
    color: "orange",
    description:
      "Identify likely safety-relevant scenarios where human performance and interaction behaviors with vehicle automation technologies have a mismatch and develop corresponding Human Factors best practices.",
    iconImage: "automation/focus-areas/icon-human-factors",
    name: "Human Factors",
    path: "/research-areas/automation-program/focus-areas/human-factors",
  },
  {
    backgroundImage: "automation/focus-areas/automated-driving-system",
    color: "crimson",
    description:
      "Explore recommended practices to address safe and efficient Automated Driving System (ADS) Integration into the transportation system.",
    iconImage: "automation/focus-areas/icon-ads",
    name: "Automated Driving System (ADS) Integration",
    path: "/research-areas/automation-program/focus-areas/ads",
  },
];

const strategies = [
  {
    description:
      "Research potential applications of vehicle automation technologies to achieve safety, mobility, and efficiency benefits through advanced wireless communications and interactions with interoperable connectivity and develop supporting standards and assessment tools to enable private and public sector deployment.",
    number: 1,
    title: "Applications of Vehicle Automation Technologies",
  },
  {
    description:
      "Collaborate with stakeholders to document and prioritize Analysis, Modeling and Simulation (AMS) capabilities for ITS, conduct research and development to enhance these capabilities, and provide resources to support their understanding and use.",
    number: 2,
    title: "Analysis, Modeling, and Simulation (AMS) Capabilities",
  },
  {
    description:
      "Study human interactions with vehicle automation technologies to identify potential mismatches and best practices for realizing safe and effective automation operations for all users in the roadway environment.",
    number: 3,
    title: "Human Interactions",
  },
  {
    description:
      "Identify challenges/issues that can negatively impact safe and efficient integration of Automated Driving System (ADS) technologies, such as lack of AV preparedness, limited understanding of ADS use cases that can maximize benefits, and not-well-understood ADS capabilities/safety protocols that vary between manufacturers and across ODDs.",
    number: 4,
    title: "Automated Driving Systems (ADS) Technologies",
  },
];
---

<Layout>
  <Page>
    <PageBody>
      <div class="tw:flex tw:flex-col tw:gap-4">
        <Heading>Program Overview</Heading>
        <div>
          <p class="program-text">
            Driving automation is one of the major transportation industry
            trends of this decade. Through close collaboration and monitoring of
            current industry and academic technology innovators and leaders in
            automation the ITS JPO continues the pursuit of an automation
            program that will support the safe deployment of an automated
            future. Advanced Driver Assistance Systems (ADAS) with automation of
            lateral or longitudinal controls are widely available in passenger
            vehicles, although their development and refinement continue.
            Automated Driving System (ADS)-equipped vehicles are being piloted
            in passenger vehicles, commercial motor vehicles, and transit buses.
          </p>
          <p class="program-text">
            While driving automation research has been, to some degree,
            mainstreamed across the Department's Operating Administrations,
            research needs are evolving alongside the technology. The
            technological and practical challenges of translating research
            breakthroughs into daily transportation are significant and often
            are not fully understood at the outset. Many foundational questions
            around ADS and ADAS may not be resolved until more and better data
            are available.
          </p>
          <p class="program-text">
            The ITS JPO Automation Program's collaborative and multi-modal
            research portfolio provides cross-cutting support across the U.S.
            DOT with the following strategies:
          </p>
        </div>
        <div
          class="tw:flex tw:flex-col tw:gap-6 tw:rounded-2xl tw:bg-muted tw:p-8"
          role="list"
        >
          <Heading size="md">Research Strategies</Heading>
          {
            strategies.map(({ description, number, title }) => (
              <div
                class="tw:grid tw:grid-cols-[auto_1fr] tw:items-center tw:gap-x-4 tw:gap-y-2 tw:lg:items-start"
                role="listitem"
              >
                <IconTile class="tw:bg-linear-to-br tw:from-primary tw:to-secondary tw:lg:row-span-2">
                  <span class="tw:text-xl tw:font-medium tw:text-primary-foreground">
                    {number}
                  </span>
                </IconTile>
                <Heading size="sm">{title}</Heading>
                <p class="tw:col-span-2 tw:lg:col-span-1 tw:lg:col-start-2">
                  {description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
      <ProgramSection color="gray">
        <div class="tw:mx-auto tw:max-w-5xl tw:text-center">
          <Heading size="md">Focus Areas</Heading>
          <p class="program-text">
            In collaboration with the Operating Administrations, ITS JPO
            prioritized near-term research focus areas to directly address
            strategies stated above, and achieve desired outcomes across four
            current focus areas:
          </p>
        </div>
        <div
          class="mt-4 tw:grid tw:grid-cols-1 tw:gap-4 tw:min-[992px]:grid-cols-2"
          role="directory"
        >
          {focusAreas.map((focusArea) => <OverlayCard {...focusArea} />)}
        </div>
      </ProgramSection>
      <div
        class="tw:mx-auto tw:flex tw:w-full tw:max-w-5xl tw:flex-col tw:gap-4"
      >
        <div class="tw:flex tw:flex-col tw:gap-2 tw:text-center">
          <Heading size="md">Program Roadmap</Heading>
          <p class="program-text">
            In collaboration with the Operating Administrations, ITS JPO
            prioritized near-term research focus areas to directly address
            strategies stated above, and achieve desired outcomes across four
            current focus areas:
          </p>
        </div>
        <Item variant="muted">
          <ItemHeader class="tw:overflow-x-auto">
            <Roadmap className="tw:w-full tw:min-w-4xl" />
          </ItemHeader>
          <ItemContent>
            <ItemDescription>Last Updated: May 2025</ItemDescription>
          </ItemContent>
          <ItemActions>
            <Button
              link={{
                href: base_url("/assets/images/automation/roadmap.png"),
                isNewWindow: true,
              }}
              variant="ghost"
            >
              <Icon name="download" />
              Download Image
            </Button>
          </ItemActions>
        </Item>
      </div>
    </PageBody>
  </Page>
</Layout>
