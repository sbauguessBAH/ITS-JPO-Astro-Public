---
import { getCollection } from "astro:content";

import ProgramSection from "@/src/components/programs/ProgramSection.astro";
import Badge from "@/src/components/ui/elements/badge/Badge.astro";
import Card from "@/src/components/ui/elements/card/Card.astro";
import CardContent from "@/src/components/ui/elements/card/CardContent.astro";
import CardHeader from "@/src/components/ui/elements/card/CardHeader.astro";
import CardTitle from "@/src/components/ui/elements/card/CardTitle.astro";
import Heading from "@/src/components/ui/elements/heading/Heading.astro";
import Item from "@/src/components/ui/elements/item/Item.astro";
import ItemActions from "@/src/components/ui/elements/item/ItemActions.astro";
import ItemContent from "@/src/components/ui/elements/item/ItemContent.astro";
import ItemDescription from "@/src/components/ui/elements/item/ItemDescription.astro";
import ItemGroup from "@/src/components/ui/elements/item/ItemGroup.astro";
import ItemTitle from "@/src/components/ui/elements/item/ItemTitle.astro";
import Icon from "@/src/components/ui/icon/Icon.astro";
import base_url from "@/src/lib/base_url";

import Layout from "../_layout.astro";

export const areas = [
  {
    path: undefined,
    title: "All",
  },
  {
    path: "ams",
    title: "Analysis, Modeling, and Simulation (AMS)",
  },
  {
    path: "ads",
    title: "Automated Driving System (ADS) Integration",
  },
  {
    path: "cda",
    title: "Cooperative Driving Automation (CDA)",
  },
  {
    path: "human-factors",
    title: "Human Factors",
  },
  {
    path: "other",
    title: "Other",
  },
];

export async function getStaticPaths() {
  return areas.map((area) => ({
    params: {
      path: area.path,
    },
    props: {
      title: area.title,
    },
  }));
}

const { path } = Astro.params;
const { title } = Astro.props;

const resources = await getCollection("automationResources");

interface Deliverable {
  title: string;
  url: string;
  year: number;
}

interface Project {
  area: string;
  deliverables: Deliverable[];
  title: string;
}

const projects = resources
  .filter(({ data }) => title === "All" || data.area === title)
  .reduce((acc, { data }) => {
    const index = acc.findIndex((prev) => prev.title === data.project);

    if (index >= 0) {
      acc[index].deliverables.push({
        title: data.deliverable,
        url: data.url,
        year: data.year,
      });
    } else {
      acc.push({
        area: data.area,
        deliverables: [
          {
            title: data.deliverable,
            url: data.url,
            year: data.year,
          },
        ],
        title: data.project,
      });
    }

    return acc;
  }, [] as Project[]);
---

<style>
  .resource-container {
    display: flex;
    flex-direction: column;
    gap: var(--size);
  }

  .resource-card-header {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--size-sm);
    padding: var(--size);
    /* padding-bottom: 0; */
  }

  .resource-card-body {
    padding: 0;
    background: rgb(var(--color-gray-light));
  }

  /* .resource-menu {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .resource-menu-item {
    padding: 0.5rem 1rem;
    width: 100%;
    text-decoration: none;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-light);
    font-weight: 600;
  }
  .resource-menu-item:hover {
    text-decoration: none;
    font-weight: 600;
  }

  .resource-menu-item-active {
    background: rgb(var(--color-brand));
    color: white;
  } */

  .resource-area-badge {
    background: rgb(var(--color-gray-light));
    border: 1px solid var(--border-light);
    border-radius: 1rem;
    font-size: 0.9rem;
    height: 24px;
    width: fit-content;
    padding: 0 0.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: 600;
  }

  .deliverable-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    /* gap: 0.5rem; */
  }

  .deliverable-list-item {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: var(--size-sm) var(--size);
    border-bottom: 1px solid var(--border-light);
  }

  .deliverable-title {
    flex-basis: calc(9 / 10 * 100%);
  }

  .deliverable-title:hover {
    font-weight: 400;
  }

  .deliverable-year {
    font-weight: 600;
  }

  @media (min-width: 992px) {
    .resource-container {
      flex-direction: row;
    }
    .resource-menu {
      flex-basis: 25%;
    }
    .resource-menu-item {
    }
    .resource-list {
      flex-basis: 75%;
    }
  }
</style>
<style>
  .panel {
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-light);
    /* box-shadow: var(--box-shadow); */
  }
  .panel-item {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    text-decoration: none;
    border-bottom: 1px solid var(--border-light);
    padding: 0.5rem 1rem;
    font-weight: 600;
    /* color: black; */
  }
  .panel-item:hover {
    font-weight: 600;
    background: rgb(var(--color-brand-light));
  }
  .panel-item-active {
    background: rgb(var(--color-brand-light));
  }
  .panel-item-active .panel-count {
    background: rgb(var(--color-brand-dark));
    color: white;
  }
  .panel-item-active:hover {
    background: rgb(var(--color-brand-light));
  }
</style>
<Layout title="Automation Program">
  <main class="program-main">
    <ProgramSection>
      <Heading>Resources</Heading>
      <div class="resource-container mt-4">
        <div class="tw:basis-1/4">
          <nav
            class="tw:flex tw:flex-col tw:rounded-2xl tw:border tw:border-border"
          >
            <h3
              class="tw:m-0! tw:rounded-t-2xl tw:bg-primary tw:p-4! tw:text-xl! tw:text-white! tw:normal-case!"
            >
              Areas
            </h3>
            {
              areas.map((item) => (
                <a
                  class:list={[
                    "panel-item",
                    { "panel-item-active": item.path === path },
                  ]}
                  data-bs-title={item.title}
                  data-bs-toggle="tooltip"
                  href={base_url(
                    `/research-areas/automation-program/resources/${item.path ?? ""}`,
                  )}
                >
                  <div class="panel-item-text">{item.title}</div>
                </a>
              ))
            }
          </nav>
        </div>
        <div class="tw:flex tw:basis-3/4 tw:flex-col tw:gap-4">
          {
            projects.map((project) => {
              const sortedDeliverables = project.deliverables.toSorted(
                (a, b) => b.year - a.year,
              );
              return (
                <Card>
                  <CardHeader>
                    <Badge color="neutral" variant="subtle">
                      {project.area}
                    </Badge>
                    <CardTitle class="tw:text-primary!">
                      {project.title}
                    </CardTitle>
                  </CardHeader>
                  <CardContent>
                    <ItemGroup>
                      {sortedDeliverables.map((deliverable) => (
                        <Item
                          href={deliverable.url}
                          isExternal
                          size="xs"
                          variant="muted"
                        >
                          <ItemContent>
                            <ItemTitle class="tw:text-base!">
                              {deliverable.title}
                            </ItemTitle>
                            <ItemDescription>
                              {deliverable.year}
                            </ItemDescription>
                          </ItemContent>
                          <ItemActions>
                            <Icon class="tw:size-3" name="external-link" />
                          </ItemActions>
                        </Item>
                      ))}
                    </ItemGroup>
                  </CardContent>
                </Card>
              );
            })
          }
        </div>
      </div>
    </ProgramSection>
  </main>
</Layout>
