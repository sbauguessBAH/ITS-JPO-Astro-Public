---
import { getCollection } from "astro:content";

import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";
import Panel from "@/src/components/ui/blocks/panel/Panel.astro";
import PanelGroup from "@/src/components/ui/blocks/panel/PanelGroup.astro";
import PanelHeader from "@/src/components/ui/blocks/panel/PanelHeader.astro";
import PanelItem from "@/src/components/ui/blocks/panel/PanelItem.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import Badge from "@/src/components/ui/elements/badge/Badge.astro";
import Card from "@/src/components/ui/elements/card/Card.astro";
import CardContent from "@/src/components/ui/elements/card/CardContent.astro";
import CardHeader from "@/src/components/ui/elements/card/CardHeader.astro";
import CardTitle from "@/src/components/ui/elements/card/CardTitle.astro";
import Item from "@/src/components/ui/elements/item/Item.astro";
import ItemActions from "@/src/components/ui/elements/item/ItemActions.astro";
import ItemContent from "@/src/components/ui/elements/item/ItemContent.astro";
import ItemDescription from "@/src/components/ui/elements/item/ItemDescription.astro";
import ItemGroup from "@/src/components/ui/elements/item/ItemGroup.astro";
import ItemTitle from "@/src/components/ui/elements/item/ItemTitle.astro";
import Icon from "@/src/components/ui/icon/Icon.astro";

import Layout from "../_layout.astro";

export const areas = [
  {
    path: undefined,
    title: "All",
  },
  {
    path: "ams",
    title: "Analysis, Modeling, and Simulation (AMS)",
  },
  {
    path: "ads",
    title: "Automated Driving System (ADS) Integration",
  },
  {
    path: "cda",
    title: "Cooperative Driving Automation (CDA)",
  },
  {
    path: "human-factors",
    title: "Human Factors",
  },
  {
    path: "other",
    title: "Other",
  },
];

export async function getStaticPaths() {
  return areas.map((area) => ({
    params: {
      path: area.path,
    },
    props: {
      title: area.title,
    },
  }));
}

const { path } = Astro.params;
const { title } = Astro.props;

const resources = await getCollection("automationResources");

interface Deliverable {
  title: string;
  url: string;
  year: number;
}

interface Project {
  area: string;
  deliverables: Deliverable[];
  title: string;
}

const projects = resources
  .filter(({ data }) => title === "All" || data.area === title)
  .reduce((acc, { data }) => {
    const index = acc.findIndex((prev) => prev.title === data.project);

    if (index >= 0) {
      acc[index].deliverables.push({
        title: data.deliverable,
        url: data.url,
        year: data.year,
      });
    } else {
      acc.push({
        area: data.area,
        deliverables: [
          {
            title: data.deliverable,
            url: data.url,
            year: data.year,
          },
        ],
        title: data.project,
      });
    }

    return acc;
  }, [] as Project[]);
---
<Layout title="Automation Program">
  <Page>
    <PageHeader title="Resources" />
    <Section>
      <div class="tw:flex tw:flex-col tw:gap-4 tw:lg:flex-row">
        <div class="tw:basis-1/4">
          <Panel label="Resource areas">
            <PanelHeader>Areas</PanelHeader>
            <PanelGroup>
              {
                areas.map((item) => (
                  <PanelItem
                    active={item.path === path}
                    href={`/research-areas/automation-program/resources/${item.path ?? ""}`}
                  >
                    {item.title}
                  </PanelItem>
                ))
              }
            </PanelGroup>
          </Panel>
        </div>
        <div class="tw:flex tw:basis-3/4 tw:flex-col tw:gap-4">
          {
            projects.map((project) => {
              const sortedDeliverables = project.deliverables.toSorted(
                (a, b) => b.year - a.year,
              );
              return (
                <Card>
                  <CardHeader>
                    <Badge color="neutral" size="lg">
                      {project.area}
                    </Badge>
                    <CardTitle class="tw:text-primary!">
                      {project.title}
                    </CardTitle>
                  </CardHeader>
                  <CardContent>
                    <ItemGroup>
                      {sortedDeliverables.map((deliverable) => (
                        <Item
                          href={deliverable.url}
                          isExternal
                          size="sm"
                          variant="muted"
                        >
                          <ItemContent>
                            <ItemDescription>
                              {deliverable.year}
                            </ItemDescription>
                            <ItemTitle class="tw:text-base!">
                              {deliverable.title}
                            </ItemTitle>
                          </ItemContent>
                          <ItemActions>
                            <Icon class="tw:size-3" name="external-link" />
                          </ItemActions>
                        </Item>
                      ))}
                    </ItemGroup>
                  </CardContent>
                </Card>
              );
            })
          }
        </div>
      </div>
    </Section>
  </Page>
</Layout>
