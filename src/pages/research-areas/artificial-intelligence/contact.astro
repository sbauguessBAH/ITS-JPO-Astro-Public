---
import banner from "@/src/assets/images/banners/Emerging_Tech_Banner.png";
import PageLayout from "@/src/layouts/PageLayout.astro";
---

<PageLayout title="Contact" bannerImage={banner}>
  <Fragment slot="banner">Artificial Intelligence (AI)</Fragment>
  <main>
    <h2>Contact Us</h2>
    <p>Please use the contact details below to reach out to the ITS JPO AI Program.</p>

    <div class="contact-card p-4 rounded-4">
      <h3>QUESTIONS OR SUGGESTIONS</h3>
      <p class="mb-0">
        ITS JPO AI Program<br />
        <a href="mailto:ai.itsjpo@dot.gov">ai.itsjpo@dot.gov</a>
      </p>
    </div>
  </main>
</PageLayout>

<style>
  .contact-card {
    background-color: #f0f8ff;
    border: 1px solid #d1e7f7;
  }
</style>