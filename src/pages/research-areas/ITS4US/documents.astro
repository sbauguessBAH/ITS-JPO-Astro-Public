---
import { getCollection } from 'astro:content';
import PageLayout from '@/src/layouts/PageLayout.astro';
import PublicationsFilter from '@/src/components/its4us/PublicationsFilter.vue';
import PublicationCard from '@/src/components/its4us/PublicationCard.astro';

// Load all publications and sort by date descending
const publications = await getCollection('its4usPublications');
const sortedPublications = publications.sort((a, b) => 
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

// Extract unique deployment acronyms with counts
const acronymStats = sortedPublications.reduce((acc, pub) => {
  const acronym = pub.data.deploymentAcronym;
  acc[acronym] = (acc[acronym] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

// Combine linked acronyms for display
const combinedAcronyms = new Map<string, { value: string, label: string, count: number }>();

Object.entries(acronymStats).forEach(([acronym, count]) => {
  if (acronym === 'ARC' || acronym === 'GDOT') {
    const existing = combinedAcronyms.get('ARC/GDOT');
    if (existing) {
      existing.count += count;
    } else {
      combinedAcronyms.set('ARC/GDOT', { value: 'ARC/GDOT', label: 'ARC/GDOT', count });
    }
  } else if (acronym === 'ICF' || acronym === 'NFTA') {
    const existing = combinedAcronyms.get('ICF/NFTA');
    if (existing) {
      existing.count += count;
    } else {
      combinedAcronyms.set('ICF/NFTA', { value: 'ICF/NFTA', label: 'ICF/NFTA', count });
    }
  } else {
    combinedAcronyms.set(acronym, { value: acronym, label: acronym, count });
  }
});

const deploymentAcronyms = Array.from(combinedAcronyms.values())
  .sort((a, b) => a.value.localeCompare(b.value));

// Extract unique phases with counts
const phaseCounts = sortedPublications.reduce((acc, pub) => {
  const phase = pub.data.phase;
  acc[phase] = (acc[phase] || 0) + 1;
  return acc;
}, {} as Record<number, number>);

const phases = Object.entries(phaseCounts)
  .map(([value, count]) => ({ value: parseInt(value), count }))
  .sort((a, b) => a.value - b.value);

const normalizeDeploymentAcronym = (acronym: string) => {
  if (acronym === 'ARC' || acronym === 'GDOT') return 'ARC/GDOT';
  if (acronym === 'ICF' || acronym === 'NFTA') return 'ICF/NFTA';
  return acronym;
};

const publicationFilters = sortedPublications.map((pub) => ({
  phase: pub.data.phase,
  acronym: normalizeDeploymentAcronym(pub.data.deploymentAcronym)
}));
---

<style>
  .documents-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (min-width: 992px) {
    .documents-container {
      flex-direction: row;
    }

    .documents-sidebar {
      flex-basis: 25%;
      min-width: 250px;
    }

    .documents-content {
      flex-basis: 75%;
    }
  }

  .documents-intro {
    margin-bottom: 2rem;
  }

  .publications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 768px) and (max-width: 991px) {
    .publications-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .publications-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .results-count {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: rgb(var(--color-brand-dark));
  }
</style>
<style is:global>
  .pagination-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .pagination-btn {
    border: 1px solid #d1d5db;
    background: #fff;
    color: #1f2937;
    padding: 0.4rem 0.75rem;
    border-radius: 0.4rem;
    font-size: 0.95rem;
    line-height: 1;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pagination-btn:hover:not(:disabled) {
    border-color: #055681;
    color: #055681;
  }

  .pagination-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pagination-btn.is-active {
    background: #055681;
    border-color: #055681;
    color: #fff;
    font-weight: 700;
  }
</style>

<PageLayout title="ITS4US Publications">
  <Fragment slot="banner">ITS4US</Fragment>
  
  <main>
    <h2 class="py-3">ITS4US Documentation</h2>
    
    <div class="documents-intro">
      <p>
        The ITS4US Program as part of its core tenets of replicability works to disseminate lessons learned and documentation from replicable solutions developed by deployment sites to catalyze additional deployment. As documentation for each Phase of the deployment process is finalized they are added to the ITS JPO Digital Library on National Transportation Library's <span class=" fst-italic"> Repository and Open Science Access Portal (ROSA P)</span>. 

      </p>
      <p>
        ROSA P serves as an archival repository of USDOT-published products including scientific findings, journal articles, guidelines, recommendations, or other information authored or co-authored by USDOT or funded partners. As a repository, ROSA P retains documents in their original published format to ensure public access to scientific information. These historical documents may not reflect the current Administration’s views or priorities.

      </p>
    </div>

    <div class="documents-container">
      <!-- Sidebar Filter -->
      <aside class="documents-sidebar">
        <PublicationsFilter 
          client:load
          deploymentAcronyms={deploymentAcronyms}
          phases={phases}
          publicationFilters={publicationFilters}
        />
      </aside>

      <!-- Publications Grid -->
      <div class="documents-content">
        <div class="results-count" id="results-count">
          Showing {sortedPublications.length} publications
        </div>
        
        <div class="publications-grid" id="publications-grid">
          {sortedPublications.map((pub) => (
            <PublicationCard publication={pub.data} />
          ))}
        </div>

        <nav class="pagination-controls" id="publications-pagination" aria-label="Publications pagination"></nav>
      </div>
    </div>
  </main>
</PageLayout>

<script>
  const ITEMS_PER_PAGE = 12;

  let currentPage = 1;
  let activePhaseFilter = '';
  let activeAcronymFilter = '';

  // Define linked acronym groups
  const linkedAcronyms: Record<string, string[]> = {
    'ARC/GDOT': ['ARC', 'GDOT'],
    'ICF/NFTA': ['ICF', 'NFTA']
  };

  const cards = Array.from(document.querySelectorAll('.publication-card')) as HTMLElement[];
  const resultsCount = document.getElementById('results-count');
  const paginationEl = document.getElementById('publications-pagination');

  const clampPage = (page: number, totalPages: number) => Math.max(1, Math.min(page, totalPages));

  const matchesFilter = (card: HTMLElement) => {
    if (activeAcronymFilter) {
      const cardAcronym = card.dataset.deploymentAcronym || '';
      if (linkedAcronyms[activeAcronymFilter]) {
        if (!linkedAcronyms[activeAcronymFilter].includes(cardAcronym)) {
          return false;
        }
      } else if (cardAcronym !== activeAcronymFilter) {
        return false;
      }
    }

    if (activePhaseFilter && card.dataset.phase !== activePhaseFilter) {
      return false;
    }

    return true;
  };

  const createPageButton = (label: string, page: number, isActive = false) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = `pagination-btn${isActive ? ' is-active' : ''}`;
    button.textContent = label;
    button.addEventListener('click', () => {
      currentPage = page;
      applyFiltersAndPagination(true);
    });
    return button;
  };

  const renderPagination = (totalPages: number) => {
    if (!paginationEl) return;

    paginationEl.innerHTML = '';

    if (totalPages <= 1) {
      paginationEl.setAttribute('hidden', 'true');
      return;
    }

    paginationEl.removeAttribute('hidden');

    const prevBtn = createPageButton('Previous', currentPage - 1);
    prevBtn.disabled = currentPage === 1;
    paginationEl.appendChild(prevBtn);

    const pagesToShow = new Set<number>([1, totalPages, currentPage - 1, currentPage, currentPage + 1]);
    const visiblePages = Array.from(pagesToShow)
      .filter((page) => page >= 1 && page <= totalPages)
      .sort((a, b) => a - b);

    let lastPage = 0;
    visiblePages.forEach((page) => {
      if (lastPage && page - lastPage > 1) {
        const dots = document.createElement('span');
        dots.textContent = '...';
        paginationEl.appendChild(dots);
      }
      paginationEl.appendChild(createPageButton(String(page), page, page === currentPage));
      lastPage = page;
    });

    const nextBtn = createPageButton('Next', currentPage + 1);
    nextBtn.disabled = currentPage === totalPages;
    paginationEl.appendChild(nextBtn);
  };

  const updateResultsText = (totalResults: number, startIndex: number, endIndex: number) => {
    if (!resultsCount) return;
    if (totalResults === 0) {
      resultsCount.textContent = 'No publications found';
      return;
    }
    resultsCount.textContent = `Showing ${startIndex}-${endIndex} of ${totalResults} publication${totalResults !== 1 ? 's' : ''}`;
  };

  const applyFiltersAndPagination = (preservePage = false) => {
    if (!cards.length) return;

    const filteredCards = cards.filter(matchesFilter);
    const totalResults = filteredCards.length;
    const totalPages = Math.max(1, Math.ceil(totalResults / ITEMS_PER_PAGE));

    currentPage = preservePage ? clampPage(currentPage, totalPages) : 1;

    const start = (currentPage - 1) * ITEMS_PER_PAGE;
    const end = start + ITEMS_PER_PAGE;

    cards.forEach((card) => card.classList.add('hidden'));
    filteredCards.forEach((card, index) => {
      const onCurrentPage = index >= start && index < end;
      card.classList.toggle('hidden', !onCurrentPage);
    });

    updateResultsText(totalResults, totalResults ? start + 1 : 0, Math.min(end, totalResults));
    renderPagination(totalPages);
  };

  // Filter publications and apply pagination
  window.addEventListener('publications-filter-change', (event) => {
    const { phase, acronym } = (event as CustomEvent).detail || {};
    activePhaseFilter = phase == null ? '' : String(phase);
    activeAcronymFilter = acronym == null ? '' : String(acronym);
    applyFiltersAndPagination(false);
  });

  applyFiltersAndPagination(false);
</script>
