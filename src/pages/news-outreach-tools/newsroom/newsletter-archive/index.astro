---
import PageLayout from "@/src/layouts/PageLayout.astro";
import banner from "@/src/assets/images/banners/NTL_Banner.png";
import NewsroomCard from "@/src/components/NewsroomCard.astro";
import base_url from "@/src/lib/base_url";
import type { NewsroomCardItem } from "@/src/types";
import { getCollection } from "astro:content";

type FilterableNewsletter = {
	card: NewsroomCardItem;
	year: string;
	topics: string[];
};

const keywords = [
	"ITS JPO",
	"newsletter archive",
	"ITS JPO Now",
	"newsletter",
	"news-outreach-tools",
];

const description =
	"Browse the ITS JPO newsletter archive and filter issues by year and topics.";

const rawNewsletters = (await getCollection("newsletters")).sort((a, b) =>
	b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const uniqueStrings = (values: Array<string | undefined | null>): string[] => {
	return [...new Set(values.filter((v): v is string => typeof v === "string" && v.trim().length > 0))];
};

const extractYear = (date: Date): string => String(date.getUTCFullYear());

const newsletterRows: FilterableNewsletter[] = rawNewsletters.map((item) => {
	const issueSummary = [item.data.season, item.data.volume, item.data.issue].filter(Boolean).join(" | ");
	const slug = item.id.replace(/\.(md|mdx)$/i, "");
	const cardSummary = [item.data.dateLabel, issueSummary].filter(Boolean).join(" | ");
	const descriptionText = item.data.description?.trim() ?? "";
	const cardDescription = descriptionText.length > 0 ? descriptionText : cardSummary;

	return {
		card: {
			title: item.data.title,
			url: base_url(`/news-outreach-tools/newsroom/newsletter-archive/${slug}/`),
			description: cardDescription,
			date: item.data.dateLabel,
			subtitle: cardSummary || item.data.subtitle,
			topics: item.data.topics,
			imageUrl: item.data.imageUrl,
		},
		year: extractYear(item.data.publishDate),
		topics: item.data.topics ?? [],
	};
});

const years = uniqueStrings(newsletterRows.map((row) => row.year)).sort((a, b) => b.localeCompare(a));
const topics = uniqueStrings(newsletterRows.flatMap((row) => row.topics ?? []));
const topicDisplayLabels: Record<string, string> = {
	ITS4US: "ITS4US",
	ITSPAC: "Intelligent Transportation Systems Program Advisory Committee (ITSPAC)",
	SCRC: "Smart Community Resource Center (SCRC)",
	V2X: "Vehicle-to-Everything (V2X)",
};
const topicOptions = topics
	.map((topic) => ({ value: topic, label: topicDisplayLabels[topic] ?? topic }))
	.sort((a, b) => a.label.localeCompare(b.label));
---

<PageLayout title="Newsletter Archive" bannerImage={banner} keywords={keywords} description={description}>
	<Fragment slot="banner">Newsroom</Fragment>
	<main>
		<h2 class="sideways">ITS JPO Now Archive</h2>
		<p>
			Browse past editions of <i>ITS JPO Now</i>. Use the filters below to narrow by year,
			and topics.
		</p>

		<form class="row g-4 reduced-gutters filter mt-1 mb-3 py-3  px-3 pt-0" aria-label="Newsletter archive filters">
			<div class="col-12 col-lg-3">
				<label class="form-label" for="year-toggle">Year</label>
				<div class="multi-select-dropdown" id="archive-year-dropdown">
					<button id="year-toggle" type="button" class="w-100 text-start" aria-controls="year-list" aria-expanded="false">
						<span class="dropdown-label">Select years</span>
					</button>
					<div class="w-100" aria-label="Year options" role="group" id="year-list">
						{
							years.map((year) => {
								const id = `year-${year}`;
								return (
									<label class="year-option" for={id}>
										<input class="year-input" type="checkbox" id={id} name="year" value={year} />
										<span class="year-label">{year}</span>
									</label>
								);
							})
						}
					</div>
				</div>
				<div class="form-text">Check items to select multiple years.</div>
			</div>

			<fieldset class="col-12 col-lg-9">
				<legend class="col-form-label pt-0">Topics</legend>
				{
					topics.length > 0 ? (
						<div class="multi-select-dropdown" id="archive-topic-dropdown">
							<button id="topic-toggle" type="button" class="w-100 text-start" aria-controls="topic-list" aria-expanded="false">
								<span class="dropdown-label">Select topics</span>
							</button>
							<div class="w-100" aria-label="Topic options" role="group" id="topic-list">
								{
									topicOptions.map(({ value: topic, label }) => {
										const topicId = `topic-${topic.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
										return (
											<label class="topic-option" for={topicId}>
												<input class="topic-input" type="checkbox" id={topicId} name="topic" value={topic} />
												<span class="topic-option-label">{label}</span>
											</label>
										);
									})
								}
							</div>
						</div>
					) : (
						<div class="form-text">No topic tags are available for these issues yet.</div>
					)
				}
			</fieldset>
		</form>

		<div id="newsletter-cards" class="row gx-4 gy-4 newsletter-gradient">
			{
				newsletterRows.map((row, index) => (
					<div class="col-12 col-md-4 d-flex newsletter-card-col">
						<NewsroomCard item={row.card} class="w-100" showPills={true} showSubtitle={true} showColoredLabel={false} showImage={true} showNewBadge={index === 0} ctaText="Read Issue" />
					</div>
				))
			}
		</div>
	</main>
</PageLayout>

<script define:vars={{ newsletterRows, topicDisplayLabels }}>
	const yearToggle = document.getElementById("year-toggle");
	const yearMenu = document.getElementById("year-list");
	const topicToggle = document.getElementById("topic-toggle");
	const topicMenu = document.getElementById("topic-list");

	const updateYearLabel = () => {
		const selected = Array.from(document.querySelectorAll('input[name="year"]:checked'))
			.filter((el) => el instanceof HTMLInputElement)
			.map((cb) => cb.value);
		const labelEl = document.querySelector("#year-toggle .dropdown-label");
		if (!labelEl) return;
		labelEl.textContent = selected.length === 0 ? "Select years" : selected.join(", ");
	};

	const getSelectedValues = (name) =>
		Array.from(document.querySelectorAll(`input[name="${name}"]:checked`))
			.filter((el) => el instanceof HTMLInputElement)
			.map((cb) => cb.value);

	const updateTopicLabel = () => {
		const selected = getSelectedValues("topic").map((topic) => topicDisplayLabels[topic] ?? topic);
		const labelEl = document.querySelector("#topic-toggle .dropdown-label");
		if (!labelEl) return;
		labelEl.textContent = selected.length === 0 ? "Select topics" : selected.join(", ");
	};

	const getFilteredMatches = (selectedYears, selectedTopics) => {
		return newsletterRows.map((row) => {
			const hasYear = selectedYears.length === 0 || selectedYears.includes(row.year);
			const hasTopic = selectedTopics.length === 0 || (row.topics ?? []).some((topic) => selectedTopics.includes(topic));
			return hasYear && hasTopic;
		});
	};

	const applyToDOM = (matches) => {
		const cols = document.querySelectorAll("#newsletter-cards .newsletter-card-col");
		cols.forEach((col, index) => {
			col.style.setProperty("display", matches[index] ? "" : "none", "important");
		});
	};

	const runFilter = () => {
		const selectedYears = getSelectedValues("year");
		const selectedTopics = getSelectedValues("topic");
		applyToDOM(getFilteredMatches(selectedYears, selectedTopics));
		updateYearLabel();
		updateTopicLabel();
	};

	const toggleYearDropdown = (show) => {
		const expanded = typeof show === "boolean" ? show : !(yearToggle?.getAttribute("aria-expanded") === "true");
		yearToggle?.setAttribute("aria-expanded", expanded ? "true" : "false");
		if (yearMenu) {
			if (expanded) yearMenu.classList.add("show");
			else yearMenu.classList.remove("show");
		}
	};

	const toggleTopicDropdown = (show) => {
		const expanded = typeof show === "boolean" ? show : !(topicToggle?.getAttribute("aria-expanded") === "true");
		topicToggle?.setAttribute("aria-expanded", expanded ? "true" : "false");
		if (topicMenu) {
			if (expanded) topicMenu.classList.add("show");
			else topicMenu.classList.remove("show");
		}
	};

	yearToggle?.addEventListener("click", (e) => {
		e.stopPropagation();
		toggleYearDropdown();
	});

	topicToggle?.addEventListener("click", (e) => {
		e.stopPropagation();
		toggleTopicDropdown();
	});

	document.addEventListener("click", (e) => {
		const target = e.target;
		if (!yearMenu?.contains(target) && !yearToggle?.contains(target)) {
			toggleYearDropdown(false);
		}
		if (!topicMenu?.contains(target) && !topicToggle?.contains(target)) {
			toggleTopicDropdown(false);
		}
	});

	document.getElementById("archive-year-dropdown")?.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			e.preventDefault();
			e.stopPropagation();
			toggleYearDropdown(false);
			yearToggle?.focus();
		}
	});

	document.getElementById("archive-topic-dropdown")?.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			e.preventDefault();
			e.stopPropagation();
			toggleTopicDropdown(false);
			topicToggle?.focus();
		}
	});

	["year", "topic"].forEach((name) => {
		document.querySelectorAll(`input[name="${name}"]`).forEach((el) => {
			el.addEventListener("change", runFilter);
		});
	});

	updateYearLabel();
	runFilter();
</script>

<style is:global>
	.reduced-gutters {
		--bs-gutter-x: 14px;
	}
	.btn{
		border-radius: 0.5rem;
	}

	.filter {
		background-color: var(--bs-light);
		border: 1px solid var(--bs-border-color);
		border-radius: 12px;
	}

	#archive-year-dropdown {
		position: relative;
		min-width: 0;
		--filter-color: rgb(5, 86, 129);
		--filter-border: #b6b7bb;
	}

	#year-toggle {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		min-height: 2.5rem;
		border: 1px solid var(--filter-border);
		border-radius: 1.25rem;
		padding: 0.45rem 0.75rem;
		font: inherit;
		font-weight: 600;
		color: #111827;
		background: #fff;
		cursor: pointer;
		transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
	}

	#year-toggle:hover,
	#year-toggle:focus,
	#year-toggle[aria-expanded="true"] {
		border-color: var(--filter-color);
	}

	#year-toggle:focus,
	#year-toggle[aria-expanded="true"] {
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--filter-color) 18%, transparent);
	}

	#archive-year-dropdown :focus-visible {
		outline: 2px solid var(--filter-color);
		outline-offset: 2px;
	}

	#year-toggle .dropdown-label {
		flex: 1;
		min-width: 0;
		overflow-wrap: anywhere;
		white-space: normal;
	}

	#year-toggle::after {
		content: '\f078';
		flex-shrink: 0;
		width: 1.25rem;
		margin: 0;
		border: 0;
		color: #666;
		font-family: "Font Awesome 6 Free";
		font-weight: 900;
		font-size: 1rem;
		text-align: center;
		transition: transform 0.2s ease;
	}

	#year-toggle[aria-expanded="true"]::after {
		transform: rotate(180deg);
	}

	#year-list {
		display: none;
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 0;
		z-index: 50;
		min-width: 0;
		max-height: 18rem;
		overflow-y: auto;
		margin: 0;
		padding: 0;
		border: 1px solid var(--filter-border);
		border-radius: 0.375rem;
		background: #fff;
		box-shadow: 0 10px 24px rgb(0 0 0 / 12%);
	}

	#year-list.show {
		display: block;
	}

	#year-list .year-option {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		padding: 0.6rem 0.75rem;
		font: inherit;
		font-size: 0.95rem;
		color: #1f2937;
		cursor: pointer;
		overflow-wrap: anywhere;
		transition: background-color 0.15s ease;
	}

	#year-list .year-option + .year-option {
		border-top: 1px solid #f3f4f6;
	}

	#year-list .year-option:hover,
	#year-list .year-option:focus-within {
		background: #f9fafb;
	}

	#year-list input {
		margin: 0;
		accent-color: var(--filter-color);
		cursor: pointer;
	}

	#archive-topic-dropdown {
		position: relative;
		min-width: 0;
		--filter-color: rgb(5, 86, 129);
		--filter-border: #b6b7bb;
	}

	#topic-toggle {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		min-height: 2.5rem;
		border: 1px solid var(--filter-border);
		border-radius: 1.25rem;
		padding: 0.45rem 0.75rem;
		font: inherit;
		font-weight: 600;
		color: #111827;
		background: #fff;
		cursor: pointer;
		transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
	}

	#topic-toggle:hover,
	#topic-toggle:focus,
	#topic-toggle[aria-expanded="true"] {
		border-color: var(--filter-color);
	}

	#topic-toggle:focus,
	#topic-toggle[aria-expanded="true"] {
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--filter-color) 18%, transparent);
	}

	#archive-topic-dropdown :focus-visible {
		outline: 2px solid var(--filter-color);
		outline-offset: 2px;
	}

	#topic-toggle .dropdown-label {
		flex: 1;
		min-width: 0;
		overflow-wrap: anywhere;
		white-space: normal;
	}

	#topic-toggle::after {
		content: '\f078';
		flex-shrink: 0;
		width: 1.25rem;
		margin: 0;
		border: 0;
		color: #666;
		font-family: "Font Awesome 6 Free";
		font-weight: 900;
		font-size: 1rem;
		text-align: center;
		transition: transform 0.2s ease;
	}

	#topic-toggle[aria-expanded="true"]::after {
		transform: rotate(180deg);
	}

	#topic-list {
		display: none;
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 0;
		z-index: 50;
		min-width: 0;
		max-height: 18rem;
		overflow-y: auto;
		margin: 0;
		padding: 0;
		border: 1px solid var(--filter-border);
		border-radius: 0.375rem;
		background: #fff;
		box-shadow: 0 10px 24px rgb(0 0 0 / 12%);
	}

	#topic-list.show {
		display: block;
	}

	#topic-list .topic-option {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		padding: 0.6rem 0.75rem;
		font: inherit;
		font-size: 0.95rem;
		color: #1f2937;
		cursor: pointer;
		overflow-wrap: anywhere;
		transition: background-color 0.15s ease;
	}

	#topic-list .topic-option + .topic-option {
		border-top: 1px solid #f3f4f6;
	}

	#topic-list .topic-option:hover,
	#topic-list .topic-option:focus-within {
		background: #f9fafb;
	}

	#topic-list input {
		margin: 0;
		accent-color: var(--filter-color);
		cursor: pointer;
	}
</style>

