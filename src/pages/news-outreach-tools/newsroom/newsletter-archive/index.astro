---
import PageLayout from "@/src/layouts/PageLayout.astro";
import banner from "@/src/assets/images/banners/NTL_Banner.png";
import NewsroomCard from "@/src/components/NewsroomCard.astro";
import base_url from "@/src/lib/base_url";
import type { NewsroomCardItem } from "@/src/types";
import { getCollection } from "astro:content";

type FilterableNewsletter = {
	card: NewsroomCardItem;
	year: string;
	topics: string[];
};

const keywords = [
	"ITS JPO",
	"newsletter archive",
	"ITS JPO Now",
	"newsletter",
	"news-outreach-tools",
];

const description =
	"Browse the ITS JPO newsletter archive and filter issues by year and topics.";

const rawNewsletters = (await getCollection("newsletters")).sort((a, b) =>
	b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const uniqueStrings = (values: Array<string | undefined | null>): string[] => {
	return [...new Set(values.filter((v): v is string => typeof v === "string" && v.trim().length > 0))];
};

const extractYear = (date: Date): string => String(date.getUTCFullYear());

const newsletterRows: FilterableNewsletter[] = rawNewsletters.map((item) => {
	const issueSummary = [item.data.season, item.data.volume, item.data.issue].filter(Boolean).join(" | ");
	const slug = item.id.replace(/\.(md|mdx)$/i, "");
	const cardSummary = [item.data.dateLabel, issueSummary].filter(Boolean).join(" | ");
	const descriptionText = item.data.description?.trim() ?? "";
	const cardDescription = descriptionText.length > 0 ? descriptionText : cardSummary;

	return {
		card: {
			title: item.data.title,
			url: base_url(`/news-outreach-tools/newsroom/newsletter-archive/${slug}/`),
			description: cardDescription,
			date: item.data.dateLabel,
			subtitle: cardSummary || item.data.subtitle,
			topics: item.data.topics,
			imageUrl: item.data.imageUrl,
		},
		year: extractYear(item.data.publishDate),
		topics: item.data.topics ?? [],
	};
});

const years = uniqueStrings(newsletterRows.map((row) => row.year)).sort((a, b) => b.localeCompare(a));
const topics = uniqueStrings(newsletterRows.flatMap((row) => row.topics ?? []));
---

<PageLayout title="Newsletter Archive" bannerImage={banner} keywords={keywords} description={description}>
	<Fragment slot="banner">Newsroom</Fragment>
	<main>
		<h2 class="sideways blue">ITS JPO Newsletter Archive</h2>
		<p>
			Browse past editions of <i>ITS JPO Now</i>. Use the filters below to narrow by year,
			and topics.
		</p>

		<form class="row g-4 reduced-gutters filter mt-1 mb-3 py-3  px-3 pt-0" aria-label="Newsletter archive filters">
			<div class="col-12 col-lg-3">
				<label class="form-label" for="year-toggle">Year</label>
				<div class="dropdown multi-select-dropdown">
					<button id="year-toggle" type="button" class="dropdown-toggle w-100 text-start" aria-haspopup="listbox" aria-expanded="false">
						<span class="dropdown-label">Select years</span>
					</button>
					<div class="dropdown-menu w-100 p-2" aria-labelledby="year-toggle" role="listbox" id="year-list" style="max-height: 240px; overflow:auto;">
						{
							years.map((year) => {
								const id = `year-${year}`;
								return (
									<div class="year-option">
										<input class="visually-hidden year-input" type="checkbox" id={id} name="year" value={year} />
										<label class="year-label" for={id}>
											{year}
										</label>
									</div>
								);
							})
						}
					</div>
				</div>
				<div class="form-text">Check items to select multiple years.</div>
			</div>

			<fieldset class="col-12 col-lg-9">
				<legend class="col-form-label pt-0">Topics</legend>
				{
					topics.length > 0 ? (
						<div class="topic-pills">
							{
								topics.map((topic) => {
									const topicId = `topic-${topic.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
									return (
										<div class="topic-pill-option">
											<input class="visually-hidden topic-input" type="checkbox" id={topicId} name="topic" value={topic} />
											<label class="topic-pill" for={topicId}>
												{topic}
											</label>
										</div>
									);
								})
							}
						</div>
					) : (
						<div class="form-text">No topic tags are available for these issues yet.</div>
					)
				}
			</fieldset>
		</form>

		<div id="newsletter-cards" class="row gx-4 gy-4 newsletter-gradient">
			{
				newsletterRows.map((row) => (
					<div class="col-12 col-md-4 d-flex newsletter-card-col" data-year={row.year} data-topics={row.topics.join("|")}>
						<NewsroomCard item={row.card} class="w-100" showPills={true} showSubtitle={true} showColoredLabel={false} showImage={true} ctaText="Read Issue" />
					</div>
				))
			}
		</div>
		<p id="newsletter-empty-state" class="form-text d-none" role="status">No newsletters match the selected filters.</p>
	</main>
</PageLayout>

<script>
	const yearToggle = document.getElementById("year-toggle");
	const yearMenu = document.getElementById("year-list");
	const cardColumns = Array.from(document.querySelectorAll<HTMLElement>("#newsletter-cards .newsletter-card-col"));
	const emptyState = document.getElementById("newsletter-empty-state");

	const updateYearLabel = () => {
		const selected = Array.from(document.querySelectorAll('input[name="year"]:checked'))
			.filter((el) => el instanceof HTMLInputElement)
			.map((cb) => cb.value);
		const labelEl = document.querySelector("#year-toggle .dropdown-label");
		if (!labelEl) return;
		labelEl.textContent = selected.length === 0 ? "Select years" : selected.join(", ");
	};

	const getSelectedValues = (name: string): string[] =>
		Array.from(document.querySelectorAll(`input[name="${name}"]:checked`))
			.filter((el) => el instanceof HTMLInputElement)
			.map((cb) => cb.value);

	const getFilteredMatches = (selectedYears: string[], selectedTopics: string[]): boolean[] => {
		return cardColumns.map((cardColumn) => {
			const year = cardColumn.dataset.year ?? "";
			const topics = (cardColumn.dataset.topics ?? "").split("|").filter(Boolean);
			const hasYear = selectedYears.length === 0 || selectedYears.includes(year);
			const hasTopic = selectedTopics.length === 0 || topics.some((topic) => selectedTopics.includes(topic));
			return hasYear && hasTopic;
		});
	};

	const applyToDOM = (matches: boolean[]) => {
		cardColumns.forEach((col, index) => {
			col.style.display = matches[index] ? "" : "none";
		});
		emptyState?.classList.toggle("d-none", matches.some(Boolean));
	};

	const runFilter = () => {
		const selectedYears = getSelectedValues("year");
		const selectedTopics = getSelectedValues("topic");
		applyToDOM(getFilteredMatches(selectedYears, selectedTopics));
		updateYearLabel();
	};

	const toggleYearDropdown = (show?: boolean) => {
		const expanded = typeof show === "boolean" ? show : !(yearToggle?.getAttribute("aria-expanded") === "true");
		yearToggle?.setAttribute("aria-expanded", expanded ? "true" : "false");
		if (yearMenu) {
			if (expanded) yearMenu.classList.add("show");
			else yearMenu.classList.remove("show");
		}
	};

	yearToggle?.addEventListener("click", (e) => {
		e.stopPropagation();
		toggleYearDropdown();
	});

	document.addEventListener("click", (e) => {
		const target = e.target;
		if (!(target instanceof Node) || (!yearMenu?.contains(target) && !yearToggle?.contains(target))) {
			toggleYearDropdown(false);
		}
	});

	yearToggle?.addEventListener("keydown", (e) => {
		if (e.key === "Escape") {
			toggleYearDropdown(false);
			yearToggle.focus();
		}
	});

	["year", "topic"].forEach((name) => {
		document.querySelectorAll(`input[name="${name}"]`).forEach((el) => {
			el.addEventListener("change", runFilter);
		});
	});

	updateYearLabel();
	runFilter();
</script>

<style is:global>
	.reduced-gutters {
		--bs-gutter-x: 14px;
	}

	.filter {
		background-color: var(--bs-light);
		border: 1px solid var(--bs-border-color);
		border-radius: 12px;
	}

	.topic-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.topic-pill {
		display: inline-flex;
		align-items: center;
		border: 1px solid grey;
		border-radius: 999px;
		padding: 0.35rem 0.75rem;
		line-height: 1.2;
		cursor: pointer;
		user-select: none;
		background-color: white;
		color: black;
	}

	.topic-pill-option > input:checked + .topic-pill {
		background-color: #055581;
		border-color: #055581;
		color: white;
	}

	.topic-pill-option > input:focus-visible + .topic-pill {
		outline: 0;
		box-shadow: 0 0 0 0.25rem rgba(var(--bs-primary-rgb), 0.25);
	}

	.year-option {
		display: flex;
	}

	.year-label {
		width: 100%;
		padding: 0.375rem 0.5rem;
		border-radius: 0.25rem;
		cursor: pointer;
		user-select: none;
	}

	.year-option > input:checked + .year-label {
		color: #055581;
		font-weight: 600;
		background-color: var(--bs-primary-bg-subtle);
	}

	.year-option > input:focus-visible + .year-label {
		outline: 0;
		box-shadow: 0 0 0 0.25rem rgba(var(--bs-primary-rgb), 0.25);
	}

	#year-toggle.dropdown-toggle {
		display: flex;
		background-color: #fff;
		border: 1px solid #ced4da;
		border-radius: 0.25rem;
		align-items: center;
		justify-content: space-between;
	}

	#year-toggle.dropdown-toggle:focus {
		box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
	}

	.multi-select-dropdown .dropdown-menu {
		display: none;
	}

	.multi-select-dropdown .dropdown-menu.show {
		display: block;
	}

	.multi-select-dropdown .dropdown-label {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		display: inline-block;
		max-width: 100%;
	}

	#year-toggle.dropdown-toggle:after {
		content: '\f078';
		font-family: "Font Awesome 6 Free";
		font-weight: 800;
		font-size: 16px;
	}
</style>

