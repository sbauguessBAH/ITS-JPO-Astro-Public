---
import PageLayout from "@/src/layouts/PageLayout.astro";
import banner from "@/src/assets/images/banners/NTL_Banner.png";
import base_url from "@/src/lib/base_url";
import toolkits from "@/src/content/news-resources/toolkits/toolkits.json";
import { getCollection } from "astro:content";

type MediaToolkitEntry = {
  title?: string;
  url?: string;
  description?: string;
  date?: string;
  subtitle?: string;
  content_types?: string[];
  topics?: string[];
  location?: string;
};

type HighlightLink = {
  title: string;
  url: string;
};

const keywords = ["ITS JPO", "newsroom", "deployments", "conferences", "exhibits", "newsworthy stories", "ITS JPO Now", "publications"];
const description =
  "The ITS JPO Newsroom section contains a variety of information and resources about various deployments, conferences & exhibits, and other newsworthy stories. The ITS JPO Newsroom also archives previous editions of the ITS JPO Now publication. Check back often as this page is regularly updated with new information.";

const newsletterEntries = (await getCollection("newsletters")).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const toHref = (value?: string): string => {
  if (!value) {
    return "#";
  }

  return value.startsWith("/") ? base_url(value) : value;
};

const toNewsletterLink = (entry: (typeof newsletterEntries)[number]): HighlightLink => {
  const slug = entry.id.replace(/\.(md|mdx)$/i, "");

  return {
    title: entry.data.title,
    url: base_url(`/news-outreach-tools/newsroom/newsletter-archive/${slug}/`),
  };
};

const featuredNewsletter: HighlightLink | undefined = newsletterEntries[0] ? toNewsletterLink(newsletterEntries[0]) : undefined;

const toolkitData = toolkits as { outreach_toolkits?: MediaToolkitEntry[]; media_toolkits?: MediaToolkitEntry[] };

const mediaKitHighlights: HighlightLink[] = (Array.isArray(toolkitData.media_toolkits) ? toolkitData.media_toolkits : [])
  .map((item) => ({
    title: item.title?.trim() ?? "",
    url: toHref(item.url),
  }))
  .filter((item) => item.title.length > 0)
  .slice(0, 3);

const outreachHighlights: HighlightLink[] = (Array.isArray(toolkitData.outreach_toolkits) ? toolkitData.outreach_toolkits : [])
  .map((item) => ({
    title: item.title?.trim() ?? "",
    url: toHref(item.url),
  }))
  .filter((item) => item.title.length > 0)
  .slice(0, 3);
---

<PageLayout title="Newsroom" bannerImage={banner} keywords={keywords} description={description}>
  <Fragment slot="banner">Newsroom</Fragment>
  <main>
    <div class="row gx-4 gy-4">
      <div>
        <h2>ITS JPO Newsroom</h2>
        <p class="mt-3">
          The ITS JPO Newsroom section contains a variety of information and resources about various deployments, conferences & exhibits, and other newsworthy stories. The ITS JPO Newsroom also
          archives previous editions of the <i>ITS JPO Now</i> publication. Check back often as this page is regularly updated with new information.
        </p>
      </div>
    </div>
    <section class="newsroom-cta-grid mt-2 " aria-label="Newsroom call to action sections">
      <div class="container-xl">
      <div class="row gx-4 gy-4 align-items-stretch">
        <div class="col-12 col-lg-4 d-flex">
          <article class="cta-panel w-100">
            <h2 class="cta-heading">
              <span class="cta-heading-icon" aria-hidden="true">
                <i class="fa-solid fa-newspaper"></i>
              </span>
              <span>ITS JPO NOW</span>
            </h2>
            <p>
              Explore the ITS JPO NOW newsletter to stay current on program milestones, events, and featured transportation technology stories.
            </p>
            <ul class="cta-link-list">
              {featuredNewsletter && (
                <li>
                  <a href={featuredNewsletter.url}>Read Most Recent Issue</a>
                </li>
              )}
            </ul>
            <a class="btn btn-primary mt-auto align-self-start" href={base_url("/news-outreach-tools/newsroom/newsletter-archive/")}>Browse Full Archive</a>
          </article>
        </div>

        <div class="col-12 col-lg-4 d-flex">
          <article class="cta-panel w-100">
            <h2 class="cta-heading">
              <span class="cta-heading-icon" aria-hidden="true">
                <i class="fa-solid fa-photo-film"></i>
              </span>
              <span>Media Kits</span>
            </h2>
            <p>
              Access curated media kit highlights with ready-to-share resources that support communications around key ITS JPO initiatives.
            </p>
            <ul class="cta-link-list">
              {
                mediaKitHighlights.map((item) => (
                  <li>
                    <a href={item.url}>{item.title}</a>
                  </li>
                ))
              }
            </ul>
            <a class="btn btn-primary mt-auto align-self-start" href="#">View All Media Kits</a>
          </article>
        </div>

        <div class="col-12 col-lg-4 d-flex">
          <article class="cta-panel w-100">
            <h2 class="cta-heading">
              <span class="cta-heading-icon" aria-hidden="true">
                <i class="fa-solid fa-bullhorn"></i>
              </span>
              <span>Outreach Resources</span>
            </h2>
            <p>
              Find outreach resource highlights that help partners and stakeholders communicate ITS benefits through practical, audience-ready materials.
            </p>
            <ul class="cta-link-list">
              {
                outreachHighlights.map((item) => (
                  <li>
                    <a href={item.url}>{item.title}</a>
                  </li>
                ))
              }
            </ul>
            <a class="btn btn-primary mt-auto align-self-start" href={base_url("/news-outreach-tools/newsroom/outreach-resources/")}>View Outreach Resources</a>
          </article>
        </div>
      </div>
      </div>
    </section>
  </main>
</PageLayout>

<style>
  .heading-border-left.blue {
    padding: 0 0 0 0.6rem;
    line-height: 1.5rem;
    font-size: 1.75rem;
    border-left: 5px solid;
    border-color: #055581;
    border-bottom: none;
  }

  .newsroom-cta-grid {
    position: relative;
    left: 50%;
    right: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: #f7f7f7;
    padding: 2rem 0;
  }

  .newsroom-cta-grid .row {
    margin: 0 auto;
  }

  .cta-panel {
    background: #fff;
    border: 1px solid #dce3e8;
    border-radius: 0.5rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .cta-heading {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: #055581;
    font-size: 1.45rem;
  }

  .cta-heading-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: #055581;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 0.85rem;
  }

  .cta-heading-icon i {
    color: #fff;
    line-height: 1;
  }

  .cta-panel p {
    margin: 0;
  }

  .cta-link-list {
    margin: 0;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .cta-link-list a {
    text-decoration: underline;
    text-underline-offset: 0.15rem;
  }

  @media (max-width: 991.98px) {
    .newsroom-cta-grid {
      padding: 1.5rem 0;
    }
  }
</style>
