---
import PageLayout from "@/src/layouts/PageLayout.astro";
import banner from "@/src/assets/images/banners/NTL_Banner.png";
import archiveData from "@/src/content/news-resources/inthenews/in-the-news-archive.json";
import InTheNewsFilters from "@/src/components/newsroom/InTheNewsFilters.vue";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type NewsTags = {
  "technology-areas"?: string[];
  topics?: string[];
};

type ArchiveArticle = {
  title?: string;
  date?: string;
  news_src?: string;
  location?: string;
  desc?: string;
  url?: string;
  news_src_url?: string;
  image?: string;
  alt_image?: string;
  tags?: NewsTags;
};

type RenderArticle = ArchiveArticle & {
  thumbnail?: ImageMetadata;
};

type ArticleFilterData = {
  title: string;
  desc: string;
  tags: string[];
};

const thumbnailModules = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/newsroom/postThumbnails/*", {
  eager: true,
});

const thumbnails: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(thumbnailModules).map(([path, module]) => [path, module.default]),
);

const keywords = ["ITS JPO", "newsroom", "in the news", "transportation innovation", "archive"];
const description = "Browse in-the-news transportation articles with source information, tags, and pagination.";

const parseArchiveDate = (value?: string): number => {
  if (!value) {
    return 0;
  }

  const [monthPart, dayPart, yearPart] = value.split("/");
  const month = Number(monthPart);
  const day = Number(dayPart);
  const year = Number(yearPart);

  if (!month || !day || !year) {
    return 0;
  }

  return new Date(year, month - 1, day).getTime();
};

const resolveThumbnail = (imagePath?: string): ImageMetadata | undefined => {
  const fileName = imagePath?.split("/").pop();

  if (!fileName) {
    return undefined;
  }

  return thumbnails[`/src/assets/images/newsroom/postThumbnails/${fileName}`];
};

const normalizeTagValues = (values?: string[]): string[] => {
  if (!Array.isArray(values)) {
    return [];
  }

  return values
    .map((value) => value?.trim())
    .filter((value): value is string => Boolean(value));
};

const collectAllTags = (tags?: NewsTags): string[] => {
  if (!tags) {
    return [];
  }

  return Object.keys(tags).flatMap((tagGroup) => normalizeTagValues(tags[tagGroup as keyof NewsTags]));
};

const tagGroups: Array<{ key: keyof NewsTags; label: string }> = [
  { key: "technology-areas", label: "Technology Areas" },
  { key: "topics", label: "Topics" },
];

const archiveArticles = (Array.isArray(archiveData) ? archiveData : []) as ArchiveArticle[];

const articles: RenderArticle[] = archiveArticles
  .slice()
  .sort((a, b) => parseArchiveDate(b.date) - parseArchiveDate(a.date))
  .map((article) => ({
    ...article,
    thumbnail: resolveThumbnail(article.image),
  }));

const technologyAreasList = Array.from(
  new Set(archiveArticles.flatMap((article) => normalizeTagValues(article.tags?.["technology-areas"]))),
).sort((a, b) => a.localeCompare(b));

const articleFilterData: ArticleFilterData[] = articles.map((article) => ({
  title: (article.title ?? "").toLowerCase(),
  desc: (article.desc ?? "").toLowerCase(),
  tags: collectAllTags(article.tags),
}));

const pageSize = 10;
---

<PageLayout title="In the News" bannerImage={banner} keywords={keywords} description={description} currentBreadcrumb="In the News">
  <Fragment slot="banner">Newsroom</Fragment>
  <main>
    <h2>In the News</h2>
    <p class="mt-2">
      Explore news coverage and announcements related to ITS innovation deployments, pilots, and transportation safety efforts.
    </p>

    <InTheNewsFilters client:load technologyAreasList={technologyAreasList} />

    <section id="news-article-list" class="news-article-list" aria-label="In the News archive">
      {
        articles.map((article) => {
          const title = article.title?.trim() ?? "Untitled Article";
          const source = article.news_src?.trim() || "Source";
          const location = article.location?.trim();
          const date = article.date?.trim();

          return (
            <article class="news-article">
              <div class="news-article-media">
                {
                  article.thumbnail ? (
                    <a href={article.thumbnail.src} target="_blank" rel="noopener noreferrer" aria-label={`Open image for ${title}`}>
                      <Image src={article.thumbnail} alt={article.alt_image?.trim() || `${title} thumbnail`} class="news-article-image" loading="lazy" />
                    </a>
                  ) : (
                    <div class="news-article-placeholder" aria-hidden="true">Image unavailable</div>
                  )
                }
              </div>

              <div class="news-article-content">
                <h3 class="news-article-title">
                  {article.url ? <a href={article.url}>{title}</a> : <span>{title}</span>}
                </h3>

                {article.desc && <p class="news-article-desc">{article.desc}</p>}

                <p class="news-article-meta">
                  {article.news_src_url ? <a class="news-article-source" href={article.news_src_url}>{source}</a> : <span class="news-article-source">{source}</span>}
                  {location && <span class="news-article-location">{location}</span>}
                  {date && <span class="news-article-date">{date}</span>}
                </p>

                <div class="news-article-tags" aria-label="Article tags">
                  {
                    tagGroups.map(({ key, label }) => {
                      const values = article.tags?.[key] ?? [];

                      if (!values.length) {
                        return null;
                      }

                      return (
                        values.map((value) => (
                          <span class={`news-article-tag ${key}`} aria-label={`${label}: ${value}`}>
                            {value}
                          </span>
                        ))
                      );
                    })
                  }
                </div>
              </div>
            </article>
          );
        })
      }
    </section>

    <p id="news-empty-state" class="news-empty-state" hidden>No articles are available.</p>

    <nav id="news-pagination" class="news-pagination" aria-label="In the News pagination" hidden>
      <button id="news-pagination-prev" type="button" class="news-pagination-button">Previous</button>
      <div id="news-pagination-pages" class="news-pagination-pages"></div>
      <button id="news-pagination-next" type="button" class="news-pagination-button">Next</button>
    </nav>
  </main>
</PageLayout>

<script define:vars={{ pageSize, articleFilterData }}>
  const articleRows = Array.from(document.querySelectorAll(".news-article")).filter((el) => el instanceof HTMLElement);
  const paginationNav = document.getElementById("news-pagination");
  const paginationPrev = document.getElementById("news-pagination-prev");
  const paginationNext = document.getElementById("news-pagination-next");
  const paginationPages = document.getElementById("news-pagination-pages");
  const emptyState = document.getElementById("news-empty-state");

  let currentPage = 1;
  let filteredIndexes = articleRows.map((_, index) => index);
  let activeFilters = {
    technologyAreas: [],
    searchQuery: "",
  };

  const normalizeStringArray = (value) => {
    if (!Array.isArray(value)) {
      return [];
    }

    return value
      .map((item) => (typeof item === "string" ? item.trim() : ""))
      .filter((item) => Boolean(item));
  };

  const articleHasTags = (article, selectedTags) => {
    if (selectedTags.length === 0) {
      return true;
    }

    return article.tags.some((tag) => selectedTags.includes(tag));
  };

  const updateFilteredIndexes = () => {
    const selectedTechnologyAreas = activeFilters.technologyAreas;
    const searchValue = activeFilters.searchQuery.trim().toLowerCase();

    filteredIndexes = articleFilterData
      .map((article, index) => ({ article, index }))
      .filter(({ article }) => articleHasTags(article, selectedTechnologyAreas))
      .filter(({ article }) => {
        if (!searchValue) {
          return true;
        }

        return article.title.includes(searchValue) || article.desc.includes(searchValue);
      })
      .map(({ index }) => index);
  };

  const pageCount = () => Math.ceil(filteredIndexes.length / pageSize);

  const renderPagination = () => {
    const totalPages = pageCount();

    if (paginationNav instanceof HTMLElement) {
      paginationNav.hidden = totalPages <= 1;
    }

    if (!(paginationPages instanceof HTMLElement)) {
      return;
    }

    paginationPages.replaceChildren();

    if (!totalPages) {
      return;
    }

    for (let pageNumber = 1; pageNumber <= totalPages; pageNumber += 1) {
      const pageButton = document.createElement("button");
      pageButton.type = "button";
      pageButton.className = `news-pagination-button${pageNumber === currentPage ? " is-active" : ""}`;
      pageButton.textContent = `${pageNumber}`;
      pageButton.setAttribute("aria-label", `Go to page ${pageNumber}`);
      pageButton.setAttribute("aria-current", pageNumber === currentPage ? "page" : "false");
      pageButton.addEventListener("click", () => {
        currentPage = pageNumber;
        applyPagination();
      });
      paginationPages.append(pageButton);
    }

    if (paginationPrev instanceof HTMLButtonElement) {
      paginationPrev.disabled = currentPage <= 1;
    }

    if (paginationNext instanceof HTMLButtonElement) {
      paginationNext.disabled = currentPage >= totalPages;
    }
  };

  const applyPagination = () => {
    updateFilteredIndexes();

    const totalPages = pageCount();

    if (totalPages === 0) {
      currentPage = 1;
    } else if (currentPage > totalPages) {
      currentPage = totalPages;
    }

    const start = (currentPage - 1) * pageSize;
    const visibleIndexes = new Set(filteredIndexes.slice(start, start + pageSize));

    articleRows.forEach((row, index) => {
      row.style.display = visibleIndexes.has(index) ? "" : "none";
    });

    if (emptyState instanceof HTMLElement) {
      emptyState.hidden = filteredIndexes.length > 0;
    }

    renderPagination();
  };

  const onFilterChange = () => {
    currentPage = 1;
    applyPagination();
  };

  window.addEventListener("in-the-news-filter-change", (event) => {
    const detail = event instanceof CustomEvent ? event.detail : null;

    if (!detail || typeof detail !== "object") {
      return;
    }

    activeFilters = {
      technologyAreas: normalizeStringArray(detail.technologyAreas),
      searchQuery: typeof detail.searchQuery === "string" ? detail.searchQuery : "",
    };

    onFilterChange();
  });

  paginationPrev?.addEventListener("click", () => {
    if (currentPage > 1) {
      currentPage -= 1;
      applyPagination();
    }
  });

  paginationNext?.addEventListener("click", () => {
    if (currentPage < pageCount()) {
      currentPage += 1;
      applyPagination();
    }
  });

  applyPagination();
</script>

<style is:global>
  .news-filter-panel {
    margin-top: 1rem;
    padding: 0;
    background: transparent;
  }

  .news-filter-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .news-filter-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .news-filter-field label {
    color: gray;
    margin: 0;
  }

  .news-filter-panel .p-multiselect,
  .news-filter-panel .p-inputtext,
  .news-filter-input {
    width: 100%;
    border-width: 1px;
    border-style: solid;
    border-color: gray;
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    font: inherit;
    color: #111827;
    background: #fff;
  }

  .news-filter-panel .p-multiselect-overlay {
    border-radius: 8px;
  }

  .news-filter-panel .p-checkbox-box {
    border-width: 1px;
    border-color: gray;
  }

  .news-filter-panel .p-checkbox-box.p-highlight {
    background: #06a2e4 !important;
    border-color: #06a2e4 !important;
  }

  .news-filter-panel .p-checkbox-box.p-highlight .p-checkbox-icon {
    color: #fff !important;
    font-size: 1.1rem;
  }

  .news-filter-panel .p-multiselect-header {
    display: none;
  }

  .news-filter-panel .p-chip,
  .news-filter-panel .p-multiselect-chip {
    border-radius: 50px;
    background-color: rgb(216, 216, 216);
    padding: 0 3px 0 12px;
    margin: 4px 2px;
    color: #000;
  }

  .news-filter-panel .p-multiselect-chip-item {
    display: inline-flex;
  }

  .news-filter-panel .technologyAreaContainer .p-chip,
  .news-filter-panel .technologyAreaContainer .p-multiselect-chip {
    background-color: rgba(255, 196, 3, 0.343);
    color: #000;
  }

  .news-filter-panel #technologyAreas_list .p-checkbox-box:has(svg) {
    background-color: rgb(177, 136, 1) !important;
  }

  .news-filter-panel .p-multiselect-option.p-focus {
    background-color: rgb(238, 238, 238);
    color: #000;
  }

  .news-filter-input {
    opacity: 1;
    position: relative;
    z-index: 0;
    min-height: 42px;
  }

  .news-filter-help {
    margin: 0;
    color: gray;
    font-size: 0.82rem;
  }

  .news-filter-clear {
    margin-top: 0.85rem;
    border: 1px solid gray;
    color: #1a3654;
    background: #fff;
    border-radius: 8px;
    padding: 0.4rem 0.75rem;
    line-height: 1.2;
  }

  .news-filter-clear:hover {
    border-color: #047cad;
    color: #047cad;
    background: #f4f8fb;
  }

  .news-article-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 1.25rem;
  }

  .news-article {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin: 1.5rem 0;
    padding-bottom: 1.25rem;
    border-bottom: #ddd 1px solid;
  }

  .news-article-media {
    width: 250px;
    min-width: 250px;
    height: 120px;
    overflow: hidden;
    position: relative;
    border: 1px solid #6b7280;
    border-radius: 0.5rem;
    background: rgb(190, 190, 190);
  }

  .news-article-image {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
    background-color: #ddd;
    display: block;
  }

  .news-article-placeholder {
    height: 120px;
    min-height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    font-size: 0.9rem;
    padding: 1rem;
    text-align: center;
  }

  .news-article-content {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    text-wrap: pretty;
  }

  .news-article-title {
    margin: 0;
    font-size: 1rem;
    line-height: 1.2;
    text-wrap: balance;
  }

  .news-article-title a,
  .news-article-title span {
    color: #1a3654;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.16rem;
  }

  .news-article-title a:hover {
    color: #047cad;
  }

  .news-article-desc {
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-article-meta {
    margin: 0;
    font-size: 0.95rem;
    color: #334155;
  }

  .news-article-source {
    font-weight: 700;
    color: #06a2e4;
  }

  .news-article-source[href]:hover {
    color: #047cad;
  }

  .news-article-location:not(:empty)::before {
    content: " (";
  }

  .news-article-location:not(:empty)::after {
    content: ")";
  }

  .news-article-date {
    font-style: italic;
  }

  .news-article-date:not(:empty)::before {
    content: " — ";
  }

  .news-article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.55rem;
  }

  .news-article-tag {
    display: inline-block;
    border-radius: 9999px;
    background-color: rgb(216, 216, 216);
    padding: 0.12rem 0.75rem;
    margin: 0;
    color: #000;
    font-size: 0.875rem;
    line-height: 1.2;
  }

  .news-article-tag.topics {
    background-color: #06a1e439;
  }

  .news-article-tag.technology-areas {
    background-color: rgba(255, 196, 3, 0.343);
  }

  .news-empty-state {
    margin-top: 1.25rem;
  }

  .news-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .news-pagination-pages {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .news-pagination-button {
    border: 1px solid #d1d5db;
    background: #fff;
    color: #055581;
    border-radius: 0.25rem;
    padding: 0.32rem 0.72rem;
    margin: 0.1rem;
    line-height: 1.25;
    font-weight: 500;
  }

  .news-pagination-button.is-active {
    background: #1b1b1b;
    border-color: #1b1b1b;
    color: #fff;
  }

  .news-pagination-button:disabled {
    opacity: 0.65;
    color: #64748b;
    cursor: not-allowed;
  }

  @media (max-width: 991.98px) {
    .news-filter-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .news-article {
      gap: 0.85rem;
    }

    .news-article-media {
      width: 220px;
      min-width: 220px;
    }
  }

  @media (max-width: 767.98px) {
    .news-filter-grid {
      grid-template-columns: 1fr;
    }

    .news-article {
      flex-direction: column;
      gap: 0.9rem;
    }

    .news-article-content {
      padding: 0;
    }

    .news-article-media {
      width: 100%;
      min-width: 0;
      height: 200px;
    }

    .news-article-image,
    .news-article-placeholder {
      height: 200px;
      min-height: 200px;
    }
  }
</style>
