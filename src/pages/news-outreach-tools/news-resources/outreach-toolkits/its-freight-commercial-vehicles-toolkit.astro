---
import ToolkitPage from "@/src/components/toolkits/ToolkitPage.astro";
import { getToolkitPageBySlug } from "@/src/lib/toolkits";

const page = getToolkitPageBySlug("its-freight-commercial-vehicles-toolkit", "outreach-toolkits");

if (!page) {
  throw new Error("Toolkit data not found for its-freight-commercial-vehicles-toolkit.");
}
---

<ToolkitPage page={page} />
