---
import ToolkitPage from "@/src/components/toolkits/ToolkitPage.astro";
import { getToolkitPageBySlug } from "@/src/lib/toolkits";

const page = getToolkitPageBySlug("v2x-deployment-toolkit", "outreach-toolkits");

if (!page) {
  throw new Error("Toolkit data not found for v2x-deployment-toolkit.");
}
---

<ToolkitPage page={page} />
