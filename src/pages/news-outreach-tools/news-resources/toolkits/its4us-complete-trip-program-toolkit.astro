---
import ToolkitPage from "@/src/components/toolkits/ToolkitPage.astro";
import { getToolkitPageBySlug } from "@/src/lib/toolkits";

const page = getToolkitPageBySlug("its4us-complete-trip-program-toolkit");

if (!page) {
  throw new Error("Toolkit data not found for its4us-complete-trip-program-toolkit.");
}
---

<ToolkitPage page={page} />
