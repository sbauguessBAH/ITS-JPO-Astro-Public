---

<style>
  .palette-list {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 8);
  }

  .palette-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    padding: 0;
  }

  .palette-color-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
  }

  .palette-color {
    width: 100%;
    height: 6rem;
    margin: 0;
  }

  .palette-color-code {
    background: white;
    margin: 0;
  }
</style>
<ProgramLayout title="Library">
  <div class="container palette-list">
    {
      palettes.map((palette) => (
        <div>
          <h2 class="palette-title">{palette.name}</h2>
          <p>{palette.notes}</p>
          <div class="palette-color-grid">
            {palette.colors.map((color) => (
              <div class="border">
                <div
                  class="palette-color"
                  style={{ backgroundColor: color.hex }}
                >
                  <small class="palette-color-code">{color.hex}</small>
                </div>
                <div class="d-flex flex-column">
                  <strong>{color.name}</strong>
                  <small>{color.notes}</small>
                  {color.variables?.map((variable) => (
                    <Badge color="secondary" size="sm">
                      {variable}
                    </Badge>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</ProgramLayout>
