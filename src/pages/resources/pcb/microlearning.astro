---
import { getCollection } from "astro:content";

import Card from "@/src/components/ui/blocks/card/Card.astro"
import CardHeader from "@/src/components/ui/blocks/card/CardHeader.astro";
import ProgramSection from "@/src/components/programs/ProgramSection.astro";
import Layout from "./_layout.astro";
import CardImage from "@/src/components/ui/blocks/card/CardImage.astro";
import CardDescription from "@/src/components/ui/blocks/card/CardDescription.astro";
import CardTitle from "@/src/components/ui/blocks/card/CardTitle.astro";
import Badge from "@/src/components/ui/elements/badge/Badge.astro";
import ExternalLinkIcon from "@/src/components/ui/icons/ExternalLinkIcon.astro";

const categories = await getCollection("pcbMicrolearning");
---
<style>
  .micro-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--size);
    margin-bottom: 4rem;
  }

  @media (min-width: 1200px) {
    .micro-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

</style>
<Layout>
  <main class="program-main">
    <ProgramSection>
      <h2 class="program-title-lg mb-4">
        Microlearning Videos
      </h2>
      <!-- <p class="program-text mb-4">
        Access brief videos for quick, focused learning on ITS topics.
      </p> -->
      <div>
        {categories.map(({ data: { title, trainings } }) => (
          <h3 class="program-title-md mb-4">
            {title}
          </h3>
          <div class="micro-grid">
            {trainings.map(training => (
              <Card href={training.url} isExternal>
                <CardImage entry={training.image} height={225}/>
                <Badge color="secondary" size="lg" style={{ position: 'absolute', right: '8px', top: '8px' }}>
                  <ExternalLinkIcon/>
                </Badge>
                <CardHeader>
                  <CardTitle>{training.title}</CardTitle>
                  <CardDescription>{training.description}</CardDescription>
                </CardHeader>
              </Card>
            ))}
          </div>
        ))}
      </div>
    </ProgramSection>
  </main>
</Layout>