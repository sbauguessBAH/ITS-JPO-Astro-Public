---
import { getCollection } from "astro:content";

import ExternalLinkBadge from "@/src/components/ui/blocks/external-link-badge/ExternalLinkBadge.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageBody from "@/src/components/ui/blocks/page/PageBody.astro";
import PageDescription from "@/src/components/ui/blocks/page/PageDescription.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import SectionContent from "@/src/components/ui/blocks/section/SectionContent.astro";
import SectionTitle from "@/src/components/ui/blocks/section/SectionTitle.astro";
import Card from "@/src/components/ui/elements/card/Card.astro";
import CardDescription from "@/src/components/ui/elements/card/CardDescription.astro";
import CardHeader from "@/src/components/ui/elements/card/CardHeader.astro";
import CardImage from "@/src/components/ui/elements/card/CardImage.astro";
import CardTitle from "@/src/components/ui/elements/card/CardTitle.astro";

import Layout from "./_layout.astro";

const categories = await getCollection("pcbMicrolearning");
---

<Layout>
  <Page class="tw:mx-auto tw:max-w-7xl">
    <PageHeader>
      <slot slot="title">Microlearning Videos</slot>
      <slot slot="description">
        Access brief videos for quick, focused learning on ITS topics.
      </slot>
    </PageHeader>
    <PageBody>
      {
        categories.map(({ data: { title, trainings } }) => (
          <Section class="tw:flex tw:flex-col tw:gap-8">
            <SectionTitle>{title}</SectionTitle>
            <SectionContent>
              <div class="tw:grid tw:grid-cols-1 tw:gap-6 tw:md:grid-cols-2 tw:lg:grid-cols-3">
                {trainings.map((training) => (
                  <Card href={training.url} isExternal>
                    <CardImage entry={training.image} height={225} />
                    <ExternalLinkBadge />
                    <CardHeader>
                      <CardTitle>{training.title}</CardTitle>
                      <CardDescription>{training.description}</CardDescription>
                    </CardHeader>
                  </Card>
                ))}
              </div>
            </SectionContent>
          </Section>
        ))
      }
    </PageBody>
  </Page>
</Layout>
