---
import { getCollection } from "astro:content";
import { render } from "astro:content";

import CopyButton from "@/src/components/ui/blocks/copy-button/CopyButton.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import Button from "@/src/components/ui/elements/button/Button.astro";
import Card from "@/src/components/ui/elements/card/Card.astro";
import CardContent from "@/src/components/ui/elements/card/CardContent.astro";
import CardImage from "@/src/components/ui/elements/card/CardImage.astro";
import Icon from "@/src/components/ui/icon/Icon.astro";

import Layout from "../_layout.astro";

export async function getStaticPaths() {
  const modules = await getCollection("pcbModules");
  return modules.map((module) => ({
    params: { id: module.id },
    props: { module },
  }));
}

const { module } = Astro.props;
const { Content } = await render(module);
---

<Layout>
  <Page>
    <PageHeader title={module.data.title} />
    <Section>
      <div class="tw:flex tw:flex-col-reverse tw:gap-12 tw:min-[992px]:flex-row">
        <div class="module-content tw:min-[992px]:basis-[70%] tw:[&_h3]:mt-0! tw:[&_h3]:not-first:mt-4! tw:[&_h3]:mb-3! tw:[&_h3]:p-0! tw:[&_h3]:text-3xl! tw:[&_h3]:leading-tight tw:[&_h3]:font-semibold tw:[&_h3]:tracking-tight tw:[&_h3]:text-primary! tw:[&_h3]:normal-case! tw:[&_h4]:mt-0! tw:[&_h4]:mb-2! tw:[&_h4]:p-0! tw:[&_h4]:text-lg! tw:[&_h4]:leading-tight tw:[&_h4]:font-semibold tw:[&_h4]:tracking-tight tw:[&_h4]:text-primary! tw:[&_h4]:normal-case! tw:[&_p]:m-0 tw:[&_p]:mb-4 tw:[&_p]:text-[1.1rem] tw:[&_p]:leading-normal tw:[&_ul]:mb-4 tw:[&_ul]:text-[1.1rem] tw:[&_ul]:leading-normal tw:[&_li]:mb-1">
          <Content />
        </div>
        <div class="tw:min-[992px]:basis-[30%]">
          <Card>
            <CardImage entry={module.data.image} height={250} />
            <CardContent>
              <dl class="tw:mb-0 tw:grid tw:grid-cols-[2fr_5fr] tw:gap-y-[0.2rem] tw:[&_dt]:font-medium! tw:[&_dt]:text-sm! tw:[&_dd]:text-md! tw:[&_dt]:text-muted-foreground tw:[&_dt]:uppercase tw:[&_dd]:leading-tight tw:[&_dd]:capitalize">
                <dt>Name</dt>
                <dd class="tw:text-md!">{module.data.title}</dd>
                <dt>Number</dt>
                <dd class="tw:text-md!">
                  <CopyButton
                    label={module.data.source.id}
                    text={module.data.source.id}
                  />
                </dd>
                <dt>Type</dt>
                <dd class="tw:text-md!">{module.data.type}</dd>
                <dt>Source</dt>
                <dd class="tw:text-md!">{module.data.source.name}</dd>
              </dl>
              <Button
                class="ui:w-fit"
                link={{
                  href: module.data.source.url,
                  isExternal: true,
                }}
              >
                Register
                <Icon name="external-link" />
              </Button>
              <p class="tw:text-sm! tw:text-muted-foreground tw:pt-4!">
                This link will take you to the NHI Catalog. Search for the
                course name or number to register.
              </p>
            </CardContent>
          </Card>
        </div>
      </div>
    </Section>
  </Page>
</Layout>
