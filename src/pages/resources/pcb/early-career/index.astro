---
import { getCollection } from "astro:content";

import LibraryImage from "@/src/components/programs/LibraryImage.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import SectionHeader from "@/src/components/ui/blocks/section/SectionHeader.astro";
import Button from "@/src/components/ui/elements/button/Button.astro";
import Card from "@/src/components/ui/elements/card/Card.astro";
import CardContent from "@/src/components/ui/elements/card/CardContent.astro";
import CardDescription from "@/src/components/ui/elements/card/CardDescription.astro";
import CardHeader from "@/src/components/ui/elements/card/CardHeader.astro";
import CardImage from "@/src/components/ui/elements/card/CardImage.astro";
import CardTitle from "@/src/components/ui/elements/card/CardTitle.astro";
import Icon from "@/src/components/ui/icon/Icon.astro";

import Layout from "../_layout.astro";

const modules = await getCollection("pcbModules").then((modules) =>
  modules.sort((a, b) => (a.data.order || 0) - (b.data.order || 0)),
);
---

<!-- Overview Section -->
<style>
  .competitions-section {
    display: flex;
    flex-direction: column;
    gap: var(--size);
  }

  .image {
    border-radius: var(--radius-lg);
    height: auto;
    width: 100%;
    object-fit: cover;
  }

  @media (min-width: 992px) {
    .competitions-section {
      flex-direction: row;
      align-items: center;
    }
    .competitions-image {
      flex-basis: 40%;
    }
    .competitions-text {
      flex-basis: 60%;
    }
  }
</style>

<Layout>
  <Page>
    <PageHeader>
      <slot slot="title">Early Career Development Resources</slot>
      <slot slot="description">
        <p class="program-text">
          Intelligent Transportation Systems (ITS) provide promising solutions
          for improving safety, mobility, and efficiency in the transportation
          network. Engaging current and prospective early career professionals
          in transportation-related fields provides tools to think critically
          and develop novel approaches for the most pressing transportation
          issues and needs.
        </p>
      </slot>
    </PageHeader>
    <Section>
      <SectionHeader title="ITS Short Course Instructor Kit Modules" />
      <div class="tw:flex tw:flex-col tw:gap-2">
        <p class="program-text">
          The ITS Short Course Instructor Kit Modules are freestanding classes
          (or training components) that provide structured content to enhance
          participants' knowledge of ITS in <strong>90 minutes or less</strong>.
          Each module focuses on a specific ITS theme, concept , or technology.
          Instructor and participant materials focus on ensuring an engaging
          experience supporting the module outcomes. These kits are designed to
          be flexible. Use them as freestanding classes, incorporate them into
          internal "Lunch & Learn" sessions, or use them as foundational
          components for larger professional development programs. ITS Short
          Course Instructor Kit materials provided for each module include an
        </p>
        <ul class="program-list">
          <li>
            <strong>Instructor Guide</strong> containing the purpose of the module,
            learning outcomes, intended target audience, intended class size, and
            detailed instruction notes.
          </li>
          <li>
            <strong>Presentation Slides</strong> to be used by the instructor during
            module delivery.
          </li>
          <li>
            <strong>Participant Materials</strong> containing items such as handouts,
            reference materials, and activity instructions.
          </li>
        </ul>
        <p class="program-text">
          Ready to lead your next session? Browse the available modules and
          their materials below.
        </p>
        <div class="tw:grid tw:grid-cols-1 tw:gap-6 tw:md:grid-cols-2">
          {
            modules.map((module) => (
              <Card href={`/resources/pcb/early-career/${module.id}`}>
                <CardImage entry={module.data.image} height={250} />
                <CardHeader>
                  <CardTitle>{module.data.title}</CardTitle>
                  <CardDescription>{module.data.description}</CardDescription>
                </CardHeader>
                <CardContent class="resource-card-body" />
              </Card>
            ))
          }
        </div>
      </div>
    </Section>
    <Section color="muted" size="lg">
      <div
        class="tw:flex tw:flex-col-reverse tw:gap-8 tw:lg:flex-row tw:lg:items-center"
      >
        <div class="tw:flex tw:basis-2/3 tw:flex-col tw:gap-2">
          <SectionHeader title="ITS Careers" />
          <p class="program-text">
            Intelligent Transportation Systems (ITS) offer a powerful,
            cost-effective approach to improving roadway safety and efficiency,
            especially when traditional infrastructure expansion is either
            impractical or fails to meet longer-term needs. Their ability to
            address complex challenges are driving substantial growth in the ITS
            field as transportation systems evolve and new demands emerge.
            Supporting this growth requires a skilled ITS workforce responsible
            for planning, designing, implementing, and operating these new
            systems to deliver everyday benefits to American travelers. At the
            same time, workforce needs are continually evolving as emerging
            technologies like automation, artificial intelligence, and shared
            mobility transform the transportation landscape.
          </p>
          <p class="program-text">
            The Career Opportunities in ITS White Paper provides a high-level
            overview of ITS career opportunities organized by topic areas of
            interest (e.g., engineering, planning, policy), highlighting both
            established and emerging roles across employment sectors.
          </p>
          <Button
            class="tw:w-fit"
            link={{
              href: "https://rosap.ntl.bts.gov/view/dot/89169",
              isExternal: true,
            }}
          >
            View PDF
            <Icon name="external-link" />
          </Button>
        </div>
        <div class="tw:mx-auto tw:aspect-square tw:basis-1/3">
          <LibraryImage
            class="tw:h-auto tw:w-full"
            entry="pcb/career-areas-diagram"
          />
        </div>
      </div>
    </Section>
    <Section>
      <div
        class="tw:flex tw:flex-col tw:gap-8 tw:lg:flex-row tw:lg:items-center"
      >
        <div class="tw:basis-2/5">
          <LibraryImage class="tw:rounded-2xl tw:w-full tw:h-auto tw:object-cover" entry="pcb/ttt-winners-2025" />
        </div>
        <div class="tw:flex tw:basis-3/5 tw:flex-col tw:gap-2">
          <SectionHeader title="ITS Student Competitions" />
          <p class="program-text">
            The Transportation Technology Tournament (TTT) is an annual event
            hosted jointly by the National Operations Center of Excellence
            (NOCoE) and the Institute of Transportation Engineers (ITE) that
            connects student teams with public agencies to solve real-world
            transportation problems utilizing ITS and Transportation Systems &
            Operations (TSMO) solutions. Former projects feature exciting
            solutions that include video detection, machine vision, Artificial
            Intelligence (AI), machine learning, digital twins, and more. TTT
            Finalist teams are invited to the ITE Annual Meeting to present
            their submission to judges&mdash;all expenses paid!
          </p>
          <Button
            class="tw:w-fit"
            link={{
              href: "https://transportationops.org/transportation-technology-tournament",
              isExternal: true,
            }}
          >
            Learn More
            <Icon name="external-link" />
          </Button>
        </div>
      </div>
    </Section>
  </Page>
</Layout>
