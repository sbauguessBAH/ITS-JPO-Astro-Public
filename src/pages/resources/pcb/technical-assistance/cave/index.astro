---
import LibraryImage from "@/src/components/programs/LibraryImage.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import Button from "@/src/components/ui/elements/button/Button.astro";
import Card from "@/src/components/ui/elements/card/Card.astro";
import CardContent from "@/src/components/ui/elements/card/CardContent.astro";
import CardDescription from "@/src/components/ui/elements/card/CardDescription.astro";
import CardHeader from "@/src/components/ui/elements/card/CardHeader.astro";
import CardImage from "@/src/components/ui/elements/card/CardImage.astro";
import CardTitle from "@/src/components/ui/elements/card/CardTitle.astro";
import Heading from "@/src/components/ui/elements/heading/Heading.astro";
import Icon from "@/src/components/ui/icon/Icon.astro";
import base_url from "@/src/lib/base_url";

import Layout from "../../_layout.astro";
---

<Layout>
  <Page>
    <Section>
      <div
        class="tw:flex tw:w-full tw:flex-col tw:items-center tw:gap-6 tw:lg:flex-row"
      >
        <div class="tw:flex tw:flex-col tw:gap-4 tw:lg:basis-2/3">
          <Heading>What is CAVe-in-a-box?</Heading>
          <div>
            <p class="program-text">
              CAVe-in-a-box, short for connected and automated vehicle education
              in a box, offers a comprehensive, hands-on learning experience. It
              supports instructors in teaching intelligent transportation system
              concepts, helps benchmark connected vehicle equipment, and
              streamlines onboarding for intelligent transportation system
              technicians.
            </p>
            <p class="program-text">
              Each kit includes a complete infrastructure setup and onboard
              equipment, featuring transportation radios, networking devices,
              traffic control equipment, and software. With CAVe-in-a-box,
              practitioners can train, deploy, and test scaled intelligent
              transportation systems directly and gain practical real-world
              experience.
            </p>
            <Button
              link={{
                href: "https://usdot-carma.atlassian.net/wiki/spaces/CMNT/pages/2628485130/CAVe-in-a-box+Training",
                isExternal: true,
              }}
              size="lg"
            >
              Learn More
              <Icon name="external-link" />
            </Button>
          </div>
        </div>
        <div
          class="tw:flex tw:w-full tw:max-w-4xl tw:items-center tw:justify-center tw:lg:basis-1/3"
        >
          <figure class="figure">
            <LibraryImage
              class="tw:h-auto tw:max-w-[350px]"
              entry="pcb/cave-box-transparent"
            />
            <figcaption
              class="tw:text-right tw:text-sm tw:text-muted-foreground"
            >
              Source: FHWA
            </figcaption>
          </figure>
        </div>
      </div>
    </Section>
    <Section color="muted">
      <Heading size="md">Open-Source Resources</Heading>
      <div class="tw:grid tw:grid-cols-1 tw:gap-6 tw:lg:grid-cols-3">
        <Card>
          <CardImage entry="pcb/cave-box" height={200} />
          <CardHeader>
            <CardTitle>Design Documents</CardTitle>
            <CardDescription>
              Learn how to set up, configure, and explore all that CAVe-in-a-box
              has to offer.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <Button
              link={{
                href: base_url(
                  "/assets/pcb/cave/CAVe_in_a_box_SysDes_April2022.pdf",
                ),
                isNewWindow: true,
              }}
            >
              View PDF
              <Icon name="pdf" />
            </Button>
          </CardContent>
        </Card>
        <Card>
          <CardImage entry="pcb/cave-box-assembly" height={200} />
          <CardHeader>
            <CardTitle> Do-It-Yourself Guides </CardTitle>
            <CardDescription>
              Build your own CAVe-in-a-box from the ground up with the
              infrastructure kit assembly instructions.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <Button
              link={{
                href: base_url(
                  "/assets/pcb/cave/CAVe_in_a_box_Infrastructure_Kit_Assembly_Instructions_FINAL_2022.pdf",
                ),
                isNewWindow: true,
              }}
            >
              View PDF
              <Icon name="pdf" />
            </Button>
          </CardContent>
        </Card>
        <Card>
          <CardImage entry="pcb/cave-box-configuration" height={200} />
          <CardHeader>
            <CardTitle>Configuration Instructions</CardTitle>
            <CardDescription>
              Explore how you can setup and configure your CAVe-in-a-box
              toolkit.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <Button
              link={{
                href: base_url(
                  "/assets/pcb/cave/CAVe_in_a_box_Network_Instruction_Set_2022.pdf",
                ),
                isNewWindow: true,
              }}
            >
              View PDF
              <Icon name="pdf" />
            </Button>
          </CardContent>
        </Card>
      </div>
    </Section>
    <!-- <Section>
        <Heading class="tw:text-center" size="md">
          CAVe-in-a-box Video Series
        </Heading>
        <p class="program-text text-center max-w-lg mx-auto mb-4">
          The video series is designed to make learning easy and practical.
          These videos show you how to setup and use the CAVe-in-a-box system,
          covering everything from installing and mounting vehicle radios to
          understanding how data flows in a transportation management system. By
          watching the videos, you'll have all the tools you need to
          successfully use CAVe-in-a-box.
        </p>
        <Videos />
    </Section> -->
    <Section>
      <div
        class="tw:flex tw:w-full tw:flex-col tw:items-center tw:gap-6 tw:lg:flex-row"
      >
        <div class="tw:flex tw:flex-col tw:gap-4 tw:lg:basis-2/3">
          <Heading size="md">Need equipment? We've got you covered!</Heading>
          <div>
            <p class="program-text">
              The Connected and Automated Vehicles (CAV) Support Services
              Program provides technical assistance and equipment loans to help
              accelerate your deployments. Whether you're testing new
              technologies, seeking bench-testing space, or in the later stages
              of deployment, we offer cost-free resources to support your
              progress.
            </p>
            <p class="program-text">
              Get the tools and knowledge you need to bring your connected and
              automated vehicle projects to life!
            </p>
            <Button
              link={{
                href: "mailto:cavsupportservices@dot.gov?subject=CAVe-in-a-box Equipment Request",
                isExternal: true,
              }}
              size="lg"
            >
              Get Equipment
              <Icon name="email" />
            </Button>
          </div>
        </div>
        <div class="tw:flex tw:items-center tw:justify-center tw:lg:basis-1/3">
          <LibraryImage
            alt="CAVe-in-a-box"
            class="tw:h-auto tw:w-full tw:max-w-[250px] tw:rotate-20"
            entry="pcb/rsu-transparent"
          />
        </div>
      </div>
    </Section>
  </Page>
</Layout>
