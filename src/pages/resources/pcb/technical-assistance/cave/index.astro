---
import LibraryImage from "@/src/components/programs/LibraryImage.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageBody from "@/src/components/ui/blocks/page/PageBody.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import SectionContent from "@/src/components/ui/blocks/section/SectionContent.astro";
import SectionTitle from "@/src/components/ui/blocks/section/SectionTitle.astro";
import Button from "@/src/components/ui/elements/button/Button.astro";
import Card from "@/src/components/ui/elements/card/Card.astro";
import CardAction from "@/src/components/ui/elements/card/CardAction.astro";
import CardContent from "@/src/components/ui/elements/card/CardContent.astro";
import CardDescription from "@/src/components/ui/elements/card/CardDescription.astro";
import CardHeader from "@/src/components/ui/elements/card/CardHeader.astro";
import CardImage from "@/src/components/ui/elements/card/CardImage.astro";
import CardTitle from "@/src/components/ui/elements/card/CardTitle.astro";
import Icon from "@/src/components/ui/icon/Icon.astro";
import base_url from "@/src/lib/base_url";

import Layout from "../../_layout.astro";
---

<style>
  .cave-transparent-image {
    max-width: 350px;
  }

  .cave-button {
    text-decoration: none;
    color: white;
    margin: 0;
    padding: 0;
    background: rgb(var(--color-brand));
    padding: 0.5rem 1.4rem;
    border-radius: 4px;
    text-transform: capitalize;
    transition: background 0.3s;
  }
  .cave-button:hover {
    font-weight: inherit;
    background: rgba(var(--color-brand-dark), 0.8);
  }
</style>
<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    grid-auto-rows: 1fr;
    gap: var(--size);
  }
  @media (min-width: 992px) {
    .card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .resource-card-image {
    width: 100%;
    object-fit: cover;
    height: 200px;
  }
  .resource-card-header {
    padding: 0;
  }
  .resource-card-body {
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    padding: var(--size-sm) var(--size-sm) var(--size) var(--size-sm);
    gap: var(--size);
    /* background-color: rgb(var(--color-gray-light)); */
  }
  .rsu-image {
    max-width: 250px;
    transform: rotate(20deg);
  }
  .text-right {
    text-align: right;
  }
</style>
<Layout>
  <Page fullWidth>
    <PageHeader
      class="tw:mx-auto tw:w-full tw:max-w-7xl"
      title="CAVe-in-a-box"
    />
    <PageBody class="tw:gap-0 tw:pt-0 tw:pb-0">
      <Section orientation="horizontal" split="2/1">
        <SectionContent>
          <SectionTitle>What is CAVe-in-a-box?</SectionTitle>
          <p class="program-text">
            CAVe-in-a-box, short for connected and automated vehicle education
            in a box, offers a comprehensive, hands-on learning experience. It
            supports instructors in teaching intelligent transportation system
            concepts, helps benchmark connected vehicle equipment, and
            streamlines onboarding for intelligent transportation system
            technicians.
          </p>
          <p class="program-text">
            Each kit includes a complete infrastructure setup and onboard
            equipment, featuring transportation radios, networking devices,
            traffic control equipment, and software. With CAVe-in-a-box,
            practitioners can train, deploy, and test scaled intelligent
            transportation systems directly and gain practical real-world
            experience.
          </p>
          <Button
            link={{
              href: "https://usdot-carma.atlassian.net/wiki/spaces/CMNT/pages/2628485130/CAVe-in-a-box+Training",
              isExternal: true,
            }}
            size="lg"
            variant="subtle"
          >
            Learn More
            <Icon name="external-link" />
          </Button>
        </SectionContent>
        <div
          class="tw:flex tw:items-center tw:justify-center"
          data-slot="section-image"
        >
          <figure class="figure">
            <LibraryImage
              class="img-fluid cave-transparent-image"
              entry="pcb/cave-box-transparent"
            />
            <figcaption class="figure-caption text-right">
              Source: FHWA
            </figcaption>
          </figure>
        </div>
      </Section>
      <Section color="muted">
        <SectionContent class="tw:items-stretch">
          <SectionTitle class="tw:self-center"
            >Open-Source Resources</SectionTitle
          >
          <div class="card-grid">
            <Card>
              <CardImage entry="pcb/cave-box" height={200} />
              <CardHeader>
                <CardTitle>Design Documents</CardTitle>
                <CardDescription>
                  Learn how to set up, configure, and explore all that
                  CAVe-in-a-box has to offer.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <CardAction>
                  <Button
                    link={{
                      href: base_url(
                        "/assets/pcb/cave/CAVe_in_a_box_SysDes_April2022.pdf",
                      ),
                      isNewWindow: true,
                    }}
                    variant="subtle"
                  >
                    <Icon name="pdf" />
                    View PDF
                  </Button>
                </CardAction>
              </CardContent>
            </Card>
            <Card>
              <CardImage entry="pcb/cave-box-assembly" height={200} />
              <CardHeader>
                <CardTitle> Do-It-Yourself Guides </CardTitle>
                <CardDescription>
                  Build your own CAVe-in-a-box from the ground up with the
                  infrastructure kit assembly instructions.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <CardAction>
                  <Button
                    link={{
                      href: base_url(
                        "/assets/pcb/cave/CAVe_in_a_box_Infrastructure_Kit_Assembly_Instructions_FINAL_2022.pdf",
                      ),
                      isNewWindow: true,
                    }}
                    variant="subtle"
                  >
                    <Icon name="pdf" />
                    View PDF
                  </Button>
                </CardAction>
              </CardContent>
            </Card>
            <Card>
              <CardImage entry="pcb/cave-box-configuration" height={200} />
              <CardHeader>
                <CardTitle>Configuration Instructions</CardTitle>
                <CardDescription>
                  Explore how you can setup and configure your CAVe-in-a-box
                  toolkit.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <CardAction>
                  <Button
                    link={{
                      href: base_url(
                        "/assets/pcb/cave/CAVe_in_a_box_Network_Instruction_Set_2022.pdf",
                      ),
                      isNewWindow: true,
                    }}
                    variant="subtle"
                  >
                    <Icon name="pdf" />
                    View PDF
                  </Button>
                </CardAction>
              </CardContent>
            </Card>
          </div>
        </SectionContent>
      </Section>
      <!-- <Section>
      <SectionContent>
        <SectionTitle class="tw:self-center">
          CAVe-in-a-box Video Series
        </SectionTitle>
        <p class="program-text text-center max-w-lg mx-auto mb-4">
          The video series is designed to make learning easy and practical.
          These videos show you how to setup and use the CAVe-in-a-box system,
          covering everything from installing and mounting vehicle radios to
          understanding how data flows in a transportation management system. By
          watching the videos, you'll have all the tools you need to
          successfully use CAVe-in-a-box.
        </p>
        <Videos />
      </SectionContent>
    </Section> -->
      <Section orientation="horizontal" split="2/1">
        <SectionContent>
          <SectionTitle>Need equipment? We've got you covered!</SectionTitle>
          <p class="program-text">
            The Connected and Automated Vehicles (CAV) Support Services Program
            provides technical assistance and equipment loans to help accelerate
            your deployments. Whether you're testing new technologies, seeking
            bench-testing space, or in the later stages of deployment, we offer
            cost-free resources to support your progress.
          </p>
          <p class="program-text">
            Get the tools and knowledge you need to bring your connected and
            automated vehicle projects to life!
          </p>
          <Button
            link={{
              href: "mailto:cavsupportservices@dot.gov?subject=CAVe-in-a-box Equipment Request",
              isExternal: true,
            }}
            size="lg"
            variant="subtle"
          >
            <Icon name="email" />
            Get Equipment
          </Button>
        </SectionContent>
        <div
          class="tw:flex tw:items-center tw:justify-center"
          data-slot="section-image"
        >
          <LibraryImage
            alt="CAVe-in-a-box"
            class="img-fluid rsu-image"
            entry="pcb/rsu-transparent"
          />
        </div>
      </Section>
    </PageBody>
  </Page>
</Layout>
