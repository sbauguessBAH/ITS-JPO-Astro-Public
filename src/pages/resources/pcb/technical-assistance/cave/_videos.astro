---
import Card from "@/src/components/ui/blocks/card/Card.astro";
import CardContent from "@/src/components/ui/blocks/card/CardContent.astro";
import CardDescription from "@/src/components/ui/blocks/card/CardDescription.astro";
import CardHeader from "@/src/components/ui/blocks/card/CardHeader.astro";
import CardImage from "@/src/components/ui/blocks/card/CardImage.astro";
import CardTitle from "@/src/components/ui/blocks/card/CardTitle.astro";

const cards = [
  {
    description:
      "How to set up and operate a roadside unit, also known as an RSU.",
    image: "pcb/cave-videos/rsu",
    link: "https://www.youtube.com/watch?v=a-nF9jiZ1X0",
    title: "Roadside Unit (RSU)",
  },
  {
    description:
      "How CAVe-in-a-box can enhance Traffic Management Center (TMC) operations.",
    image: "pcb/cave-videos/tmc",
    link: "https://www.youtube.com/watch?v=ldlinRdd-nI",
    title: "Traffic Management Center",
  },
  {
    description:
      "How to set up and operate an Onboard Unit, commonly known as an OBU.",
    image: "pcb/cave-videos/obu",
    link: "https://www.youtube.com/watch?v=Q3xH-XKT-_8",
    title: "Onboard Unit (OBU)",
  },
  {
    description:
      "Overview of troubleshooting and maintenance processes for connected and autonomous vehicle devices.",
    image: "pcb/cave-videos/cave-maintenance",
    link: "https://www.youtube.com/watch?v=He2RPhztg4Q",
    title: "Maintenance",
  },
  {
    description: "How to download and use V2X Hub on your device.",
    image: "pcb/cave-videos/v2x-hub",
    link: "https://www.youtube.com/watch?v=fhKiyVSrnWM",
    title: "Vehicle-to-Everything (V2X) Hub",
  },
  {
    description:
      "Building CAVe-in-a-box and identifying key components along the way.",
    image: "pcb/cave-videos/building-cave",
    link: "https://www.youtube.com/watch?v=zWO6NB6nxXw",
    title: "How to build CAVe-in-a-box",
  },
  {
    description:
      "Connected and Automated education (CAVe)-In-a-Box testing and educational tool kit.",
    image: "pcb/cave-videos/cave",
    link: "https://www.youtube.com/watch?v=EbqgJtJVh-4",
    title: "CAVe-in-a-box",
  },
  {
    description:
      "Overview of CAVERS, a visualization and analysis tool for intelligent transportation systems' messages.",
    image: "pcb/cave-videos/cavers",
    link: "https://www.youtube.com/watch?v=fQ3B_KucEH8",
    title: "CAVe Research Software",
  },
  {
    description:
      "How to set up a SPaT, or Signal Phase and Timing, and MAP messages.",
    image: "pcb/cave-videos/spat",
    link: "https://www.youtube.com/watch?v=2Ss90y2qldo",
    title: "Signal Phasing and Timing (SPaT) and MAP",
  },
  // {
  //   title: "CAVe Lite",
  //   image: "pcb/cave-videos/cave-lite",
  //   linkOld: "https://www.youtube.com/watch?v=t2qyqzunsRI",
  //   description: "This video is not curently available"
  // }
];
---

<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--size);
  }

  @media (min-width: 992px) {
    .video-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .video-card-body {
    display: flex;
    padding: 0;
    flex-direction: row;
    gap: var(--size-sm);
    height: 120px;
    background: rgba(var(--color-brand), 0.15);
    /* color: white; */
    transition: background 0.3s ease;
  }

  .video-card:hover .video-card-body {
    background: rgba(var(--color-brand), 0.3);
  }

  .video-card-thumbnail {
    flex-basis: 30%;
  }

  .video-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-card-content {
    flex-basis: 70%;
    padding: var(--size-sm);
    align-self: center;
  }
</style>

<div class="video-grid pb-4">
  {
    cards.map((card) => (
      <Card href={card.link} isExternal orientation="horizontal">
        <CardImage alt={card.title} entry={card.image} />
        <CardHeader>
          <CardTitle>{card.title}</CardTitle>
          <CardDescription>{card.description}</CardDescription>
        </CardHeader>
        <CardContent>
          <div class="video-card-content">
            <h4 class="program-title-xs mb-1">{card.title}</h4>
            <p class="video-card-text">{card.description}</p>
          </div>
        </CardContent>
      </Card>
    ))
  }
</div>
