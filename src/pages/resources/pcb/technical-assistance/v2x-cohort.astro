---
import Link from "@/src/components/Link.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageBody from "@/src/components/ui/blocks/page/PageBody.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import SectionContent from "@/src/components/ui/blocks/section/SectionContent.astro";
import Heading from "@/src/components/ui/elements/heading/Heading.astro";

import Layout from "../_layout.astro";
import CohortMap from "./_cohort-map.vue";
---

<style>
  .map-card-image {
    width: 100%;
    height: auto;
  }
  .map-card-body {
    overflow: visible;
  }

  .map-card-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 100%;
    padding: 1rem;
    background: rgb(var(--color-gray-light));
  }
</style>

<Layout>
  <Page class="tw:gap-2!">
    <PageHeader title="Accelerating V2X Cohort" />
    <PageBody>
      <div>
        <p class="program-text">
          The Accelerating V2X Cohort is a collaborative initiative by the
          Intelligent Transportation Systems (ITS) Joint Program Office (JPO) to
          support public agencies and other infrastructure owners and operators
          (IOOs) in accelerating the deployment of interoperable
          vehicle-to-everything (V2X) technologies. These technologies are
          critical to creating a modern, world-class transportation system that
          improves safety, efficiency, and reliability through seamless wireless
          connectivity among vehicles, mobile devices, and smart infrastructure.
        </p>
        <p class="program-text">
          The cohort is designed to accelerate the deployment of V2X
          technologies by fostering a community of practice among V2X deployers.
          Participating public entities have the opportunity to share their
          experiences, challenges, and best practices in planning and deploying
          V2X technologies.
        </p>
        <p class="program-text">
          Through monthly virtual meetings, cohort members come together to
          discuss emerging topics and to collaborate on addressing technical
          questions to support the successful, interoperable deployment of
          connected transportation technologies. USDOT provides facilitation,
          technical support, and access to resources to assist participants in
          achieving their project objectives.
        </p>
        <p class="program-text">
          If your agency is interested in joining or has any questions, please
          contact the ITS PCB Program at <Link
            href="mailto:itspcb@dot.gov"
            isExternal>itspcb@dot.gov</Link
          >.
        </p>
      </div>
      <Section size="lg">
        <SectionContent>
          <Heading class="tw:text-center" size="md">
            Accelerating V2X Cohort Members
          </Heading>
          <CohortMap client:only="vue" />
          <!-- <figure class="figure">
            <Image
              class="map-card-image"
              src={cohortImage}
              alt="Map of the United States with cohort states shaded in and yellow points with the names of each cohort agency"
            />
            <figcaption class="figure-caption">
              Source: USDOT (last updated June 2025)
            </figcaption>
          </figure> -->
          <!-- <Card class="map-card">
            <CardBody>
              
            </CardBody>
            <CardFooter class="map-card-footer">
              Last Updated: January 2025
            </CardFooter>
          </Card> -->
        </SectionContent>
      </Section>
    </PageBody>
  </Page>
</Layout>
