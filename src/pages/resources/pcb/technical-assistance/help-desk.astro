---
import LibraryImage from "@/src/components/programs/LibraryImage.astro";
import Alert from "@/src/components/ui/elements/alert/Alert.astro";
import AlertAction from "@/src/components/ui/elements/alert/AlertAction.astro";
import AlertDescription from "@/src/components/ui/elements/alert/AlertDescription.astro";
import AlertTitle from "@/src/components/ui/elements/alert/AlertTitle.astro";
import Button from "@/src/components/ui/elements/button/Button.astro";
import Heading from "@/src/components/ui/elements/heading/Heading.astro";
import Icon from "@/src/components/ui/icon/Icon.astro";

import Layout from "../_layout.astro";
import HelpDeskLogo from "./_help-desk-logo.astro";

const COMMON_TOPICS = [
  "Building compliant MAP messages",
  "Configuring roadside units and onboard units and message types",
  "Troubleshooting communication errors",
  "Selecting the right open-source tools",
  "Understanding standards and protocols",
];

const AVAILABLE_EQUIPMENT = [
  "Roadside units",
  "Vehicle onboard units and applications",
  "Signal phase and timing and MAP message test devices",
  "Smart work zone sensors and arrow boards",
  "Traffic signal controllers",
  "Thermal sensors",
  "Test laptops and tablets",
  "Global positioning system tracking kits",
];

const HELP_DESK_BENEFITS = [
  {
    description: "Get answers to your deployment-specific questions.",
    number: 1,
    title: "Personalized Technical Support",
  },
  {
    description: "Align with national standards and effective practices.",
    number: 2,
    title: "Interoperability Assistance",
  },
  {
    description: "Save time with vetted, open-source resources.",
    number: 3,
    title: "Access to tools and templates",
  },
  {
    description:
      "Learn how to engage with loan programs, testbeds, and peer networks.",
    number: 4,
    title: "Connect with other available resources",
  },
];

const LOAN_PROGRAM_BENEFITS = [
  {
    color: { background: "rgb(0, 30, 81, 0.2)", text: "rgb(0, 30, 81)" },
    description:
      "Explore solutions in a risk-free environment before initiating procurement.",
    number: 1,
    title: "Try before you buy",
  },
  {
    color: { background: "rgb(230, 184, 47, 0.2)", text: "rgb(138, 106, 19)" },
    description: "Use proven, standards-compliant hardware.",
    number: 2,
    title: "Test in the real world",
  },
  {
    color: { background: "rgb(46, 107, 61, 0.2)", text: "rgb(46, 107, 61)" },
    description:
      "Validate your future V2X system against your existing hardware.",
    number: 3,
    title: "Improve interoperability",
  },
  {
    color: { background: "#1b70ab1b", text: "#1b70ab" },
    description: "Get assistance from technical leads and documentation.",
    number: 4,
    title: "Access expert support",
  },
];
---

<style></style>
<style>
  @media (min-width: 992px) {
    .strategy-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
</style>

<style>
  .hd-banner-image {
    width: 100%;
    height: 400px;
    object-fit: cover;
    object-position: 0 70%;
    display: block;
    border-radius: var(--radius-lg);
  }
  .hd-banner-wrapper {
    position: relative;
    width: 100%;
    height: 400px;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .hd-banner-wrapper::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: -20px;
    backdrop-filter: blur(5px);
    background:
      linear-gradient(
        to right,
        rgba(var(--color-default) / 0.5) 0%,
        transparent 85%
      ),
      linear-gradient(
        to right,
        rgba(var(--color-default) / 0.85) 0%,
        rgba(var(--color-default) / 0.5) 45%,
        rgba(var(--color-default) / 0.15) 70%,
        transparent 90%
      );
    -webkit-mask-image: linear-gradient(to right, black 50%, transparent 85%);
    mask-image: linear-gradient(to right, black 50%, transparent 85%);
    z-index: 1;
  }

  .topic-box {
    border-width: 3px 1px 1px;
    border-style: solid;
    border-color: rgb(0, 113, 188) rgb(215, 230, 245) rgb(215, 230, 245);
    border-image: none;
    border-radius: 12px;
    padding: 22px 24px;
    background: rgb(249, 251, 253);
  }

  .topic-box-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: rgb(17, 46, 81);
    margin: 0px 0px 12px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  .topic {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 9px 0px;
    border-bottom: 1px solid rgb(231, 238, 246);
  }

  .topic-text {
    font-size: 13.5px;
    line-height: 1.6;
    color: rgb(61, 69, 81);
  }

  .topic-icon {
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: rgb(234, 241, 248);
    color: rgb(0, 113, 188);
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 8.5px;
    font-weight: 900;
    margin-top: 2px;
  }

  :root {
    --help-desk-yellow: oklch(0.8205 0.1609 88.37);
    --help-desk-blue-dark: oklch(0.2499 0.1019 259.99);
    --help-desk-blue: oklch(0.5222 0.1197 244.27);
  }
</style>
<Layout>
  <div class="tw:flex tw:flex-col tw:gap-6">
    <div class="hd-banner-wrapper">
      <LibraryImage class="hd-banner-image" entry="pcb/carma" />
      <HelpDeskLogo class="tw:absolute tw:top-0 tw:left-0 tw:z-10" />
    </div>
    <div class="tw:space-between tw:flex tw:flex-row tw:items-start tw:gap-32">
      <div class="tw:flex tw:basis-3/5 tw:flex-col tw:gap-2">
        <Heading size="md">What is the Help Desk?</Heading>
        <p class="program-text">
          The help desk is your direct line to technical experts supporting your
          V2X deployment. Whether you're selecting equipment, creating MAP
          messages, integrating signal phase and timing, or troubleshooting data
          flow, the help desk is here to help ensure interoperability and
          compliance with standards.
        </p>
        <Heading size="sm">Why use the help desk?</Heading>
        <div class="tw:flex tw:flex-col tw:gap-4 tw:p-4">
          {
            HELP_DESK_BENEFITS.map((item) => (
              <div class="tw:flex tw:gap-4">
                <div
                  aria-hidden="true"
                  class="tw:flex tw:size-8 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-full tw:bg-(--help-desk-blue-dark) tw:font-semibold tw:text-white"
                >
                  {item.number}
                </div>
                <div class="tw:flex tw:flex-col tw:gap-px" role="listitem">
                  <h5 class="tw:m-0! tw:p-0! tw:text-xl! tw:font-semibold! tw:text-(--help-desk-blue-dark)">
                    {item.title}
                  </h5>
                  <p class="tw:m-0! tw:p-0! tw:text-base!">
                    {item.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
        <h5 class="strategy-title">All at no cost to you!</h5>
      </div>
      <div class="tw:flex tw:basis-2/5 tw:flex-col tw:gap-4">
        <div class="topic-box">
          <h3 class="topic-box-title">Common Topics We Support</h3>
          <div>
            {
              COMMON_TOPICS.map((item) => (
                <div class="topic">
                  <div class="tw:flex tw:size-5 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-full tw:bg-(--help-desk-blue)/10">
                    <Icon class="tw:fill-(--help-desk-blue)" name="check" />
                  </div>
                  <div class="topic-text">{item}</div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="topic-box" style="border: 0;">
          <p>
            <strong>Deployment doesn't have to be complicated.</strong> Get expert
            support at every stage — from planning to deployment — at no cost.
          </p>
          <Button
            color="primary"
            link={{ href: "mailto:cavsupportservices@dot.gov" }}
            size="lg"
            variant="default"
          >
            <Icon name="email" />
            Contact the help desk
          </Button>
        </div>
      </div>
    </div>
    <div
      class="tw:flex tw:flex-col tw:gap-8 tw:rounded-2xl tw:border tw:border-border tw:bg-muted/50 tw:p-8"
    >
      <div
        class="tw:space-between tw:flex tw:flex-row tw:items-center tw:gap-12 tw:rounded-2xl tw:bg-secondary tw:p-12"
      >
        <div class="tw:flex tw:basis-2/5 tw:flex-col tw:justify-center">
          <LibraryImage
            class="tw:h-auto tw:w-full tw:rounded-2xl tw:object-cover"
            entry="pcb/cave-box-ground"
          />
        </div>
        <div class="tw:flex tw:basis-3/5 tw:flex-col tw:justify-center">
          <h3 class="tw:text-2xl! tw:text-white! tw:normal-case!">
            Accelerate Your V2X Deployment with USDOT's Open-Source Connected
            Vehicle Equipment Loan Program
          </h3>
          <p class="tw:text-lg! tw:text-white!">
            Get access to real-world roadside and vehicle onboard equipment at
            no cost, to make informed procurement decisions.
          </p>
          <p class="tw:text-2xl! tw:font-bold!">
            <span style="color: rgb(255, 255, 255);">Borrow. </span>
            <span style="color: rgb(244, 205, 82);">Test. </span>
            <span style="color: rgb(143, 207, 122);">Deploy. </span>
          </p>
        </div>
      </div>
      <div class="tw:flex tw:flex-row tw:justify-between tw:gap-32">
        <div class="tw:basis-3/5">
          <Heading size="md">What is the loan program?</Heading>
          <p class="program-text">
            The Connected Vehicle Equipment Loan Program gives agencies,
            researchers, and developers no-cost access to connected vehicle
            hardware. Use real devices — roadside units, onboard units,
            antennas, test tools, and more — to test vehicle-to-everything (V2X)
            applications, validate interoperability, and accelerate deployment
            timelines.
          </p>
          <Heading size="sm">Why use the loan program?</Heading>
          <div class="tw:flex tw:flex-col tw:gap-4 tw:p-4">
            {
              LOAN_PROGRAM_BENEFITS.map((item) => (
                <div class="tw:flex tw:gap-4">
                  <div
                    aria-hidden="true"
                    class="tw:flex tw:size-8 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-full tw:font-semibold"
                    style={{
                      backgroundColor: item.color.background,
                      color: "black",
                    }}
                  >
                    {item.number}
                  </div>
                  <div class="tw:flex tw:flex-col tw:gap-px" role="listitem">
                    <h5
                      class="tw:m-0! tw:p-0! tw:text-xl! tw:font-semibold!"
                      style={{ color: item.color.text }}
                    >
                      {item.title}
                    </h5>
                    <p class="tw:m-0! tw:p-0! tw:text-base!">
                      {item.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="hd-main-right">
          <div
            class="topic-box"
            style="border-color: rgb(230, 184, 47) rgb(240, 227, 187) rgb(240, 227, 187); background: rgb(255, 255, 255);"
          >
            <h3 class="topic-box-title">Available Equipment Includes</h3>
            <div>
              {
                AVAILABLE_EQUIPMENT.map((item) => (
                  <div class="topic">
                    <div class="tw:flex tw:size-5 tw:shrink-0 tw:items-center tw:justify-center tw:rounded-full tw:bg-(--help-desk-yellow)/10">
                      <Icon class="tw:fill-(--help-desk-yellow)" name="check" />
                    </div>
                    <div class="topic-text">{item}</div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
    <Alert class="tw:mb-8" color="secondary">
      <AlertTitle>Ready to get started?</AlertTitle>
      <AlertDescription>
        Explore the full equipment list, learn how the program works, and submit
        your loan request at <a href="mailto:cavsupportservices@dot.gov"
          >cavsupportservices@dot.gov</a
        >.
      </AlertDescription>
      <AlertAction>
        <Button
          color="accent"
          link={{ href: "mailto:cavsupportservices@dot.gov" }}
          size="lg"
          variant="default"
        >
          <Icon name="email" />
          Request a loan
        </Button>
      </AlertAction>
    </Alert>
  </div>
</Layout>
