---
import ProgramSection from "@/src/components/programs/ProgramSection.astro";

import Layout from "../_layout.astro";
---

<style></style>
<style>
  .strategy-container {
    background: rgb(var(--color-gray-light));
    border-radius: var(--radius-md);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .strategy {
    display: flex;
    gap: 1rem;
  }
  .strategy-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .strategy-title {
    color: rgb(var(--color-brand-dark));
    font-weight: 600;
    font-size: 1.2rem;
    margin: 0;
    padding: 0;
  }
  .strategy-icon {
    background: rgb(var(--color-brand-dark));
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 2rem;
    width: 2rem;
    border-radius: 100%;
    font-weight: 600;
  }
  .strategy-description {
    margin: 0;
    padding: 0;
    font-size: 1.1rem;
  }
  @media (min-width: 992px) {
    .strategy-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
</style>
<Layout>
  <main class="program-main">
    <ProgramSection size="small">
      <h2 class="program-title-lg mb-4">V2X Interoperability Help Desk</h2>
      <p class="program-text">
        The help desk is your direct line to technical experts supporting your
        V2X deployment. Whether you're selecting equipment, creating MAP
        messages, integrating signal phase and timing, or troubleshooting data
        flow, the help desk is here to help ensure interoperability and
        compliance with standards.
      </p>
    </ProgramSection>
    <ProgramSection>
      <div class="strategy-grid">
        <div class="strategy-container mt-4" role="list">
          <h3 class="program-title-md">Why use the help desk?</h3>
          <div class="strategy">
            <div aria-hidden="true" class="strategy-icon">1</div>
            <div class="strategy-content" role="listitem">
              <h4 class="strategy-title">Personalized Technical Support</h4>
              <p class="strategy-description">
                Get answers to your deployment-specific questions.
              </p>
            </div>
          </div>
          <div class="strategy">
            <div aria-hidden="true" class="strategy-icon">2</div>
            <div class="strategy-content" role="listitem">
              <h4 class="strategy-title">Interoperability Assistance</h4>
              <p class="strategy-description">
                Align with national standards and effective practices.
              </p>
            </div>
          </div>
          <div class="strategy">
            <div aria-hidden="true" class="strategy-icon">3</div>
            <div class="strategy-content" role="listitem">
              <h4 class="strategy-title">Access to tools and templates</h4>
              <p class="strategy-description">
                Save time with vetted, open-source resources.
              </p>
            </div>
          </div>
          <div class="strategy">
            <div aria-hidden="true" class="strategy-icon">4</div>
            <div class="strategy-content" role="listitem">
              <h4 class="strategy-title">
                Connect with other available resources
              </h4>
              <p class="strategy-description">
                Learn how to engage with loan programs, testbeds, and peer
                networks.
              </p>
            </div>
          </div>
        </div>
        <div class="strategy-container mt-4" role="list">
          <h3 class="program-title-md">Common topics we support</h3>
          <div class="strategy">
            <div aria-hidden="true" class="strategy-icon">1</div>
            <div class="strategy-content" role="listitem">
              <h4 class="strategy-title">Building compliant MAP messages</h4>
            </div>
          </div>
          <div class="strategy">
            <div aria-hidden="true" class="strategy-icon">2</div>
            <div class="strategy-content" role="listitem">
              <h4 class="strategy-title">
                Configuring roadside units and onboard units and message types
              </h4>
            </div>
          </div>
          <div class="strategy">
            <div aria-hidden="true" class="strategy-icon">3</div>
            <div class="strategy-content" role="listitem">
              <h4 class="strategy-title">
                Troubleshooting communication errors
              </h4>
            </div>
          </div>
          <div class="strategy">
            <div aria-hidden="true" class="strategy-icon">4</div>
            <div class="strategy-content" role="listitem">
              <h4 class="strategy-title">
                Selecting the right open-source tools
              </h4>
            </div>
          </div>
          <div class="strategy">
            <div aria-hidden="true" class="strategy-icon">5</div>
            <div class="strategy-content" role="listitem">
              <h4 class="strategy-title">
                Understanding standards and protocols
              </h4>
            </div>
          </div>
        </div>
      </div>
    </ProgramSection>
  </main>
</Layout>
