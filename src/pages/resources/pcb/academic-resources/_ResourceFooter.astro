---
import ProgramSection from "@/src/components/programs/ProgramSection.astro";
import Card from "@/src/components/ui/elements/card/Card.astro";
import CardDescription from "@/src/components/ui/elements/card/CardDescription.astro";
import CardHeader from "@/src/components/ui/elements/card/CardHeader.astro";
import CardImage from "@/src/components/ui/elements/card/CardImage.astro";
import CardTitle from "@/src/components/ui/elements/card/CardTitle.astro";

import { academicResources } from "./resources";
---

<ProgramSection color="gray">
  <h2 class="program-title-lg tw:mb-4 tw:text-center">
    All Academic Resources
  </h2>
  <div class="tw:grid tw:grid-cols-2 tw:gap-6 tw:lg:grid-cols-4">
    {
      academicResources.map((resource) => (
        <Card href={`/resources/pcb/academic-resources/${resource.slug}`}>
          <CardImage alt={resource.title} entry={resource.image} height={150} />
          <CardHeader>
            <CardTitle>{resource.title}</CardTitle>
            <CardDescription class="tw:line-clamp-2">
              {resource.description}
            </CardDescription>
          </CardHeader>
        </Card>
      ))
    }
  </div>
</ProgramSection>
