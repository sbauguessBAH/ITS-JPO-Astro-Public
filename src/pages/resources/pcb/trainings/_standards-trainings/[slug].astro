---
import { getCollection, render } from "astro:content";

import TrainingModuleDetail from "@/src/components/programs/TrainingModuleDetail.astro";

import Layout from "../../_layout.astro";

export async function getStaticPaths() {
  const trainings = await getCollection("pcbStandardsTrainings");
  return trainings.map((training) => ({
    params: { slug: training.id },
    props: { training },
  }));
}

const { training } = Astro.props;
const { Content } = await render(training);
---

<Layout>
  <TrainingModuleDetail
    {...training.data}
    parent={{
      name: "Standards Trainings",
      path: "/resources/pcb/trainings/standards-trainings",
    }}
  >
    <Content />
  </TrainingModuleDetail>
</Layout>
