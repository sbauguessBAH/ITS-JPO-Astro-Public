---
import type { CollectionEntry } from "astro:content";

import { getCollection } from "astro:content";

import ExternalLinkBadge from "@/src/components/ui/blocks/external-link-badge/ExternalLinkBadge.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";
import Panel from "@/src/components/ui/blocks/panel/Panel.astro";
import PanelGroup from "@/src/components/ui/blocks/panel/PanelGroup.astro";
import PanelHeader from "@/src/components/ui/blocks/panel/PanelHeader.astro";
import PanelItem from "@/src/components/ui/blocks/panel/PanelItem.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import Badge from "@/src/components/ui/elements/badge/Badge.astro";
import Card from "@/src/components/ui/elements/card/Card.astro";
import CardDescription from "@/src/components/ui/elements/card/CardDescription.astro";
import CardFooter from "@/src/components/ui/elements/card/CardFooter.astro";
import CardHeader from "@/src/components/ui/elements/card/CardHeader.astro";
import CardImage from "@/src/components/ui/elements/card/CardImage.astro";
import CardTitle from "@/src/components/ui/elements/card/CardTitle.astro";

import Layout from "../_layout.astro";

export function getStaticPaths() {
  const categories: { category?: string; title: string }[] = [
    { category: undefined, title: "All Courses" },
    { category: "its-basics", title: "ITS Basics" },
    { category: "its-architecture", title: "ITS Architecture" },
    { category: "systems-engineering", title: "Systems Engineering" },
    { category: "v2x", title: "Vehicle-to-Everything (V2X)" },
    {
      category: "tsmo",
      title: "Transportation Systems Management and Operations (TSMO)",
    },
    { category: "rwm", title: "Road Weather Management (RWM)" },
    { category: "tim", title: "Traffic Incident Management (TIM)" },
    { category: "cybersecurity", title: "Cybersecurity" },
    { category: "standards", title: "Standards" },
  ];

  return categories.map((item) => ({
    params: { path: item.category },
    props: { categories, title: item.title },
  }));
}

const { path } = Astro.params;
const { categories } = Astro.props;

const pathIsCategory = (
  entry: CollectionEntry<"pcbTrainings">,
  path?: string,
) => {
  return !path || entry.data.category === path;
};

// Load once and derive filtered views to avoid duplicating collection work at build time.
const courses = await getCollection("pcbTrainings");
const filteredCourses = courses.filter((entry) => pathIsCategory(entry, path));
const getCourseCount = (path?: string) =>
  courses.filter((entry) => pathIsCategory(entry, path)).length;
---

<style>
  .course-card-type {
    margin: 0;
    text-transform: uppercase;
    font-weight: 600;
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.5rem 1rem;
    /* color: rgb(var(--color-gray)); */
    color: white;
    background: rgb(var(--color-brand));
  }
  .course-card-category {
    margin: 0;
    padding: 0;
    text-transform: uppercase;
    font-weight: 600;
    color: rgb(var(--color-gray));
  }
</style>
<Layout>
  <Page>
    <PageHeader title="ITS Trainings" />
    <Section>
      <div class="tw:flex tw:flex-col tw:gap-4">
        <p class="program-text tw:m-0!">
          The ITS PCB Program offers a comprehensive suite of trainings covering
          a range of topics from foundational concepts to emerging
          transportation technologies. Discover and take these free trainings to
          help enhance your ITS knowledge and skills.
        </p>
        <p class="program-text tw:m-0!">
          For National Highway Institute (NHI) Trainings, the link will take you
          to the NHI catalog. From there, you can search for the course you're
          interested in.
        </p>
      </div>
      <div class="tw:flex tw:flex-col tw:gap-6 tw:lg:flex-row">
        <div class="tw:basis-1/4">
          <Panel label="Course categories">
            <PanelHeader>Categories</PanelHeader>
            <PanelGroup>
              {
                categories
                  .filter((item) => getCourseCount(item.category) > 0)
                  .map((item) => (
                    <PanelItem
                      active={item.category === path}
                      data-bs-title={item.title}
                      data-bs-toggle="tooltip"
                      href={`/resources/pcb/trainings/${item.category ?? ""}`}
                    >
                      {item.title}
                      <Fragment slot="end">
                        {getCourseCount(item.category)}
                      </Fragment>
                    </PanelItem>
                  ))
              }
            </PanelGroup>
          </Panel>
        </div>
        <div class="tw:basis-3/4">
          <div class="tw:grid tw:grid-cols-1 tw:gap-4 tw:md:grid-cols-2">
            {
              filteredCourses.map(({ data: course }) => (
                <Card href={course.url} isExternal={course.isExternal}>
                  <CardImage entry={course.image} height={200} />
                  <Badge
                    size="xl"
                    style={{
                      left: "8px",
                      position: "absolute",
                      textTransform: "uppercase",
                      top: "8px",
                    }}
                  >
                    {course.type}
                  </Badge>
                  {course.isExternal && (
                    <ExternalLinkBadge color="neutral" size="xl" />
                  )}
                  <CardHeader>
                    <div>
                      <span class="tw:text-sm tw:text-primary tw:uppercase tw:font-semibold">
                        {course.category.replace("-", " ")}
                      </span>
                      <CardTitle>{course.title}</CardTitle>
                    </div>
                    <CardDescription>{course.description}</CardDescription>
                  </CardHeader>
                  {course.action === "Register" && (
                    <CardFooter class="tw:text-muted-foreground">
                      This link will take you to the NHI Catalog. Search for the
                      course name or number to register.
                    </CardFooter>
                  )}
                </Card>
              ))
            }
          </div>
        </div>
      </div>
    </Section>
  </Page>
</Layout>
