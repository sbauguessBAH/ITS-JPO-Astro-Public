---
import type { CollectionEntry } from "astro:content";

import { getCollection } from "astro:content";

import ProgramSection from "@/src/components/programs/ProgramSection.astro";
import Card from "@/src/components/ui/blocks/card/Card.astro";
import CardDescription from "@/src/components/ui/blocks/card/CardDescription.astro";
import CardFooter from "@/src/components/ui/blocks/card/CardFooter.astro";
import CardHeader from "@/src/components/ui/blocks/card/CardHeader.astro";
import CardImage from "@/src/components/ui/blocks/card/CardImage.astro";
import CardTitle from "@/src/components/ui/blocks/card/CardTitle.astro";
import Badge from "@/src/components/ui/elements/badge/Badge.astro";
import base_url from "@/src/lib/base_url";

import Layout from "../_layout.astro";

export function getStaticPaths() {
  const categories: { category?: string; title: string }[] = [
    { category: undefined, title: "All Courses" },
    { category: "its-basics", title: "ITS Basics" },
    { category: "its-architecture", title: "ITS Architecture" },
    { category: "systems-engineering", title: "Systems Engineering" },
    { category: "v2x", title: "Vehicle-to-Everything (V2X)" },
    {
      category: "tsmo",
      title: "Transportation Systems Management and Operations (TSMO)",
    },
    { category: "rwm", title: "Road Weather Management (RWM)" },
    { category: "tim", title: "Traffic Incident Management (TIM)" },
    { category: "cybersecurity", title: "Cybersecurity" },
    { category: "standards", title: "Standards" },
  ];

  return categories.map((item) => ({
    params: { path: item.category },
    props: { categories, title: item.title },
  }));
}

const { path } = Astro.params;
const { categories } = Astro.props;

const pathIsCategory = (
  entry: CollectionEntry<"pcbTrainings">,
  path?: string,
) => {
  return !path || entry.data.category === path;
};

const courses = await getCollection("pcbTrainings");
const filteredCourses = courses.filter((entry) => pathIsCategory(entry, path));
const getCourseCount = (path?: string) =>
  courses.filter((entry) => pathIsCategory(entry, path)).length;
---

<style>
  .course-card-type {
    margin: 0;
    text-transform: uppercase;
    font-weight: 600;
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.5rem 1rem;
    /* color: rgb(var(--color-gray)); */
    color: white;
    background: rgb(var(--color-brand));
  }
  .course-card-category {
    margin: 0;
    padding: 0;
    text-transform: uppercase;
    font-weight: 600;
    color: rgb(var(--color-gray));
  }
</style>
<Layout>
  <main class="program-main">
    <ProgramSection>
      <h2 class="program-title-lg mb-4">ITS Trainings</h2>
      <p class="program-text">
        The ITS PCB Program offers a comprehensive suite of trainings covering a
        range of topics from foundational concepts to emerging transportation
        technologies. Discover and take these free trainings to help enhance
        your ITS knowledge and skills.
      </p>
      <p class="program-text mb-4">
        For National Highway Institute (NHI) Trainings, the link will take you
        to the NHI catalog. From there, you can search for the course you're
        interested in.
      </p>
      <div class="tw:flex tw:flex-col tw:lg:flex-row tw:gap-6">
        <div class="tw:basis-1/4">
          <nav
            class:list={[
              "tw:rounded-2xl",
              "tw:flex",
              "tw:flex-col",
              "tw:border",
              "tw:border-border",
            ]}
          >
            <h3
              class:list={[
                "tw:bg-primary",
                "tw:text-primary-foreground!",
                "tw:p-4",
                "tw:text-lg",
                "tw:rounded-t-2xl",
                "tw:font-semibold",
                "tw:normal-case!",
                "tw:mb-0!",
              ]}
            >
              Categories
            </h3>
            {
              categories
                .filter((item) => getCourseCount(item.category) > 0)
                .map((item) => (
                  <a
                    class:list={[
                      "tw:group",
                      "tw:flex",
                      "tw:flex-row",
                      "tw:justify-between",
                      "tw:decoration-0!",
                      "tw:border-b",
                      "tw:border-border",
                      "tw:py-2",
                      "tw:px-4",
                      "tw:font-semibold",
                      "tw:hover:font-semibold",
                      "tw:hover:bg-muted",
                      "tw:hover:text-primary!",
                      "tw:data-[active=true]:bg-muted",
                    ]}
                    data-active={item.category === path}
                    data-bs-title={item.title}
                    data-bs-toggle="tooltip"
                    href={base_url(
                      `/resources/pcb/trainings/${item.category ?? ""}`,
                    )}
                  >
                    <div>{item.title}</div>
                    <div
                      class:list={[
                        "tw:bg-muted",
                        "tw:py-0 tw:px-3",
                        "tw:h-6",
                        "tw:rounded-xl",
                        "tw:group-data-[active=true]:bg-primary",
                        "tw:group-data-[active=true]:text-primary-foreground",
                      ]}
                    >
                      {getCourseCount(item.category)}
                    </div>
                  </a>
                ))
            }
          </nav>
        </div>
        <div class="tw:basis-3/4">
          <div class="tw:grid tw:grid-cols-1 tw:gap-4 tw:md:grid-cols-2">
            {
              filteredCourses.map(({ data: course }) => (
                <Card href={course.url} isExternal={course.isExternal}>
                  <CardImage entry={course.image} height={200} />
                  <Badge
                    size="lg"
                    style={{
                      left: "8px",
                      position: "absolute",
                      textTransform: "uppercase",
                      top: "8px",
                    }}
                  >
                    {course.type}
                  </Badge>
                  {course.isExternal && (
                    <Badge
                      color="secondary"
                      size="lg"
                      style={{
                        position: "absolute",
                        right: "8px",
                        textTransform: "uppercase",
                        top: "8px",
                      }}
                    >
                      External Link
                    </Badge>
                  )}
                  {/* <p class="course-card-type">
                  {course.type}
                </p> */}
                  <CardHeader>
                    <p class="course-card-category">
                      {course.category.replace("-", " ")}
                    </p>
                    <CardTitle>{course.title}</CardTitle>
                    <CardDescription>{course.description}</CardDescription>
                  </CardHeader>
                  {course.action === "Register" && (
                    <CardFooter class="tw:text-muted-foreground">
                      This link will take you to the NHI Catalog. Search for the
                      course name or number to register.
                    </CardFooter>
                  )}
                </Card>
              ))
            }
          </div>
        </div>
      </div>
    </ProgramSection>
  </main>
</Layout>
