---
import Link from "@/src/components/Link.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import SectionHeader from "@/src/components/ui/blocks/section/SectionHeader.astro";
import Item from "@/src/components/ui/elements/item/Item.astro";
import ItemActions from "@/src/components/ui/elements/item/ItemActions.astro";
import ItemContent from "@/src/components/ui/elements/item/ItemContent.astro";
import ItemDescription from "@/src/components/ui/elements/item/ItemDescription.astro";
import ItemGroup from "@/src/components/ui/elements/item/ItemGroup.astro";
import ItemMedia from "@/src/components/ui/elements/item/ItemMedia.astro";
import ItemTitle from "@/src/components/ui/elements/item/ItemTitle.astro";
import Icon from "@/src/components/ui/icon/Icon.astro";
import IconTile from "@/src/components/ui/icon/IconTile.astro";

import Layout from "../../_layout.astro";

const webinars = [
  {
    date: "May 16, 2023",
    summary:
      "The webinar aims to enhance participants' understanding of how crowdsourced data can improve transportation operations. It will explore whether specific applications of crowdsourcing align with organizational needs and provide an opportunity for peers to share their experiences with using crowdsourced data in real-time and archived contexts. The focus will be on its impact on Transportation Management Systems Operations (TMSO), safety, and investment decision-making.",
    title: "Introduction and Application Highlights",
  },
  {
    date: "June 20, 2023",
    summary:
      "The webinar will cover key aspects of crowdsourced data, including common sources, providers, data fields, and potential uses. It will address data validation considerations for integrating crowdsourced data into Transportation Systems Management and Operations (TSMO). Additionally, the session will highlight the importance of effective data management for both crowdsourced and broader agency data, and provide a high-level overview of how modern data management practices differ from traditional approaches.",
    title: "Data Sources and Management",
  },
  {
    date: "July 18, 2023",
    summary:
      "The webinar will examine the components and challenges of State and local Traffic Incident Management (TIM) and Traveler Information Programs. It will explore how crowdsourced data can enhance these programs and address key aspects of TIM. Participants will also have the opportunity to share their experiences with using crowdsourced data to improve TIM and Traveler Information services.",
    title: "Traveler Information and Traffic Incident Management (TIM)",
  },
  {
    date: "August 15, 2023",
    summary:
      "The webinar will focus on the components and challenges associated with State and local arterial and road weather management programs. It will explore how crowdsourced data can enhance these programs and address key aspects of arterial and road weather management. Participants will also have the chance to share their experiences with utilizing crowdsourced data to improve these management programs.",
    title: "Road Weather and Arterial Management",
  },
  {
    date: "September 19, 2023",
    summary:
      "The webinar will cover the components and challenges faced by State and local work zone and emergency management programs. It will explore how crowdsourced data can enhance these programs and provide insights into its application. Participants will have the opportunity to share their experiences with crowdsourced data in these contexts and learn key steps for exploring its use in their own regions.",
    title: "Emergency and Work Zone Management, and Next Steps",
  },
];
---

<Layout>
  <Page>
    <PageHeader title="Crowdsourcing for Operations" />
    <Section>
      <div>
        <p class="program-text">
          Most public agencies and private companies use crowdsourcing, which is
          the practice of addressing a need or a problem by enlisting the
          services of large numbers of people through technology. Organizations
          crowdsource product reviews, idea generation, feature detection,
          funding, and much more. With the proliferation of location-based
          technologies, an unprecedented wave of crowdsourced data is available
          to transportation agencies. Moreover, analytics tools and services
          make processing and using crowdsourced data a true game-changer for
          advancing intelligent transportation systems (ITS) solutions and <Link
            href="https://ops.fhwa.dot.gov/tsmo/"
            isExternal
            >transportation systems management and operations (TSMO)</Link
          >.
        </p>
        <p class="program-text">
          Since 2019, the FHWA Every Day Counts (EDC) Innovation,
          <Link
            href="https://www.fhwa.dot.gov/innovation/everydaycounts/edc_6/crowdsourcing.cfm"
            isExternal>Crowdsourcing for Advancing Operations</Link
          >, has been supporting the adoption of crowdsourced data and tools to
          advance transportation operations across 35+ States and their local
          agencies to improve traffic incident, road weather, work zone, traffic
          signal, traveler information and emergency management, along with a
          host of other ITS and TSMO practices.
        </p>
        <p class="program-text">
          The Crowdsourcing Innovation Team in collaboration with the ITS Joint
          Program Office (JPO) Professional Capacity Building (PCB) Program
          delivered an introductory Crowdsourcing course through a series of
          five webinars, featuring State and local practitioner perspectives.
        </p>
      </div>
    </Section>
    <Section>
      <SectionHeader title="Webinar Series" />
      <p class="program-text">
        The following lists the live webinar dates and course topics. Click on
        each to view the webinar recording, download webinar presentations, and
        review the question-and-answer component for each webinar.
      </p>
      <ItemGroup class="tw:w-full tw:gap-4">
        {
          webinars.map((webinar, index) => (
            <Item
              class="tw:flex-nowrap tw:items-start tw:gap-4 tw:p-4!"
              href={`/resources/pcb/trainings/cs4ops/part-${index + 1}`}
              variant="outline"
            >
              <ItemMedia>
                <IconTile class="tw:bg-primary/10" size="lg">
                  <span class="tw:text-3xl tw:font-semibold tw:text-primary">
                    {index + 1}
                  </span>
                </IconTile>
              </ItemMedia>
              <ItemContent>
                <div>
                  <ItemTitle class="tw:line-clamp-none! tw:text-xl! tw:font-semibold!">
                    <span class="tw:sr-only">
                      Part {index + 1} of {webinars.length}:
                    </span>
                    {webinar.title}
                  </ItemTitle>
                  <ItemDescription class="tw:mt-0! tw:line-clamp-none! tw:text-sm! tw:font-medium!">
                    {webinar.date}
                  </ItemDescription>
                </div>
                <p class="tw:m-0 tw:mt-2 tw:text-base tw:text-foreground">
                  {webinar.summary}
                </p>
              </ItemContent>
              <ItemActions>
                <Icon
                  class="tw:size-4 tw:text-muted-foreground"
                  name="arrow-up-right"
                />
              </ItemActions>
            </Item>
          ))
        }
      </ItemGroup>
      <p>
        To request course delivery (virtual or in person), contact the FHWA
        Office of Operations Crowdsourcing Innovation Team
        <Link
          href="https://ops.fhwa.dot.gov/crowdsourcing/contacts.cfm"
          isExternal>here</Link
        >.
      </p>
    </Section>
    <Section>
      <SectionHeader title="Target Audience" />
      <p class="program-text">
        The target audience for this webinar series includes transportation
        professionals with an interest in or responsibility for the management
        and operations of roadway systems, including local, State, or Federal
        Departments of Transportation or Public Works as well as consultant,
        university, or contractor support. No prior experience is required to
        attend this webinar series; however, participants are advised to attend
        the first two and the final webinars in this series either during the
        live delivery or as a recorded event.
      </p>
    </Section>
    <Section>
      <SectionHeader title="Disclaimer" />
      <p class="program-text">
        The U.S. Government does not endorse products or manufacturers.
        Trademarks or manufacturer's names appear in these webinars only because
        they are considered essential to the objective of the webinar. They are
        included for informational purposes only and are not intended to reflect
        a preference, approval, or endorsement of any one product or entity.
      </p>
    </Section>
  </Page>
</Layout>
