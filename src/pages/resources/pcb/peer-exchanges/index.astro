---
import { Image } from "astro:assets";
import automatedVehicleImage from "@/src/assets/images/pcb/peer-exchanges/Automated-Vehicle-Peer-Exchanges-Thumb.png";
import v2xTollingImage from "@/src/assets/images/pcb/peer-exchanges/V2X-and-Tolling-Peer-Exchange-thumb.png";
import Card from "@/src/components/programs/card/Card.astro";
import CardBody from "@/src/components/programs/card/CardBody.astro";
import ProgramSection from "@/src/components/programs/ProgramSection.astro";
import base_url from "@/src/lib/base_url";

import Layout from "../_layout.astro";
---

<style>
  .exchange-navigation {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .exchange-section {
    scroll-margin-top: 2rem;
  }

  .exchange-layout {
    display: grid;
    gap: var(--size-lg);
    align-items: start;
  }

  .exchange-image {
    display: block;
    width: 100%;
    max-width: 28rem;
    height: auto;
    border-radius: var(--radius-lg);
  }

  .materials-body {
    padding: var(--size);
  }

  .materials-list {
    margin-bottom: 0;
  }

  .materials-list li + li {
    margin-top: 1rem;
  }

  .materials-list a {
    overflow-wrap: anywhere;
  }

  .materials-note {
    color: #595959;
    font-size: 1rem;
    margin-bottom: 0;
  }

  @media (min-width: 992px) {
    .exchange-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr) minmax(0, 1.5fr);
    }
  }
</style>

<Layout>
  <main class="program-main">
    <ProgramSection size="small">
      <h2 class="program-title-lg mb-4">ITS Peer Exchanges</h2>
      <p class="program-text">
        Intelligent Transportation Systems (ITS) Peer Exchanges bring together
        transportation professionals, public agencies, industry partners, and
        subject matter experts to share experiences, explore emerging technologies,
        and discuss opportunities and challenges related to the deployment of
        intelligent transportation systems.
      </p>
      <p class="program-text">
        These peer exchanges provide a collaborative environment for sharing
        knowledge, highlighting lessons learned, discussing best practices, and
        identifying opportunities to advance ITS deployment across the
        transportation community.
      </p>
      <p class="program-text">
        Explore the peer exchanges below and access presentation materials,
        resources, and other event-related content.
      </p>
      
    </ProgramSection>

    <ProgramSection color="gray">
      <article id="automated-vehicle" class="exchange-section" aria-labelledby="automated-vehicle-title">
        <h3 id="automated-vehicle-title" class="program-title-md mb-4">
          Automated Vehicle Peer Exchanges
        </h3>
        <div class="exchange-layout">
          <Image
            src={automatedVehicleImage}
            alt="View from inside an automated vehicle near the Golden Gate Bridge."
            class="exchange-image"
            widths={[320, 520, 780]}
            sizes="(min-width: 992px) 260px, (min-width: 496px) 448px, calc(100vw - 48px)"
          />
          <div>
            <p class="program-text">
              The Automated Vehicle Peer Exchange brought together state and local
              agencies and other stakeholders to share experiences, lessons
              learned, and perspectives on automated vehicle deployments. The peer
              exchange was led by USDOT in partnership with the San Francisco
              County Transportation Authority (SFCTA) and was conducted September
              9-11, 2026 in San Francisco, CA. Throughout the peer exchange,
              participants engaged in discussion and interactive activities
              grounded around four topic areas:
            </p>
            <ol class="program-list mb-0">
              <li>Planning, Policy, and Public Engagement</li>
              <li>Permitting Frameworks and Regulations</li>
              <li>Operations, Enforcement, and Emergency Response</li>
              <li>Data Collection and Performance Assessment</li>
            </ol>
          </div>
          <Card id="automated-vehicle-materials" shadow="none" radius="lg">
            <CardBody class="materials-body">
              <h4 class="program-title-sm mb-3">Download Peer Exchange Materials</h4>
              <p class="program-text">
                Access presentation slides, meeting materials, and other resources
                from the Automated Vehicle Peer Exchanges.
              </p>
              <!-- Replace the presentations placeholder href when the file is available. -->
              <ul class="program-list materials-list">
                <li>
                  <a href={base_url("/assets/pcb/peer-exchanges/USDOT-Automated-Vehicle-Peer-Exchange-Agenda.pdf")}>USDOT Automated Vehicle Peer Exchange Agenda</a>
                </li>
                <li>
                  <a href={base_url("/assets/pcb/peer-exchanges/Automated-Vehicle-Peer-Exchange-FINAL-Sept 9-11-2026.pdf")}>USDOT Automated Vehicle Peer Exchange Presentations</a>
                </li>
                <li>
                  <a href={base_url("/assets/pcb/peer-exchanges/USDOT-Automated-Vehicle-Peer-Exchange-Posters.pdf")}>USDOT Automated Vehicle Peer Exchange - Poster Session</a>
                </li>
              </ul>
            </CardBody>
          </Card>
        </div>
      </article>
    </ProgramSection>

    <ProgramSection>
      <article id="v2x-and-tolling" class="exchange-section" aria-labelledby="v2x-and-tolling-title">
        <h3 id="v2x-and-tolling-title" class="program-title-md mb-4">
          V2X and Tolling Peer Exchange
        </h3>
        <div class="exchange-layout">
          <Image
            src={v2xTollingImage}
            alt="Connected vehicle demonstration with a display showing a toll zone ahead."
            class="exchange-image"
            widths={[320, 520, 780]}
            sizes="(min-width: 992px) 260px, (min-width: 496px) 448px, calc(100vw - 48px)"
          />
          <div>
            <p class="program-text mb-0">
              The V2X and Tolling Peer Exchange explores the intersection of
              vehicle-to-everything (V2X) technologies and electronic tolling
              systems. This virtual exchange provided a forum to discuss
              opportunities for leveraging V2X technologies to support tolling
              operations, improve transportation system efficiency, and advance
              interoperability. Topics include V2X applications, connected vehicle
              infrastructure, tolling technology integration, deployment
              considerations, and opportunities for collaboration across the
              transportation and tolling communities.
            </p>
          </div>
          <Card id="v2x-and-tolling-materials" shadow="none" radius="lg">
            <CardBody class="materials-body">
              <h4 class="program-title-sm mb-3">Download Peer Exchange Materials</h4>
              <p class="program-text">
                Access presentation slides, discussion materials, and other
                resources from the V2X and Tolling Peer Exchange.
              </p>
              <h5 class="program-title-xs mb-3">October 28th Peer Exchange Session</h5>
              <!-- Replace the presentations placeholder href when the file is available. -->
              <ul class="program-list materials-list">
                <li>
                  <a href={base_url("/assets/pcb/peer-exchanges/USDOT-V2X-and-Tolling-Peer-Exchange-Agenda-Final.pdf")}>USDOT V2X and Tolling Peer Exchange Agenda &ndash; October 28, 2026</a>
                </li>
                <li>
                  <a href={base_url("/assets/pcb/peer-exchanges/V2X-Tolling-Peer-Exchange-FINAL-Oct-28-2026.pdf")}>USDOT V2X and Tolling Peer Exchange Presentations &ndash; October 28, 2026</a>
                </li>
              </ul>
            
            </CardBody>
          </Card>
        </div>
      </article>
    </ProgramSection>
  </main>
</Layout>
