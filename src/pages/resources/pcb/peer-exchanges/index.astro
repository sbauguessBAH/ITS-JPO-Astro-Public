---
import { Image } from "astro:assets";

import modImage from "@/src/assets/images/pcb/peer-exchanges/mod.jpg";
import qWarnImage from "@/src/assets/images/pcb/peer-exchanges/queue-warning.png";
import Link from "@/src/components/Link.astro";
import ProgramSection from "@/src/components/programs/ProgramSection.astro";
import Card from "@/src/components/ui/elements/card/Card.astro";
import CardDescription from "@/src/components/ui/elements/card/CardDescription.astro";
import CardHeader from "@/src/components/ui/elements/card/CardHeader.astro";
import CardTitle from "@/src/components/ui/elements/card/CardTitle.astro";

import Layout from "../_layout.astro";

const resources = [
  {
    description:
      "The U.S. Department of Transportation (USDOT) facilitated a series of virtual peer exchanges designed to share best practices and lessons learned in planning and deploying Queue Warning Systems (QWS).",
    image: qWarnImage,
    slug: "queue-warning",
    title: "Queue Warning Peer Exchange",
  },
  {
    description:
      "The U.S. Department of Transportation (USDOT) facilitated interactive dialogues that brought together stakeholders to discuss key, targeted topics that impact MOD deployment and adoption.",
    image: modImage,
    slug: "mod",
    title: "Mobility on Demand (MOD) Peer Exchange",
  },
];
---

<Layout>
  <main class="program-main">
    <ProgramSection>
      <h2 class="program-title-lg tw:mb-4">Peer Exchanges</h2>
      <p class="program-text">
        The ITS PCB Program facilitates peer exchanges to allow practitioners to
        share knowledge, experiences, and best practices with one another. These
        knowledge transfer events may be conducted as in-person or virtual
        events that cover a variety of topics related to intelligent
        transportation systems (ITS) and emerging transportation technologies.
      </p>
      <p class="program-text">
        If your agency is interested in conducting a peer exchange, please
        contact the ITS PCB Program at <Link
          href="mailto:itspcb@dot.gov"
          isExternal>itspcb@dot.gov</Link
        >.
      </p>
      <div class="tw:grid tw:grid-cols-1 tw:gap-6 tw:lg:grid-cols-2">
        {
          resources.map((resource) => (
            <Card href={`/resources/pcb/peer-exchanges/${resource.slug}`}>
              <Image
                alt={resource.title}
                class="tw:h-50 tw:w-full tw:object-cover"
                src={resource.image}
              />
              <CardHeader>
                <CardTitle>{resource.title}</CardTitle>
                <CardDescription>{resource.description}</CardDescription>
              </CardHeader>
            </Card>
          ))
        }
      </div>
    </ProgramSection>
  </main>
</Layout>
