---
import LibraryImage from "@/src/components/programs/LibraryImage.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageBody from "@/src/components/ui/blocks/page/PageBody.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";

import Layout from "../_layout.astro";
---

<Layout>
  <Page>
    <PageHeader title="Queue Warning Peer Exchange" />
    <PageBody>
      <div
        class="tw:flex tw:flex-col tw:gap-6 tw:lg:flex-row tw:lg:items-start"
      >
        <div class="tw:lg:basis-3/5">
          <p class="program-text">
            The Queue Warning Peer Exchange, hosted by the U.S. Department of
            Transportation (USDOT), brought together transportation
            professionals to discuss the implementation and benefits of queue
            warning systems. These systems are designed to alert drivers of
            potential hazards caused by stopped or slow-moving traffic ahead,
            enhancing safety and reducing the risk of rear-end collisions.
          </p>
          <p class="program-text">
            Participants shared experiences, challenges, and best practices in
            deploying queue warning technologies across various jurisdictions,
            fostering a collaborative environment for knowledge exchange.
          </p>
        </div>
        <div class="tw:lg:basis-2/5">
          <LibraryImage
            alt="Queue Warning System"
            class="tw:h-auto tw:w-full tw:rounded-2xl tw:shadow-sm"
            entry="pcb/peer-exchange-qws"
          />
        </div>
      </div>
    </PageBody>
  </Page>
</Layout>
