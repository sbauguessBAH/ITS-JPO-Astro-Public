---
import LibraryImage from "@/src/components/programs/LibraryImage.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageBody from "@/src/components/ui/blocks/page/PageBody.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";

import Layout from "../_layout.astro";
---

<Layout>
  <Page>
    <PageHeader title="Mobility on Demand (MOD) Peer Exchange" />
    <PageBody>
      <div
        class="tw:flex tw:flex-col tw:gap-6 tw:lg:flex-row tw:lg:items-start"
      >
        <div class="tw:lg:basis-3/5">
          <p class="program-text">
            The Mobility on Demand (MOD) Peer Exchange Series, hosted by the
            U.S. Department of Transportation (USDOT), facilitated interactive
            dialogues that brought together stakeholders to discuss key,
            targeted topics that impact MOD deployment and adoption.
          </p>
          <p class="program-text">
            This series aimed to support state-of-the-industry knowledge sharing
            regarding topic-specific needs and lessons learned, as well as
            opportunities for growth to advance MOD as a tool to support
            mobility and efficiency. These virtual peer exchanges featured
            presentations by subject matter experts and opportunities for
            attendees to engage with these experts as well as other peers in the
            space.
          </p>
        </div>
        <div class="tw:lg:basis-2/5">
          <LibraryImage
            alt="Arlington MOD Vehicle"
            class="tw:h-auto tw:w-full tw:rounded-2xl tw:shadow-sm"
            entry="pcb/peer-exchange-arlington-mod"
          />
        </div>
      </div>
    </PageBody>
  </Page>
</Layout>
