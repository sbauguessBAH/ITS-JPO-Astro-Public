---
import Link from "@/src/components/Link.astro";
import Breadcrumb from "@/src/components/programs/Breadcrumb.astro";
import Page from "@/src/components/ui/blocks/page/Page.astro";
import PageContainer from "@/src/components/ui/blocks/page/PageContainer.astro";
import PageHeader from "@/src/components/ui/blocks/page/PageHeader.astro";
import Section from "@/src/components/ui/blocks/section/Section.astro";
import SectionHeader from "@/src/components/ui/blocks/section/SectionHeader.astro";

import Layout from "../_layout.astro";
import ResourceFooter from "./_ResourceFooter.astro";
---

<Layout>
  <Page>
    <PageContainer>
      <Breadcrumb
        items={[
          {
            name: "Academic Resources",
            path: "/resources/pcb/academic-resources",
          },
          { name: "Student Competitions" },
        ]}
      />
    </PageContainer>
    <PageHeader title="ITS Student Competitions" />
    <Section>
      <div>
        <p class="program-text">
          ITS PCB Program and the National Operations Center of Excellence
          (NOCoE) developed a student competition, the Transportation Technology
          Tournament (TTT) to assist ITS students in working directly with
          public agencies to solve real-world transportation problems utilizing
          ITS and TSMO solutions. The competition allows student teams to
          leverage their experience, education, and ITS PCB materials to develop
          a solution or suite of solutions to directly address the
          transportation problem.
        </p>
        <p class="program-text">
          A detailed description of the TTT, its deadlines, and a list of the
          student teams participating is available <Link
            href="https://transportationops.org/transportation-technology-tournament"
            isExternal>here</Link
          >.
        </p>
      </div>
      <SectionHeader title="Previous Winners" />
      <table
        class="table tw:mb-0! tw:[&_a:hover]:font-normal! tw:[&_td]:text-left! tw:[&_th]:text-left!"
      >
        <thead class="thead-dark">
          <tr>
            <th scope="col">Year</th>
            <th scope="col">Winner</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>2024</td>
            <td>
              <Link
                href="https://transportationops.org/transportation-technology-tournament/2024"
                isExternal
              >
                University of Michigan
              </Link>
            </td>
          </tr>
          <tr>
            <td>2023</td>
            <td>
              <Link
                href="https://transportationops.org/transportation-technology-tournament/2023"
                isExternal
              >
                Florida International University &amp; Florida Atlantic
                University
              </Link>
            </td>
          </tr>
          <tr>
            <td>2022</td>
            <td>
              <Link
                href="https://transportationops.org/transportation-technology-tournament/2022"
                isExternal
              >
                University of Michigan
              </Link>
            </td>
          </tr>
          <tr>
            <td>2021</td>
            <td>
              <Link
                href="https://transportationops.org/transportation-technology-tournament/2021"
                isExternal
              >
                University of Massachusetts - Lowell
              </Link>
            </td>
          </tr>
          <tr>
            <td>2020</td>
            <td>
              <Link
                href="https://transportationops.org/transportation-technology-tournament/2020"
                isExternal
              >
                University of Michigan
              </Link>
            </td>
          </tr>
          <tr>
            <td>2019</td>
            <td>
              <Link
                href="https://transportationops.org/transportation-technology-tournament/2019"
                isExternal
              >
                University of Michigan
              </Link>
            </td>
          </tr>
          <tr>
            <td>2018</td>
            <td>
              <Link
                href="https://transportationops.org/transportation-technology-tournament/2018"
                isExternal
              >
                University of Texas, University of Wyoming, and University of
                Kansas
              </Link>
            </td>
          </tr>
        </tbody>
      </table>
    </Section>
  </Page>
  <ResourceFooter />
</Layout>
