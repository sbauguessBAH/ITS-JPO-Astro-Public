    <article id="successful-2026-omniair-maryland-plugfest" class="newsletter-article">
      <figure class="newsletter-image">
        <img
          src="https://content.govdelivery.com/attachments/fancy_images/USDOTFHWA/2026/06/13922007/6972925/omniair-maryland-plugfest-1920-1080-var-3_crop.jpg"
