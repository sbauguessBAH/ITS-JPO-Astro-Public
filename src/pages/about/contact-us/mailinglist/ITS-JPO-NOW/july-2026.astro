    <article id="intersection-safety-systems-prototyping-accepting-proposals-until-july-20" class="newsletter-article">
      <figure class="newsletter-image">
        <img
          src="https://content.govdelivery.com/attachments/fancy_images/USDOTFHWA/2026/06/13922008/6972926/intersection-safety-systems-logo-fullcolor-3x_crop.png"
