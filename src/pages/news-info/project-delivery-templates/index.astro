---
import banner from "@/src/assets/images/banners/Default_Banner.png";
import PageLayout from "@/src/layouts/PageLayout.astro";
import base_url from "@/src/lib/base_url";

const templatesUrl = base_url("/assets/documents/project-delivery/ITSJPO_Project_Delivery_Templates.zip");

const keywords = [
  "ITS JPO project delivery templates",
  "Project management templates",
  "Monthly status report",
  "Project schedule",
  "Communications management plan",
  "Risk register",
];

const description =
  "Project delivery templates developed as program support tools for ITS JPO portfolio management, reporting, planning, communications, and risk management.";
---

<PageLayout title="Project Delivery Templates" bannerImage={banner} keywords={keywords} description={description}>
  <Fragment slot="banner">Project Delivery Templates</Fragment>
  <main class="project-delivery-templates-main">
    <div class="row">
      <div class="col-12 col-lg-9">
        <h2 class="mt-2">Project Delivery Templates</h2>

        <p>
          The ITS JPO has established a set of <a href={templatesUrl}>project management templates</a> developed as program support tools. The project management templates help set organizational
          expectations and identify areas of responsibility. By implementing the templates across the ITS JPO portfolio, we can improve the communication of projects statuses, streamline reporting
          requirements, establish better short and long term project planning along with many other beneficial activities. This unified management approach ensures that project objectives are met.
          Consistent with expectations established by the ITS JPO, a portfolio-wide adoption of a standardized project management approach will include the utilization of the common reporting formats
          and project templates provided below.
        </p>

        <ul>
          <li>Monthly Status Report</li>
          <li>Project Schedule</li>
          <li>Communications Management Plan</li>
          <li>Risk Register</li>
        </ul>

        <p>
          Utilizing uniform methodology across all projects within the ITS JPO establishes a common approach across the entire program. Projects governed by established project management processes are
          effectively planned; have appropriate change control processes in place; deliver the right product or service on time and within budget; and ultimately generate efficiencies for the agencies.
        </p>

        <a href={templatesUrl} class="btn btn-primary mt-3">Project Management Templates</a>
      </div>
    </div>
  </main>
</PageLayout>